#!/usr/bin/env python3
"""herdr-migrate-rev <slug> — migra o primeiro revisor de um space de
`<slug>-rev` para `<slug>-rev-1`. `<slug>-rev-2` nunca muda de nome.

Diferente de herdr-swap: isto NÃO troca o kind do agent, só o nome pelo qual
o Herdr o reconhece — o processo, pane, cwd e família continuam os mesmos.
Por isso é um `herdr agent rename` direto, sem pane novo, sem nome
provisório e sem o mecanismo de handoff do herdr-swap (nada é perdido, o
processo nem reinicia) — confirmado pelo par fixo na rodada herdr-7: a
categoria do bug de nome provisório só existe quando dois agents precisam
coexistir pra trocar kind sem perder o pane; aqui não há segundo agent.

Sequência (ver _herdr_migration.py e os vereditos de herdr-6/herdr-7 em
.herdr/review/):
  1. Recusa de saída se phase já for "pending-manual" (estado terminal,
     nunca é resolvido automaticamente).
  2. Adquire o flock do space (recusa se outro processo já detém).
  3. Grava phase=migrating (preservando rev2_kind) — marca durável de que
     uma migração está em andamento, sobrevive mesmo que o flock se perca.
  4. RE-checa `<slug>-rev` idle/done e nenhuma rodada em voo (depois do
     lock, não antes — achado P2-4 herdr-7: checar antes permitia um
     dispatch escapar pela janela entre o snapshot e o lock).
  5. `herdr agent rename <slug>-rev <slug>-rev-1`.
  6. Consulta os DOIS nomes (não assume nada a partir do retorno da chamada
     — achado P1 herdr-7: timeout/erro do lado cliente não prova que o
     servidor não aplicou) pra decidir o que realmente aconteceu.
  7. Sucesso: valida metadata completa, reenvia reforço de papel (falha
     nisso vira pending-manual, não "migrated" silencioso), grava
     phase=migrated.
  8. Qualquer resultado que não seja "só o novo nome vivo, com metadata
     batendo e reforço de papel confirmado" vira pending-manual — nunca um
     "revert automático" que também pode falhar ambiguamente.

Uso:
  herdr-migrate-rev <slug>
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _herdr_dispatch as core
import _herdr_migration as migration

api = core.api
get_agent = core.get_agent_info

# Campos que devem ser idênticos antes/depois do rename — só o nome muda.
# Achado P1 herdr-7 (validação incompleta): a versão anterior não conferia
# pane_id, agent_session nem interactive_ready.
FIELDS_TO_MATCH = (
    "pane_id", "workspace_id", "tab_id", "cwd", "foreground_cwd",
    "agent", "interactive_ready",
)


def _agent_session_value(info):
    return (info.get("agent_session") or {}).get("value")


def _reinforce_and_finalize(slug, rev1_name, rev2_name, cwd):
    """Reenvia o reforço de papel e só então grava phase=migrated; falha no
    reforço vira pending-manual, nunca "migrated" silencioso. Usado pelo
    caminho normal E pelo self-heal — achado P2-2 herdr-10: declarar
    "migrated" não pode exigir menos num caminho que no outro."""
    try:
        rev2_kind = get_agent(rev2_name)["agent"]
    except RuntimeError:
        rev2_kind = migration.read_migration_state(cwd)["rev2_kind"]

    try:
        siblings = [n for n in (rev2_name, f"{slug}-exec") if core.agent_status_safe(n)]
        prompt = core.role_reinforcement_prompt(rev1_name, slug, cwd, siblings)
        api("agent", "prompt", rev1_name, prompt)
    except RuntimeError as exc:
        note = f"rename e metadata OK, mas reforço de papel falhou: {exc}"
        print(f"erro: {note} — marcando pending-manual em vez de declarar migrado silenciosamente", file=sys.stderr)
        migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
        sys.exit(1)

    migration.write_migration_state_atomic(cwd, {"phase": "migrated", "rev2_kind": rev2_kind, "note": None})
    print(f"'{slug}': migrado. '{rev1_name}' vivo, phase=migrated, rev2_kind={rev2_kind}.")


def _attempt_self_heal(slug, rev_name, rev1_name, rev2_name, after_only, observed_phase):
    """`<slug>-rev` não existe, `<slug>-rev-1` existe, e a phase persistida
    não é `migrated` nem `pending-manual` (pode ser `migrating` — o caso
    canônico de crash entre o rename e o write final — ou `legacy`/algo
    desconhecido, um registro atrasado em relação à realidade observada).

    Achado P1-1 herdr-10 (os dois revisores, independentemente): a versão
    anterior gravava o estado final SEM adquirir o lock — e a assinatura
    "rev sumiu, rev-1 existe, phase=migrating" é IDÊNTICA tanto pra um
    crash real quanto pra uma migração legítima ainda em andamento (entre
    o rename e o reforço de papel, que pode levar segundos). Sem o lock,
    não dá pra distinguir os dois. Agora só reconcilia se conseguir
    adquirir o lock — se outro processo o detém, não é crash, é migração
    ativa, e este processo desiste sem tocar em nada."""
    cwd = core.project_root(after_only["cwd"])
    lock_handle = migration.acquire_migration_lock(cwd)
    if lock_handle is None:
        print(
            f"erro: '{rev_name}' não existe mas '{rev1_name}' existe e phase={observed_phase!r} — "
            "parece uma migração ATIVA (lock detido por outro processo), não um crash; "
            "não vou reconciliar, tente de novo depois",
            file=sys.stderr,
        )
        sys.exit(2)

    # Marca durável de "em andamento" — simétrico ao caminho normal (achado
    # P1-1 herdr-11: a versão anterior adquiria o lock mas não gravava esta
    # marca; um crash DURANTE o self-heal — ex: no meio do reforço de papel,
    # que pode levar até CLI_TIMEOUT_S — deixava o space sem gate assim que
    # o flock morresse com o processo, com `<slug>-rev-1` vivo e a phase
    # antiga (`legacy`, por exemplo) ainda persistida).
    migration.write_migration_state_atomic(cwd, {"phase": "migrating"})

    try:
        # Sob o lock, confirma de novo — o estado pode ter mudado entre a
        # leitura inicial (sem lock) e agora. Achado P2-1 herdr-11: usa
        # agent_status_or_raise, não agent_status_safe — esta re-checagem
        # existe especificamente pra pegar "o nome antigo reapareceu", e
        # `agent_status_safe` apagaria um timeout aqui como se fosse
        # "não existe", autorizando a reconciliação sem confirmação real.
        try:
            reappeared = migration.agent_status_or_raise(rev_name) is not None
        except RuntimeError as exc:
            # Achado P2-3 herdr-12: nada foi alterado no mundo até este
            # ponto (o rename é feito por `_reinforce_and_finalize`, mais
            # abaixo) — uma falha de infra aqui (timeout, servidor sob
            # carga) não é um estado corrompido que exija intervenção
            # humana, é "não consegui confirmar, tente de novo".
            #
            # Achado P1-1 herdr-13 (herdr-rev): a versão anterior restaurava
            # `observed_phase` aqui — mas essa fase pode ser `legacy` (o
            # chamador encaminha QUALQUER fase não-terminal pro self-heal),
            # e `legacy` é tratada como "livre" pelo gate do worker
            # (`space_gate_reason`), reabrindo o space pra uso durante um
            # estado que ainda não foi confirmado. Mantém `phase=migrating`
            # (já gravada acima) em vez de restaurar — o space continua
            # bloqueado até a próxima tentativa confirmar algo de verdade;
            # `space_gate_message` já orienta a rodar este comando de novo.
            note = f"self-heal: falha reconfirmando ausência de '{rev_name}' sob o lock ({exc})"
            print(f"erro: {note} — não vou reconciliar por segurança; mantendo phase=migrating (bloqueado) até a próxima tentativa, tente de novo", file=sys.stderr)
            sys.exit(2)
        if reappeared:
            print(f"'{rev_name}' reapareceu depois do lock — não é mais um caso de self-heal; mantendo phase=migrating (bloqueado), rode de novo", file=sys.stderr)
            sys.exit(2)
        try:
            after = get_agent(rev1_name)
        except RuntimeError as exc:
            note = f"self-heal: '{rev1_name}' desapareceu sob o lock ({exc})"
            print(f"erro: {note} — estado desconhecido, marcando pending-manual", file=sys.stderr)
            migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
            sys.exit(1)
        # Achado P1-3 herdr-14 (herdr-rev): a versão anterior não provava
        # que o '{rev1_name}' visto AGORA (sob o lock) é o MESMO agent
        # observado em `after_only` (o snapshot tirado ANTES de adquirir o
        # lock, na chamada original em `main()`) — só checava
        # interactive_ready/agent_status em isolamento. Se o target tiver
        # sido reocupado/reiniciado entre as duas consultas, um pane
        # DIFERENTE, mas idle e interativo, seria aceito e finalizado como
        # se fosse a migração original. Reusa FIELDS_TO_MATCH, a mesma
        # comparação que o caminho normal já faz entre `before`/`after` do
        # rename — aqui compara `after_only`/`after` do self-heal.
        mismatches = [f for f in FIELDS_TO_MATCH if after_only.get(f) != after.get(f)]
        if _agent_session_value(after_only) != _agent_session_value(after):
            mismatches.append("agent_session")
        if mismatches:
            detail = ", ".join(f"{f}: {after_only.get(f)!r} -> {after.get(f)!r}" for f in mismatches)
            note = f"self-heal: '{rev1_name}' mudou de identidade entre a leitura inicial e sob o lock ({detail})"
            print(f"erro: {note} — marcando pending-manual (não confirma que é o mesmo agent do rename)", file=sys.stderr)
            migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
            sys.exit(1)
        # As checagens absolutas continuam válidas em cima disso (achado
        # P2-2 herdr-10: não exigir menos que o caminho normal).
        if after.get("interactive_ready") is not True:
            note = f"self-heal: '{rev1_name}' encontrado mas interactive_ready != True"
            print(f"erro: {note} — marcando pending-manual", file=sys.stderr)
            migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
            sys.exit(1)
        # Achado P1-2 herdr-13 (herdr-rev): a versão anterior só checava
        # `interactive_ready`, ao contrário do caminho normal (`:283-285`),
        # que também exige `agent_status` em `idle`/`done` antes de agir. Um
        # `rev-1` que esteja `working` — ou que tenha sido reocupado por
        # outro pane depois do rename original — podia receber um segundo
        # `agent.prompt` e ser marcado como migração concluída mesmo assim.
        if after.get("agent_status") not in ("idle", "done"):
            note = f"self-heal: '{rev1_name}' encontrado mas agent_status={after.get('agent_status')!r} (esperado idle/done)"
            print(f"erro: {note} — marcando pending-manual", file=sys.stderr)
            migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
            sys.exit(1)

        print(
            f"'{rev_name}' não existe mas '{rev1_name}' existe e phase={observed_phase!r}, "
            "sem detentor ativo do lock — tratando como crash pós-rename, completando o registro",
            file=sys.stderr,
        )
        _reinforce_and_finalize(slug, rev1_name, rev2_name, cwd)
        sys.exit(0)
    finally:
        migration.release_migration_lock(lock_handle)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("slug")
    args = ap.parse_args()

    if os.environ.get("HERDR_ENV") != "1":
        print("erro: rode isso de dentro de um pane gerenciado pelo Herdr (HERDR_ENV=1)", file=sys.stderr)
        sys.exit(1)

    rev_name = f"{args.slug}-rev"
    rev1_name = f"{args.slug}-rev-1"
    rev2_name = f"{args.slug}-rev-2"

    # Achado P1-4/P2-2 herdr-9: se o nome antigo já não existe, o caminho
    # anterior falhava aqui direto ("nada a migrar"), ANTES de consultar a
    # phase — deixando sem diagnóstico o cenário exato que a phase=migrating
    # foi criada pra cobrir. Tenta o nome novo antes de desistir.
    try:
        before = get_agent(rev_name)
    except RuntimeError as exc:
        # Achado P2-1 herdr-11: um RuntimeError genérico (timeout, servidor
        # travado, JSON inválido) não é confirmação de que '{rev_name}' não
        # existe — só o erro estruturado agent_not_found é. Qualquer outra
        # falha aqui é infraestrutura instável, e não deve entrar no
        # caminho de self-heal (que decide se uma migração é declarada
        # concluída) com base numa pergunta que nem chegou a ser
        # respondida.
        if not migration.agent_truly_absent(exc):
            print(f"erro: falha consultando '{rev_name}' ({exc}) — não confirma ausência, abortando sem tocar em nada", file=sys.stderr)
            sys.exit(1)
        try:
            after_only = get_agent(rev1_name)
        except RuntimeError:
            print(f"erro: nem '{rev_name}' nem '{rev1_name}' existem ({exc}) — nada a migrar (space sem primeiro revisor configurado)", file=sys.stderr)
            sys.exit(1)
        cwd = core.project_root(after_only["cwd"])
        state = migration.read_migration_state(cwd)
        # Achado P2-1 herdr-10: a versão anterior só tratava "migrating"
        # como pendente de reconciliação e classificava QUALQUER outra
        # coisa — inclusive pending-manual e legacy — como "já migrado,
        # nada a fazer", contradizendo os outros 4 comandos que recusam
        # pending-manual explicitamente. Agora as três phases terminais são
        # explícitas; qualquer outra (migrating, legacy, ou desconhecida)
        # tenta a reconciliação sob lock.
        if state["phase"] == "migrated":
            print(f"'{rev_name}' não encontrado, mas '{rev1_name}' existe e phase=migrated — já migrado, nada a fazer", file=sys.stderr)
            sys.exit(0)
        if state["phase"] == "pending-manual":
            print(
                f"erro: space '{args.slug}' está em phase=pending-manual "
                f"(nota: {state.get('note')!r}) — precisa de intervenção manual",
                file=sys.stderr,
            )
            sys.exit(1)
        _attempt_self_heal(args.slug, rev_name, rev1_name, rev2_name, after_only, state["phase"])
        return  # inalcançável — _attempt_self_heal sempre chama sys.exit

    cwd = core.project_root(before["cwd"])

    existing_state = migration.read_migration_state(cwd)
    if existing_state["phase"] == "pending-manual":
        print(
            f"erro: space '{args.slug}' está em phase=pending-manual "
            f"(nota: {existing_state.get('note')!r}) — precisa de intervenção "
            "manual antes de qualquer nova tentativa automática",
            file=sys.stderr,
        )
        sys.exit(1)

    lock_handle = migration.acquire_migration_lock(cwd)
    if lock_handle is None:
        print(f"erro: space '{args.slug}' já está com uma migração em andamento (lock ativo)", file=sys.stderr)
        sys.exit(1)

    # Marca durável de "em andamento" — sobrevive independente do flock (que
    # é só exclusão mútua enquanto ESTE processo roda). Preserva rev2_kind
    # já persistido (write_migration_state_atomic faz merge com o disco).
    migration.write_migration_state_atomic(cwd, {"phase": "migrating"})

    try:
        _run(args.slug, rev_name, rev1_name, rev2_name, cwd, before, existing_state["phase"])
    finally:
        migration.release_migration_lock(lock_handle)


def _run(slug, rev_name, rev1_name, rev2_name, cwd, before, phase_before_migrating):
    # Restaura a phase de ANTES de gravarmos "migrating" nos caminhos de
    # desistência abaixo (achado P2-4 herdr-8: gravar "legacy" incondicional
    # rebaixava um space já "migrated" que, por qualquer motivo, tivesse
    # `<slug>-rev` reaparecido — e é exatamente o valor que faz
    # `build_rev_agents()` recriar o nome antigo).
    def _give_up(exit_code):
        migration.write_migration_state_atomic(cwd, {"phase": phase_before_migrating})
        sys.exit(exit_code)

    # Re-checa DEPOIS do lock — achado P2-4 herdr-7: o snapshot pré-lock
    # podia estar desatualizado o suficiente pra um dispatch concorrente
    # escapar pela janela entre a leitura e a aquisição do lock. Nada foi
    # tocado ainda neste ponto (o rename é mais abaixo) — desistir aqui é
    # seguro tanto se '{rev_name}' genuinamente sumiu quanto se foi só uma
    # falha de infra passageira, então _give_up (que restaura a phase
    # anterior) serve pros dois casos; só a mensagem precisa não afirmar
    # "desapareceu" quando não foi confirmado (achado P1 herdr-12).
    try:
        before = get_agent(rev_name)
    except RuntimeError as exc:
        if migration.agent_truly_absent(exc):
            print(f"erro: '{rev_name}' desapareceu entre a checagem inicial e o lock ({exc})", file=sys.stderr)
        else:
            print(f"erro: falha consultando '{rev_name}' entre a checagem inicial e o lock ({exc}) — não confirma ausência, mas nada foi tocado ainda", file=sys.stderr)
        _give_up(1)

    if before["agent_status"] not in ("idle", "done"):
        print(f"'{rev_name}' está '{before['agent_status']}' — pulando esta passada (não é erro fatal)", file=sys.stderr)
        _give_up(2)

    blocker = migration.find_in_flight_round(cwd)
    if blocker is not None:
        print(f"space '{slug}' tem rodada de review/ask em voo ({blocker}) — pulando esta passada", file=sys.stderr)
        _give_up(2)

    print(f"renomeando '{rev_name}' -> '{rev1_name}'...")
    try:
        api("agent", "rename", rev_name, rev1_name)
    except RuntimeError as exc:
        print(f"aviso: chamada de rename retornou erro ({exc}) — confirmando o que aconteceu de fato antes de decidir (não assumo que nada mudou)", file=sys.stderr)

    # Nunca confiar só no retorno da chamada (achado P1 herdr-rev/herdr-7:
    # timeout/erro do lado cliente não prova ausência de efeito no servidor)
    # — consulta os dois nomes de verdade. agent_status_or_raise, não
    # agent_status_safe (achado P2-1 herdr-11, mesma classe): uma falha de
    # infra aqui não pode virar "não existe" silenciosamente — a decisão
    # entre "rename aplicou limpo" e "estado ambíguo" depende exatamente
    # dessa distinção.
    def _confirm_or_pending_manual(name):
        try:
            return migration.agent_status_or_raise(name) is not None
        except RuntimeError as exc:
            note = f"falha reconfirmando '{name}' após o rename ({exc})"
            print(f"erro: {note} — não decido com base numa pergunta que falhou, marcando pending-manual", file=sys.stderr)
            migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
            sys.exit(1)

    rev_alive = _confirm_or_pending_manual(rev_name)
    rev1_alive = _confirm_or_pending_manual(rev1_name)

    if rev_alive and not rev1_alive:
        print(f"confirmado: rename não aplicou ('{rev_name}' continua vivo, '{rev1_name}' não existe) — nada foi tocado", file=sys.stderr)
        _give_up(1)

    if rev_alive and rev1_alive:
        note = f"os dois nomes ('{rev_name}' e '{rev1_name}') existem depois da chamada de rename"
        print(f"erro: {note} — estado ambíguo, marcando pending-manual", file=sys.stderr)
        migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
        sys.exit(1)

    if not rev_alive and not rev1_alive:
        note = f"nenhum dos dois nomes ('{rev_name}' nem '{rev1_name}') existe depois da chamada de rename"
        print(f"erro: {note} — estado desconhecido, marcando pending-manual", file=sys.stderr)
        migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
        sys.exit(1)

    # só '{rev1_name}' vivo, exatamente o esperado — segue pra validação.
    after = get_agent(rev1_name)
    mismatches = [f for f in FIELDS_TO_MATCH if before.get(f) != after.get(f)]
    if _agent_session_value(before) != _agent_session_value(after):
        mismatches.append("agent_session")

    if mismatches:
        detail = ", ".join(f"{f}: {before.get(f)!r} -> {after.get(f)!r}" for f in mismatches)
        note = f"metadata pós-rename não bate ({detail})"
        print(f"erro: {note} — marcando pending-manual (não reverto automaticamente um estado que não entendo)", file=sys.stderr)
        migration.write_migration_state_atomic(cwd, {"phase": "pending-manual", "note": note})
        sys.exit(1)

    _reinforce_and_finalize(slug, rev1_name, rev2_name, cwd)


if __name__ == "__main__":
    main()
