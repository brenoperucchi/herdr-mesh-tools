#!/usr/bin/env python3
"""Amostra model/effort de cada agent e guarda no cache do herdr-agents.

Feito pra rodar por timer (systemd/herdr-probe.timer). Tudo aqui e' PASSIVO:
le o buffer do pane, nunca escreve nele.

A amostragem em si mora no herdr-agents (amostra_um/amostra_todos), nao aqui --
o caminho do Claude precisa das funcoes de log daquele modulo, e o `--force` do
listing usa exatamente a mesma funcao. Duas definicoes do que e' "o valor de
agora" seria uma a mais.

Uso:
    herdr-probe               # amostra todos e grava
    herdr-probe --mostrar     # so imprime o cache, sem amostrar
    herdr-probe --deriva      # amostra e sai != 0 se o pane divergir do argv
"""

import argparse
import importlib.util
import os
import sys
from importlib.machinery import SourceFileLoader

BIN = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, BIN)

import _herdr_probe_cache as cache


def _carrega_agents():
    """herdr-agents nao tem .py no nome, entao vai por SourceFileLoader."""
    loader = SourceFileLoader("herdr_agents", os.path.join(BIN, "herdr-agents"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def imprime(c):
    for nome in sorted(c):
        e = c[nome]
        idade = cache.idade_min(e)
        sufixo = f"ha {idade}min" if idade is not None else "(sem timestamp)"
        print(f"  {nome:22s} {e.get('model','?'):16s} {e.get('effort','?'):8s} "
              f"{e.get('origem','?'):18s} {sufixo}")


def divergencias(ha, agents, c):
    """Onde o pane (fato) discorda do argv (intencao do lancamento).

    Nao e' erro por si so -- trocar modelo na mao e' legitimo. E' informacao:
    diz onde o mesh saiu do que foi pinado, que e' o que o bootstrap recriaria
    diferente.
    """
    fora = []
    for a in agents:
        nome = a.get("name")
        e = c.get(nome or "")
        if not e or e.get("origem") != "pane":
            continue
        try:
            pi = ha.api("pane", "process-info", "--pane", a["pane_id"])["process_info"]
            fg = pi.get("foreground_processes") or []
            argv = fg[0].get("argv", []) if fg else []
        except Exception:
            continue
        am, ae = ha.from_argv(argv)
        if not (am or ae):
            continue
        if (am and am != e.get("model")) or (ae and ae != e.get("effort")):
            fora.append((nome, f"{am or '?'}/{ae or '?'}",
                         f"{e.get('model')}/{e.get('effort')}"))
    return fora


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mostrar", action="store_true", help="so imprime o cache, nao amostra")
    ap.add_argument("--deriva", action="store_true",
                    help="sai != 0 se alguma leitura de pane divergir do argv do processo")
    args = ap.parse_args()

    if args.mostrar:
        imprime(cache.ler())
        return

    ha = _carrega_agents()
    try:
        agents = ha.api("agent", "list")["agents"]
    except (RuntimeError, KeyError) as exc:
        print(f"erro: nao consegui listar agents ({exc})", file=sys.stderr)
        sys.exit(1)

    c = ha.amostra_todos(agents)
    print(f"{len(c)} leitura(s) no cache ({cache.CACHE_PATH})")

    if args.deriva:
        fora = divergencias(ha, agents, c)
        if not fora:
            print("nenhuma divergencia entre argv e pane.")
            return
        print(f"\n{len(fora)} agent(s) rodando diferente do que foi pinado:")
        for nome, pinado, vivo in fora:
            print(f"  {nome:22s} argv={pinado:24s} pane={vivo}")
        sys.exit(1)


if __name__ == "__main__":
    main()
