#!/usr/bin/env python3
"""Le model/effort de cada agent ao vivo e guarda no cache.

Feito pra rodar por timer. Tudo aqui e' PASSIVO: `herdr agent read` le o buffer
do pane, nao escreve nada nele. Nunca manda `/status` nem prompt nenhum -- alem
de custar tokens, escrever na caixa de composicao de um pane que pode ter texto
humano nao enviado ja causou dois incidentes reais neste mesh.

Uso:
    herdr-probe                # amostra todos, atualiza o cache
    herdr-probe --mostrar      # so imprime o cache atual, sem amostrar
    herdr-probe --deriva       # amostra e sai != 0 se algo divergir do argv
"""

import argparse
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import _herdr_dispatch as core
import _herdr_probe_cache as cache

CLI_TIMEOUT_S = 25

# Rodape do Codex: "  gpt-6-astra medium · ~/Devs/x · titulo". O TUI tambem
# escreve "Model changed to gpt-6-astra medium" na conversa quando muda, mas o
# rodape ja reflete o estado atual, entao basta ele.
RODAPE_CODEX = re.compile(
    r"\b(?P<model>(?:gpt|o)[-a-z0-9.]*[0-9a-z])\s+"
    r"(?P<effort>minimal|low|medium|high|xhigh|max)\b", re.I)


def le_pane(nome, linhas=6):
    try:
        r = subprocess.run(
            core.herdr_argv("agent", "read", nome, "--source", "recent-unwrapped",
                            "--lines", str(linhas)),
            capture_output=True, text=True, timeout=CLI_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout or ""


def do_rodape(texto):
    """(model, effort) do rodape do Codex, ou (None, None).

    Pega o ULTIMO match: o rodape e' a ultima coisa desenhada, e a conversa
    acima pode conter nomes de modelo citados em prosa.
    """
    ms = list(RODAPE_CODEX.finditer(texto))
    if not ms:
        return None, None
    m = ms[-1]
    return m.group("model").lower(), m.group("effort").lower()


def amostra(agents, c):
    lidos = 0
    for a in agents:
        nome, kind = a.get("name"), a.get("agent")
        if not nome:
            continue
        if kind == "codex":
            model, effort = do_rodape(le_pane(nome))
            if model:
                cache.atualiza(c, nome, model, effort, "pane", kind)
                lidos += 1
        # Claude nao imprime modelo na tela. A unica fonte passiva e' o log da
        # sessao, que so vira confiavel quando o agent responde DEPOIS da troca
        # -- ver herdr-agents.claude_model_confiavel(). Cada passagem da sonda
        # e' uma nova chance de pegar essa janela; quando pegar, fica gravado.
        elif kind == "claude":
            import importlib.util
            from importlib.machinery import SourceFileLoader
            l = SourceFileLoader("ha", os.path.join(os.path.dirname(
                os.path.abspath(__file__)), "herdr-agents"))
            sp = importlib.util.spec_from_loader("ha", l)
            ha = importlib.util.module_from_spec(sp)
            l.exec_module(ha)
            try:
                pi = ha.api("pane", "process-info", "--pane", a["pane_id"])["process_info"]
                fg = pi.get("foreground_processes") or []
                argv = fg[0].get("argv", []) if fg else []
            except Exception:
                argv = []
            uuid = ha.resume_uuid(argv)
            if not uuid:
                continue
            model, confiavel = ha.claude_model_confiavel(uuid)
            if model and confiavel:
                _dm, de = ha.defaults_claude()
                cache.atualiza(c, nome, model, de or "?", "thread-confirmado", kind)
                lidos += 1
    return lidos


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mostrar", action="store_true", help="so imprime o cache, nao amostra")
    ap.add_argument("--deriva", action="store_true",
                    help="sai != 0 se alguma leitura de pane divergir do argv do processo")
    args = ap.parse_args()

    c = cache.ler()

    if not args.mostrar:
        try:
            agents = core.api("agent", "list")["agents"]
        except (RuntimeError, KeyError) as exc:
            print(f"erro: nao consegui listar agents ({exc})", file=sys.stderr)
            sys.exit(1)
        n = amostra(agents, c)
        cache.gravar(c)
        print(f"{n} leitura(s) gravadas em {cache.CACHE_PATH}")

    if args.mostrar or args.deriva:
        for nome in sorted(c):
            e = c[nome]
            idade = cache.idade_min(e)
            print(f"  {nome:22s} {e.get('model','?'):16s} {e.get('effort','?'):8s} "
                  f"{e.get('origem','?'):18s} ha {idade}min" if idade is not None
                  else f"  {nome:22s} {e.get('model','?')}")


if __name__ == "__main__":
    main()
