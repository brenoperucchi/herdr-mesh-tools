    ("strata-opencode", f"{HOME}/Devs/strata-opencode", ("strata-opencode-exec", "opencode", ["-m", "llm-gateway/opencode-local/strata-swift-1.5-iq3_xxs"]),
        ("strata-opencode-scout", "codex", SCOUT_ARGS), "strata-opencode", {"lean": True}),
    # cerebro: space do Breno (descricao omitida neste repo publico).
    # Registrado por herdr-add-space em 2026-10-22.
    ("cerebro", f"{HOME}/cerebro", ("cerebro-exec", "codex", EXEC_ARGS_CODEX),
        ("cerebro-scout", "codex", SCOUT_ARGS), "cerebro", {"lean": True}),
    # magicwalls: space do Breno (descricao omitida neste repo publico).
    # Registrado por herdr-add-space em 2026-10-28.
    ("magicwalls", f"{HOME}/Devs/miqueias/magicwalls", ("magicwalls-exec", "claude", EXEC_ARGS),
        ("magicwalls-scout", "codex", SCOUT_ARGS), "magicwalls", {"lean": True}),
]


def entry_opts(entry):
    """6o elemento opcional de uma entrada de SPACES: dict de opcoes do space.
    Hoje so `{"lean": True}`. Exige o slug explicito (5o elemento)."""
    return entry[5] if len(entry) > 5 and isinstance(entry[5], dict) else {}


def is_lean(entry, with_reviewers=False):
    """Space enxuto: so o exec sobe por padrao. Revisores e scout continuam
    DECLARADOS na tabela (perfil, nome) mas so sobem sob demanda -- os dispatchers
    chamam `herdr-bootstrap --slug X --with-reviewers`, que ignora o `lean`.
    Motivo (Breno, 2026-10-03): 75 agents ocupavam ~51 GB dos 94 GB da maquina, 38 GB
    deles em revisores e scouts parados."""
    return bool(entry_opts(entry).get("lean")) and not with_reviewers


def build_rev_agents(slug, cwd):
    """Monta as tuplas (nome, kind, extra_args) dos dois revisores em
    runtime, lendo a fase e o rev2_kind de migration-state.json daquele
    space. Nunca cria "<slug>-rev-1" fora da fase "migrated"; nunca recria
    "<slug>-rev" depois de "migrated". REV_OVERRIDES[slug], se existir,
    substitui os extra_args default (REV_EFFORT / extra_args_for_rev2) -
    ver comentario da constante pro porque isto nao vive em
    migration-state.json."""
    state = migration.read_migration_state(cwd)
    rev_name = f"{slug}-rev-1" if state["phase"] == "migrated" else f"{slug}-rev"
    rev2_kind = state["rev2_kind"]
    override = REV_OVERRIDES.get(slug, {})
    rev_extra_args = override.get("rev_extra_args", REV_EFFORT)
    rev2_extra_args = override.get("rev2_extra_args", migration.extra_args_for_rev2(rev2_kind))
    return [
        (rev_name, "codex", rev_extra_args),
        (f"{slug}-rev-2", rev2_kind, rev2_extra_args),
    ]


def api(*args):
    core.guard_delivery(args)
    out = subprocess.run(core.herdr_argv(*args), capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {out.stderr.strip() or out.stdout.strip()}")
    return json.loads(out.stdout)["result"]


def run(*args):
    if DRY:
        print(f"  [dry-run] herdr {' '.join(args)}")
        return None
    return api(*args)


def ensure_notify_watchers(workspace_ids=None):
    """Arma um herdr-notify-watch pra cada agent '*-exec' vivo.

    Nao checa se ja tem um rodando por fora (pgrep e' fragil e ja duplicou
    processo antes) - o proprio herdr-notify-watch se tranca com flock, entao
    chamar aqui de novo mesmo com um watch ja vivo e' seguro: a instancia nova
    detecta o lock e sai sozinha sem duplicar.
    """
    watch_bin = os.path.expanduser("~/.local/bin/herdr-notify-watch")
    for a in api("agent", "list")["agents"]:
        name = a.get("name", "")
        if not name.endswith("-exec"):
            continue
        if workspace_ids is not None and a.get("workspace_id") not in workspace_ids:
            continue
        print(f"  notify-watch {name}: armando (flock evita duplicar)")
        if DRY:
            continue
        subprocess.Popen(
            [watch_bin, name],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
            start_new_session=True,
        )


def split_argv(source_pane, direction, cwd):
    """`pane split` com --cwd da tabela SPACES.

    Sem --cwd o pane novo herda a pasta do pane de origem, e o exec pode rodar noutra pasta que
    a da tabela (claude-bridge: exec em ~/.claude-bridge, tabela em ~/Devs/claude-bridge). O
    revisor subia na pasta errada e o herdr-ask recusava com 'target cwd does not match the
    invoking project' (relato do claude-bridge-exec, 2026-10-13)."""
    return ["pane", "split", source_pane, "--direction", direction, "--cwd", cwd]


def startup_runtime():
    return SimpleNamespace(api=api, get_agent_info=core.get_agent_info, herdr_argv=core.herdr_argv)


def start_agent_with_role(pane_id, name, kind, extra_args, slug, cwd, siblings, lean=False, new_pane=None):
    """Sobe (name, kind) no pane_id e, se subir de verdade, manda o reforço de
    papel — usado tanto pro loop de split da tab 1 quanto pra tab do scout,
    pra não duplicar a mesma lógica dos dois lugares. Os argumentos de model e
    effort são passados explicitamente na criação; os resets posteriores de
    `herdr-review-dispatch`/`herdr-ask` verificam que esse perfil não mudou."""
    full_extra = list(extra_args)
    if kind == "codex":
        # desliga o sistema nativo de sub-agentes do Codex - ver
        # core.CODEX_NO_NATIVE_AGENTS pro porque (achado real,
        # omabackup-exec 2026-08-29)
        # e roda com --no-daemon (core.CODEX_NO_DAEMON): sem isso o Codex fica em
        # `unknown` depois de cada turno no Herdr >= 0.9.4
        full_extra = core.codex_launch_flags(full_extra)
    print(f"  {pane_id}: iniciando {kind} como '{name}'" + (f" ({' '.join(full_extra)})" if full_extra else ""))
    started_ok = False
    not_ready = False
    if not DRY:
        trust.ensure_trusted(cwd, kind)
    try:
        args = ["agent", "start", name, "--kind", kind, "--pane", pane_id]
        if full_extra:
            args += ["--", *full_extra]
        run(*args)
        started_ok = True
    except RuntimeError as exc:
        if "agent_not_ready" in str(exc):
            not_ready = True
        else:
            raise
    if not DRY:
        if new_pane is not None:
            print(f"  {pane_id}: idade do recibo de subida: {startup.time.monotonic() - new_pane.created_at:.1f}s")
        confirmed = startup.finish_start(startup_runtime(),new_pane,pane=pane_id,name=name,kind=kind)
        if confirmed:
            core._wait_restored_agent(name, startup_confirmed=True)
        elif not_ready:
            core._wait_restored_agent(name)
        started_ok = True

    if started_ok:
        prompt = core.role_reinforcement_prompt(name, slug, cwd, siblings, lean=lean)
        try:
            run("agent", "prompt", name, prompt)
        except RuntimeError as exc:
            print(f"  {pane_id}: aviso — falhei mandando reforço de papel pra {name}: {exc}")


def find_unnamed_role_base(agents, workspace_id, tab1_id, expected_kind=None, expected_cwd=None):
    """Encontra um pane de papel headless que perdeu apenas o registro de nome.

    Um processo vivo sem ``name`` é uma base de restauração, não uma pane
    vazia. Para o scout, a própria tab fora da tab 1 identifica o papel; a
    família observada vence a da tabela quando há exatamente um candidato.
    Agentes com outro nome nunca são tomados à força.
    """
    candidates = [
        a for a in agents
        if a.get("workspace_id") == workspace_id
        and a.get("tab_id") != tab1_id
        and not a.get("name")
        and (expected_kind is None or a.get("agent") == expected_kind)
        and (expected_cwd is None or anonymous_project_matches(a, expected_cwd))
        and not review_groups.protected_candidate(a, agents, core)
    ]
    return candidates[0] if len(candidates) == 1 else None


def find_unnamed_reviewer_base(agents, workspace_id, tab1_id, missing_names, existing_names,
                               expected_cwd=None):
    """Retorna uma base anônima de revisor somente quando a associação é única.

    A ordem de ``pane list`` não é evidência de papel. Restauramos um nome
    apenas se há exatamente um revisor esperado ausente e exatamente um agent
    anônimo na tab 1, com o nome ainda livre; caso contrário, deixamos a
    recuperação falhar fechada para não carimbar o papel errado.
    """
    missing = [name for name in missing_names if name not in existing_names]
    candidates = [
        a for a in agents
        if a.get("workspace_id") == workspace_id
        and a.get("tab_id") == tab1_id
        and not a.get("name")
        and (expected_cwd is None or anonymous_project_matches(a, expected_cwd))
        and not review_groups.protected_candidate(a, agents, core)
    ]
    if len(missing) == 1 and len(candidates) == 1:
        return candidates[0], missing[0]
    return None


def anonymous_project_matches(info, cwd):
    root = core.project_root(cwd)
    return all(info.get(field) and core.project_root(info[field]) == root
               for field in ("cwd", "foreground_cwd"))


def bootstrap_review_group(group, args):
    """Only create missing disposable roles; never restore the coordinator."""
    review_groups.validate_registry(SPACES)
    names = []
    if args.with_reviewers:
        names += [f"{group.slug}-rev-1", f"{group.slug}-rev-2"]
    if args.with_scout:
        if not group.scout_kind:
            raise RuntimeError(f"grupo {group.slug} não declara scout")
        names.append(f"{group.slug}-scout")
    for role in args.role:
        name = f"{group.slug}-{role}"
        if name not in group.roles():
            raise RuntimeError(f"papel não declarado: {name}")
        if name not in names:
            names.append(name)
    names = [name for name in group.roles() if name in names]
    binding = review_groups.resolve_binding(group, core)
    gate = migration.space_gate_message(binding["root"], group.slug)
    if gate:
        raise RuntimeError(gate)
    from contextlib import nullcontext
    with (nullcontext() if DRY else review_groups.group_lock(group, core)):
        review_groups.revalidate(binding, core)
        selective = bool(args.role) and not args.with_reviewers and not args.with_scout
        members = review_groups.existing_members(binding, core, names=names if selective else None)
        if selective:
            # Healthy siblings may anchor layout. An invalid, unrequested
            # sibling is never an authority or source for a split.
            for other in group.roles():
                if other in names:
                    continue
                try:
                    members[other] = review_groups.validate_member(binding, other, core.get_agent_info(other), core)
                except RuntimeError:
                    continue
        owner = binding["coordinator"]
        print(f"grupo {group.slug}: coordenador {group.coordinator_name}, "
              f"tab {owner['tab_id']}, raiz {binding['root']}")
        reservations = {n: members.get(n, {"workspace_id": owner["workspace_id"]}) for n in names}
        with (nullcontext() if DRY else core._dispatch_submission_locks(reservations)):
            for name in names:
                review_groups.revalidate(binding, core)
                order = list(group.roles())
                predecessors = [n for n in order[:order.index(name)] if n in members]
                previous = predecessors[-1] if predecessors else None
                source = members[previous]["pane_id"] if previous else owner["pane_id"]
                if previous and not DRY:
                    source_info = review_groups.validate_member(binding, previous, core.get_agent_info(previous), core)
                    if review_groups.identity(source_info) != review_groups.identity(members[previous]):
                        raise RuntimeError("identidade do pane de origem mudou antes do split")
                if name in members:
                    review_groups.validate_member(binding, name, core.get_agent_info(name), core)
                    print(f"  {name}: existente, preservando pane e perfil")
                    source = members[name]["pane_id"]
                    continue
                role, kind = group.roles()[name]
                if role == "rev-1":
                    extra = REV_EFFORT if kind == "codex" else REV1_ARGS_CLAUDE
                elif role == "rev-2":
                    extra = migration.extra_args_for_rev2(kind)
                else:
                    extra = SCOUT_ARGS if kind == "codex" else SCOUT_ARGS_CLAUDE
                extra = core.codex_launch_flags(list(extra)) if kind == "codex" else list(extra)
                direction = "right" if source == owner["pane_id"] else "down"
                print(f"  criar {name} ({kind}, {' '.join(extra)}) na tab {owner['tab_id']}")
                split_command = ["pane", "split", source, "--direction", direction,
                                 "--cwd", binding["root"], "--no-focus"]
                created = run(*split_command)
                if DRY:
                    members[name] = {"pane_id": f"<novo-pane-{name}>"}
                    continue
                pane = created["pane"]["pane_id"]
                new_pane = startup.created_pane_receipt(startup_runtime(), created["pane"], binding["root"])
                # Do not close a possibly occupied pane on failure. Report the
                # returned ID so an operator can inspect this partial creation.
                try:
                    observed = api("pane", "get", pane)["pane"]
                    if observed.get("agent") or any(observed.get(f) != owner[f]
                                                     for f in ("tab_id", "workspace_id")):
                        raise RuntimeError("split não pertence ao vínculo esperado")
                    review_groups.revalidate(binding, core)
                    trust.ensure_trusted(binding["root"], kind)
                    try:
                        run("agent", "start", name, "--kind", kind, "--pane", pane, "--", *extra)
                    except RuntimeError as exc:
                        if "agent_not_ready" not in str(exc):
                            raise
                    confirmed = startup.finish_start(startup_runtime(),new_pane,pane=pane,name=name,kind=kind)
                    if confirmed:
                        core._wait_restored_agent(name, startup_confirmed=True)
                    else:
                        core._wait_restored_agent(name)
                    current = core.get_agent_info(name)
                    first_turn = kind == "codex" and current.get("agent_session") is None
                    if first_turn:
                        current = initial_hydration.hydrate_locked(binding, name, pane, core)
                    else:
                        current = review_groups.validate_member(binding, name, current, core)
                    if current["pane_id"] != pane:
                        raise RuntimeError("nome do revisor resolveu para outro pane")
                    review_groups.revalidate(binding, core)
                    prompt = core.role_reinforcement_prompt(
                        name, group.slug, binding["root"],
                        [group.coordinator_name, *[n for n in group.roles() if n != name]],
                        coordinator_name=group.coordinator_name,
                    )
                    try:
                        if not first_turn:
                            run("agent", "prompt", name, prompt)
                        print(f"  {name}: criado; hydrated=true")
                    except core.GroupBindingRefusedError:
                        raise
                    except core.DeliveryRefusedError as exc:
                        # The complete request protocol still applies before any
                        # later dispatch, which must pass its own guard again.
                        print(f"  {name}: criado; hidratação recusada pela guarda; "
                              f"hydrated=false; {exc}")
                    members[name] = current
                    source = pane
                except RuntimeError as exc:
                    raise RuntimeError(f"grupo {group.slug}: criação parcial em {pane}; "
                                       f"pane preservado para inspeção: {exc}") from exc
    return 0


def main():
    global DRY
    ap = argparse.ArgumentParser(description="garante os agents definidos na tabela SPACES")
    ap.add_argument("--dry-run", action="store_true",
                    help="mostra o plano sem criar workspace, pane, tab ou agent")
    alvo = ap.add_mutually_exclusive_group()
    alvo.add_argument("--space", metavar="LABEL",
                      help="processa somente o workspace com este label")
    alvo.add_argument("--slug", metavar="SLUG",
                      help="processa somente a entrada cujo prefixo de agents é este slug")
    alvo.add_argument("--group", metavar="SLUG", help="grupo na tab do coordenador existente")
    ap.add_argument("--with-reviewers", action="store_true",
                    help="sobe tambem os REVISORES dos spaces enxutos (`lean`) nesta execucao; "
                         "e' o que os dispatchers usam para ligar sob demanda")
    ap.add_argument("--with-scout", action="store_true",
                    help="sobe tambem o SCOUT dos spaces enxutos nesta execucao (so quando "
                         "alguem o requisitou: `--with-reviewers` nao o liga)")
    ap.add_argument("--role", action="append", default=[], choices=["rev-1", "rev-2", "scout"],
                    help="cria somente este revisor (--slug) ou papel de grupo (repetível)")
    ap.add_argument("--hydrate-initial", choices=["rev-1", "rev-2", "scout"],
                    help="somente o primeiro turno de um Codex existente sem sessão")
    ap.add_argument("--pane", help="pane explicitamente autorizado para --hydrate-initial")
    args = ap.parse_args()
    DRY = args.dry_run
    if args.hydrate_initial or args.pane:
        if (not args.hydrate_initial or not args.pane or not args.group
                or args.with_reviewers or args.with_scout or args.role):
            ap.error("--hydrate-initial exige --group e --pane, sem provisionamento de papéis")

    group = review_groups.get_group(args.group or args.slug)
    if args.group and group is None:
        ap.error(f"grupo não registrado: {args.group}")
    if group is not None:
        try:
            if args.hydrate_initial:
                from contextlib import nullcontext
                name = f"{group.slug}-{args.hydrate_initial}"
                binding = review_groups.resolve_binding(group, core)
                gate = migration.space_gate_message(binding["root"], group.slug)
                if gate:
                    raise RuntimeError(gate)
                with (nullcontext() if DRY else review_groups.group_lock(group, core)):
                    with (nullcontext() if DRY else core._dispatch_submission_locks({name: core.get_agent_info(name)})):
                        initial_hydration.hydrate_locked(binding, name, args.pane, core, dry_run=DRY)
                return 0
            return bootstrap_review_group(group, args)
        except (RuntimeError, OSError, ValueError, KeyError) as exc:
            print(f"erro: {exc}", file=sys.stderr)
            return 1

    if args.role and (not args.slug or args.with_reviewers or args.with_scout):
        ap.error("--role exige --slug e não combina com --with-reviewers/--with-scout")
    if "scout" in args.role:
        ap.error("--role scout exige um grupo registrado")

    workspaces = {w["label"]: w for w in api("workspace", "list")["workspaces"]}
    panes_by_ws = {}
    for p in api("pane", "list")["panes"]:
        panes_by_ws.setdefault(p["workspace_id"], []).append(p)
    agents = api("agent", "list")["agents"]
    busy = {a["pane_id"] for a in agents}
    existing_agent_names = {a.get("name") for a in agents if a.get("name")}

    matched_target = args.space is None and args.slug is None
    startup_failures = []
    processed_workspace_ids = set()
    new_panes = {}
    for entry in SPACES:
        label, cwd, exec_agent, scout = entry[:4]
        # 5o elemento opcional: slug explicito, quando o label do workspace
        # (que so pode ser o de um workspace ja existente - nao renomeamos
        # nada aqui) diverge do slug usado nos nomes dos agents. Achado
        # 2026-09-02: o usuario ja tinha criado o workspace "llm-gateway"
        # (com llm-exec rodando) manualmente ANTES de pedir os revisores;
        # renomear o workspace dele nao era uma opcao, entao o slug "llm"
        # (que da nome a llm-rev/llm-rev-2/llm-scout) precisa ficar
        # desacoplado do label "llm-gateway" so pra este space.
        slug = entry[4] if len(entry) > 4 else label.lower()
        if args.space is not None and label != args.space:
            continue
        if args.slug is not None and slug != args.slug:
            continue
        matched_target = True
        # project_root(), não o cwd cru da tupla — achado P3-1 herdr-7: o
        # mesmo path pode ser lido de formas diferentes por herdr-migrate-rev
        # (que usa o cwd real do agent vivo) e por aqui (valor estático de
        # SPACES); normalizar os dois pelo mesmo git root evita ler
        # migration-state.json do lugar errado quando o path aqui aponta pra
        # um subdiretório do repo real.
        migration_cwd = core.project_root(cwd)
        gate_msg = migration.space_gate_message(migration_cwd, slug)
        if gate_msg is not None:
            print(f"space {label}: {gate_msg} — pulando esta rodada")
            continue
        ws = workspaces.get(label)
        # Space que nasce agora nasce ja migrado. build_rev_agents() abaixo le
        # a fase pra decidir entre "<slug>-rev" e "<slug>-rev-1", e a ausencia
        # do migration-state.json significa "legacy" -- entao sem isto todo
        # space novo nasce com o nome ANTIGO e precisa de um
        # herdr-migrate-rev logo em seguida (foi o que aconteceu com
        # omaspotlight em 2026-09-10). Nao ha nada pra migrar num space que
        # ainda nao tem agent nenhum: a fase legacy so existe pra proteger os
        # spaces que ja tinham um "-rev" vivo quando a migracao comecou.
        # Condicionado a `ws is None` de proposito -- um space existente em
        # legacy continua exigindo o herdr-migrate-rev, que renomeia o agent
        # vivo com flock e marcador de proveniencia.
        if ws is None and not DRY:
            if migration.read_migration_state(migration_cwd)["phase"] == "legacy":
                migration.write_migration_state_atomic(migration_cwd, {"phase": "migrated"})

        lean = is_lean(entry, args.with_reviewers)            # revisores
        lean_scout = is_lean(entry, args.with_scout)          # scout (independente)
        if lean or lean_scout:
            print(f"space {label}: enxuto (só o exec; revisores/scout sobem sob demanda)")
        tab1_agents = ([exec_agent] if exec_agent else []) + (
            [] if lean else build_rev_agents(slug, migration_cwd))

        if args.role:
            # Selective recovery never starts a sibling, scout or exec.
            reviewer_entries = build_rev_agents(slug, migration_cwd)
            requested = {name for name, _kind, _extra in reviewer_entries
                         if ("rev-1" in args.role and name.endswith(("-rev", "-rev-1")))
                         or ("rev-2" in args.role and name.endswith("-rev-2"))}
            tab1_agents = ([exec_agent] if exec_agent else []) + [
                entry for entry in reviewer_entries if entry[0] in requested]
            lean_scout = True
        if ws is None:
            print(f"space {label}: criando (cwd={cwd})")
            res = run("workspace", "create", "--label", label, "--cwd", cwd, "--no-focus")
            if DRY:
                continue
            ws_id = res["workspace"]["workspace_id"]
            root_pane = res["root_pane"]
            new_panes[root_pane["pane_id"]] = startup.created_pane_receipt(startup_runtime(),root_pane,cwd)
            panes_by_ws[ws_id] = [{"pane_id": res["root_pane"]["pane_id"], "tab_id": f"{ws_id}:t1"}]
        else:
            ws_id = ws["workspace_id"]
            print(f"space {label}: já existe ({ws_id})")
        processed_workspace_ids.add(ws_id)

        # `pane list` includes panes from every tab. Reviewers belong to tab 1;
        # never let a scout/board pane from another tab fill a reviewer slot.
        tab1_id = f"{ws_id}:t1"
        panes = [p["pane_id"] for p in panes_by_ws.get(ws_id, []) if p.get("tab_id") == tab1_id]
        while len(panes) < len(tab1_agents):
            # 1o pane extra abre a direita (wide->right); os seguintes empilham
            # para baixo a partir do ultimo, para nao virar colunas apertadas.
            direction = "right" if len(panes) == 1 else "down"
            print(f"  split ({direction}): {label} precisa de {len(tab1_agents)} panes na tab 1, tem {len(panes)}")
            res = run(*split_argv(panes[-1], direction, cwd))
            if DRY:
                break
            new_panes[res["pane"]["pane_id"]] = startup.created_pane_receipt(startup_runtime(),res["pane"],cwd)
            panes.append(res["pane"]["pane_id"])

        if lean_scout:
            scout = None        # enxuto: sem scout (nem tab propria) ate ser chamado
        all_names = [n for (n, _, _) in tab1_agents] + ([scout[0]] if scout else [])
        # A ordem de `pane list` não representa papéis. Primeiro associe por
        # nome já observado; só panes livres podem receber um papel ausente.
        named_tab_agents = {
            a.get("name"): a for a in agents
            if a.get("workspace_id") == ws_id and a.get("tab_id") == tab1_id
            and a.get("name")
        }
        missing_reviewer_names = [
            name for name, _kind, _args in tab1_agents
            if name.endswith(("-rev-1", "-rev-2")) and name not in named_tab_agents
        ]
        unnamed_reviewer = find_unnamed_reviewer_base(
            agents, ws_id, tab1_id, missing_reviewer_names,
            set(named_tab_agents), expected_cwd=cwd,
        )
        assigned = set()
        if unnamed_reviewer is not None:
            unnamed_pane, unnamed_name = unnamed_reviewer
            pane_id = unnamed_pane.get("pane_id")
            print(f"  {pane_id}: revisor sem nome encontrado; restaurando '{unnamed_name}' sem reiniciar")
            if not DRY:
                run("agent", "rename", pane_id, unnamed_name)
                named_tab_agents[unnamed_name] = unnamed_pane
            assigned.add(pane_id)

        for name, kind, extra_args in tab1_agents:
            if args.role and name not in requested:
                if name in named_tab_agents:
                    assigned.add(named_tab_agents[name].get("pane_id"))
                continue
            existing = named_tab_agents.get(name)
            if existing is not None:
                assigned.add(existing.get("pane_id"))
                print(f"  {existing.get('pane_id')}: '{name}' já existe, preservando o pane e o perfil")
                continue
            pane_id = next(
                (candidate for candidate in panes
                 if candidate not in busy and candidate not in assigned),
                None,
            )
            if pane_id is None:
                print(f"  erro: não há pane livre para '{name}'; nenhum agent ocupado será reiniciado",
                      file=sys.stderr)
                continue
            siblings = [n for n in all_names if n != name]
            # Reserve even a failed start: a blocked process is not a free pane.
            assigned.add(pane_id)
            busy.add(pane_id)
            try:
                start_agent_with_role(pane_id, name, kind, extra_args, slug, cwd, siblings, lean=lean,
                                      new_pane=new_panes.get(pane_id))
            except (startup.StartupDialogRefused, core.AgentRestoreError) as exc:
                startup_failures.append((name, pane_id))
                print(f"  {name}: {exc}", file=sys.stderr)
                continue
            assigned.add(pane_id)
            busy.add(pane_id)
            named_tab_agents[name] = {"pane_id": pane_id}

        if scout is not None:
            scout_name, scout_kind, scout_extra = scout
            if scout_name in existing_agent_names:
                print(f"  {scout_name}: já existe (tab própria), pulando")
            else:
                base = find_unnamed_role_base(agents, ws_id, tab1_id, expected_cwd=cwd)
                if base is not None:
                    # O processo já existe e pode ter um perfil escolhido à
                    # mão. Só restauramos o metadado de nome; não reiniciamos
                    # nem aplicamos os defaults da tabela por cima dele.
                    print(f"  {base['pane_id']}: scout sem nome encontrado; restaurando '{scout_name}' sem reiniciar")
                    if not DRY:
                        run("agent", "rename", base["pane_id"], scout_name)
                        existing_agent_names.add(scout_name)
                else:
                    print(f"  {label}: scout precisa de tab própria, criando...")
                    res = run("tab", "create", "--workspace", ws_id, "--cwd", cwd, "--label", "scout", "--no-focus")
                    if not DRY:
                        scout_pane_id = res["root_pane"]["pane_id"]
                        siblings = [n for n in all_names if n != scout_name]
                        new_pane = startup.created_pane_receipt(startup_runtime(),res["root_pane"],cwd)
                        busy.add(scout_pane_id)
                        try:
                            start_agent_with_role(scout_pane_id, scout_name, scout_kind, scout_extra, slug, cwd, siblings,
                                                  new_pane=new_pane)
                        except (startup.StartupDialogRefused, core.AgentRestoreError) as exc:
                            startup_failures.append((scout_name, scout_pane_id))
                            print(f"  {scout_name}: {exc}", file=sys.stderr)

    if not matched_target:
        alvo_texto = args.space or args.slug
        print(f"erro: nenhum space na tabela SPACES corresponde a {alvo_texto!r}", file=sys.stderr)
        return 1

    ensure_notify_watchers(processed_workspace_ids if not (args.space is None and args.slug is None) else None)
    if startup_failures:
        print("herdr-bootstrap: agents parados: " + ", ".join(
            f"{name} ({pane})" for name, pane in startup_failures), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, OSError) as exc:
        print(f"herdr-bootstrap: {exc}", file=sys.stderr)
        sys.exit(1)
