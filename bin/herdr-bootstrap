def build_rev_agents(slug, cwd):
    """Monta as tuplas (nome, kind, extra_args) dos dois revisores em
    runtime, lendo a fase e o rev2_kind de migration-state.json daquele
    space. Nunca cria "<slug>-rev-1" fora da fase "migrated"; nunca recria
    "<slug>-rev" depois de "migrated". REV_OVERRIDES[slug], se existir,
    substitui os extra_args default (REV_EFFORT / extra_args_for_rev2) -
    ver comentario da constante pro porque isto nao vive em
    migration-state.json."""
    state = migration.read_migration_state(cwd)
    rev_name = f"{slug}-rev-1" if state["phase"] == "migrated" else f"{slug}-rev"
    rev2_kind = state["rev2_kind"]
    override = REV_OVERRIDES.get(slug, {})
    rev_extra_args = override.get("rev_extra_args", REV_EFFORT)
    rev2_extra_args = override.get("rev2_extra_args", migration.extra_args_for_rev2(rev2_kind))
    return [
        (rev_name, "codex", rev_extra_args),
        (f"{slug}-rev-2", rev2_kind, rev2_extra_args),
    ]


def api(*args):
    out = subprocess.run(core.herdr_argv(*args), capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {out.stderr.strip() or out.stdout.strip()}")
    return json.loads(out.stdout)["result"]


def run(*args):
    if DRY:
        print(f"  [dry-run] herdr {' '.join(args)}")
        return None
    return api(*args)


def ensure_notify_watchers(workspace_ids=None):
    """Arma um herdr-notify-watch pra cada agent '*-exec' vivo.

    Nao checa se ja tem um rodando por fora (pgrep e' fragil e ja duplicou
    processo antes) - o proprio herdr-notify-watch se tranca com flock, entao
    chamar aqui de novo mesmo com um watch ja vivo e' seguro: a instancia nova
    detecta o lock e sai sozinha sem duplicar.
    """
    watch_bin = os.path.expanduser("~/.local/bin/herdr-notify-watch")
    for a in api("agent", "list")["agents"]:
        name = a.get("name", "")
        if not name.endswith("-exec"):
            continue
        if workspace_ids is not None and a.get("workspace_id") not in workspace_ids:
            continue
        print(f"  notify-watch {name}: armando (flock evita duplicar)")
        if DRY:
            continue
        subprocess.Popen(
            [watch_bin, name],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
            start_new_session=True,
        )


def start_agent_with_role(pane_id, name, kind, extra_args, label, cwd, siblings):
    """Sobe (name, kind) no pane_id e, se subir de verdade, manda o reforço de
    papel — usado tanto pro loop de split da tab 1 quanto pra tab do scout,
    pra não duplicar a mesma lógica dos dois lugares. Os argumentos de model e
    effort são passados explicitamente na criação; os resets posteriores de
    `herdr-review-dispatch`/`herdr-ask` verificam que esse perfil não mudou."""
    full_extra = list(extra_args)
    if kind == "codex":
        # desliga o sistema nativo de sub-agentes do Codex - ver
        # core.CODEX_NO_NATIVE_AGENTS pro porque (achado real,
        # omabackup-exec 2026-08-29)
        full_extra += core.CODEX_NO_NATIVE_AGENTS
    print(f"  {pane_id}: iniciando {kind} como '{name}'" + (f" ({' '.join(full_extra)})" if full_extra else ""))
    started_ok = False
    try:
        args = ["agent", "start", name, "--kind", kind, "--pane", pane_id]
        if full_extra:
            args += ["--", *full_extra]
        run(*args)
        started_ok = True
    except RuntimeError as exc:
        # agent_not_ready = subiu mas parou num prompt (ex: trust do diretorio).
        # Nao e falha: segue, mas nao manda reforco de papel - o agent nao
        # esta pronto pra receber prompt ainda.
        if "agent_not_ready" in str(exc):
            print(f"  {pane_id}: {name} subiu mas aguarda input humano")
        else:
            raise

    if started_ok:
        prompt = core.role_reinforcement_prompt(name, label, cwd, siblings)
        try:
            run("agent", "prompt", name, prompt)
        except RuntimeError as exc:
            print(f"  {pane_id}: aviso — falhei mandando reforço de papel pra {name}: {exc}")


def find_unnamed_role_base(agents, workspace_id, tab1_id, expected_kind=None):
    """Encontra um pane de papel headless que perdeu apenas o registro de nome.

    Um processo vivo sem ``name`` é uma base de restauração, não uma pane
    vazia. Para o scout, a própria tab fora da tab 1 identifica o papel; a
    família observada vence a da tabela quando há exatamente um candidato.
    Agentes com outro nome nunca são tomados à força.
    """
    candidates = [
        a for a in agents
        if a.get("workspace_id") == workspace_id
        and a.get("tab_id") != tab1_id
        and not a.get("name")
        and (expected_kind is None or a.get("agent") == expected_kind)
    ]
    return candidates[0] if len(candidates) == 1 else None


def find_unnamed_reviewer_base(agents, workspace_id, tab1_id, missing_names, existing_names):
    """Retorna uma base anônima de revisor somente quando a associação é única.

    A ordem de ``pane list`` não é evidência de papel. Restauramos um nome
    apenas se há exatamente um revisor esperado ausente e exatamente um agent
    anônimo na tab 1, com o nome ainda livre; caso contrário, deixamos a
    recuperação falhar fechada para não carimbar o papel errado.
    """
    missing = [name for name in missing_names if name not in existing_names]
    candidates = [
        a for a in agents
        if a.get("workspace_id") == workspace_id
        and a.get("tab_id") == tab1_id
        and not a.get("name")
    ]
    if len(missing) == 1 and len(candidates) == 1:
        return candidates[0], missing[0]
    return None


def main():
    global DRY
    ap = argparse.ArgumentParser(description="garante os agents definidos na tabela SPACES")
    ap.add_argument("--dry-run", action="store_true",
                    help="mostra o plano sem criar workspace, pane, tab ou agent")
    alvo = ap.add_mutually_exclusive_group()
    alvo.add_argument("--space", metavar="LABEL",
                      help="processa somente o workspace com este label")
    alvo.add_argument("--slug", metavar="SLUG",
                      help="processa somente a entrada cujo prefixo de agents é este slug")
    args = ap.parse_args()
    DRY = args.dry_run

    workspaces = {w["label"]: w for w in api("workspace", "list")["workspaces"]}
    panes_by_ws = {}
    for p in api("pane", "list")["panes"]:
        panes_by_ws.setdefault(p["workspace_id"], []).append(p)
    agents = api("agent", "list")["agents"]
    busy = {a["pane_id"] for a in agents}
    existing_agent_names = {a.get("name") for a in agents if a.get("name")}

    matched_target = args.space is None and args.slug is None
    processed_workspace_ids = set()
    for entry in SPACES:
        label, cwd, exec_agent, scout = entry[:4]
        # 5o elemento opcional: slug explicito, quando o label do workspace
        # (que so pode ser o de um workspace ja existente - nao renomeamos
        # nada aqui) diverge do slug usado nos nomes dos agents. Achado
        # 2026-09-02: o usuario ja tinha criado o workspace "llm-gateway"
        # (com llm-exec rodando) manualmente ANTES de pedir os revisores;
        # renomear o workspace dele nao era uma opcao, entao o slug "llm"
        # (que da nome a llm-rev/llm-rev-2/llm-scout) precisa ficar
        # desacoplado do label "llm-gateway" so pra este space.
        slug = entry[4] if len(entry) > 4 else label.lower()
        if args.space is not None and label != args.space:
            continue
        if args.slug is not None and slug != args.slug:
            continue
        matched_target = True
        # project_root(), não o cwd cru da tupla — achado P3-1 herdr-7: o
        # mesmo path pode ser lido de formas diferentes por herdr-migrate-rev
        # (que usa o cwd real do agent vivo) e por aqui (valor estático de
        # SPACES); normalizar os dois pelo mesmo git root evita ler
        # migration-state.json do lugar errado quando o path aqui aponta pra
        # um subdiretório do repo real.
        migration_cwd = core.project_root(cwd)
        gate_msg = migration.space_gate_message(migration_cwd, slug)
        if gate_msg is not None:
            print(f"space {label}: {gate_msg} — pulando esta rodada")
            continue
        ws = workspaces.get(label)
        # Space que nasce agora nasce ja migrado. build_rev_agents() abaixo le
        # a fase pra decidir entre "<slug>-rev" e "<slug>-rev-1", e a ausencia
        # do migration-state.json significa "legacy" -- entao sem isto todo
        # space novo nasce com o nome ANTIGO e precisa de um
        # herdr-migrate-rev logo em seguida (foi o que aconteceu com
        # omaspotlight em 2026-09-10). Nao ha nada pra migrar num space que
        # ainda nao tem agent nenhum: a fase legacy so existe pra proteger os
        # spaces que ja tinham um "-rev" vivo quando a migracao comecou.
        # Condicionado a `ws is None` de proposito -- um space existente em
        # legacy continua exigindo o herdr-migrate-rev, que renomeia o agent
        # vivo com flock e marcador de proveniencia.
        if ws is None and not DRY:
            if migration.read_migration_state(migration_cwd)["phase"] == "legacy":
                migration.write_migration_state_atomic(migration_cwd, {"phase": "migrated"})

        tab1_agents = ([exec_agent] if exec_agent else []) + build_rev_agents(slug, migration_cwd)

        if ws is None:
            print(f"space {label}: criando (cwd={cwd})")
            res = run("workspace", "create", "--label", label, "--cwd", cwd, "--no-focus")
            if DRY:
                continue
            ws_id = res["workspace"]["workspace_id"]
            panes_by_ws[ws_id] = [{"pane_id": res["root_pane"]["pane_id"], "tab_id": f"{ws_id}:t1"}]
        else:
            ws_id = ws["workspace_id"]
            print(f"space {label}: já existe ({ws_id})")
        processed_workspace_ids.add(ws_id)

        # `pane list` includes panes from every tab. Reviewers belong to tab 1;
        # never let a scout/board pane from another tab fill a reviewer slot.
        tab1_id = f"{ws_id}:t1"
        panes = [p["pane_id"] for p in panes_by_ws.get(ws_id, []) if p.get("tab_id") == tab1_id]
        while len(panes) < len(tab1_agents):
            # 1o pane extra abre a direita (wide->right); os seguintes empilham
            # para baixo a partir do ultimo, para nao virar colunas apertadas.
            direction = "right" if len(panes) == 1 else "down"
            print(f"  split ({direction}): {label} precisa de {len(tab1_agents)} panes na tab 1, tem {len(panes)}")
            res = run("pane", "split", panes[-1], "--direction", direction)
            if DRY:
                break
            panes.append(res["pane"]["pane_id"])

        all_names = [n for (n, _, _) in tab1_agents] + ([scout[0]] if scout else [])
        missing_reviewer_names = [name for name, _kind, _args in tab1_agents if name.endswith(("-rev-1", "-rev-2")) and name not in existing_agent_names]
        unnamed_reviewer = find_unnamed_reviewer_base(agents, ws_id, tab1_id, missing_reviewer_names, existing_agent_names)
        if unnamed_reviewer is not None:
            # `pane list` não é ordenado pela tabela de papéis. Coloque o pane
            # anônimo na posição do papel ausente antes do zip abaixo; assim a
            # associação única encontrada pelo helper é aplicada ao pane real,
            # mesmo depois de swaps/rearranjos.
            unnamed_pane, unnamed_name = unnamed_reviewer
            target_index = next(
                (i for i, (name, _kind, _args) in enumerate(tab1_agents)
                 if name == unnamed_name),
                None,
            )
            candidate_index = next(
                (i for i, pane_id in enumerate(panes)
                 if pane_id == unnamed_pane.get("pane_id")),
                None,
            )
            if target_index is not None and candidate_index is not None:
                panes[target_index], panes[candidate_index] = (
                    panes[candidate_index], panes[target_index]
                )
        for pane_id, (name, kind, extra_args) in zip(panes, tab1_agents):
            if pane_id in busy:
                occupant = next((a for a in agents if a.get("pane_id") == pane_id), None)
                if (unnamed_reviewer is not None and occupant is unnamed_reviewer[0]
                        and name == unnamed_reviewer[1]):
                    # The process is the existing base; restore only its
                    # volatile registry name and keep its observed family/model.
                    print(f"  {pane_id}: revisor sem nome encontrado; restaurando '{name}' sem reiniciar")
                    if not DRY:
                        run("agent", "rename", pane_id, name)
                        existing_agent_names.add(name)
                        unnamed_reviewer = None
                else:
                    print(f"  {pane_id}: já tem agent, pulando")
                continue
            siblings = [n for n in all_names if n != name]
            start_agent_with_role(pane_id, name, kind, extra_args, label, cwd, siblings)

        if scout is not None:
            scout_name, scout_kind, scout_extra = scout
            if scout_name in existing_agent_names:
                print(f"  {scout_name}: já existe (tab própria), pulando")
            else:
                base = find_unnamed_role_base(agents, ws_id, tab1_id)
                if base is not None:
                    # O processo já existe e pode ter um perfil escolhido à
                    # mão. Só restauramos o metadado de nome; não reiniciamos
                    # nem aplicamos os defaults da tabela por cima dele.
                    print(f"  {base['pane_id']}: scout sem nome encontrado; restaurando '{scout_name}' sem reiniciar")
                    if not DRY:
                        run("agent", "rename", base["pane_id"], scout_name)
                        existing_agent_names.add(scout_name)
                else:
                    print(f"  {label}: scout precisa de tab própria, criando...")
                    res = run("tab", "create", "--workspace", ws_id, "--cwd", cwd, "--label", "scout", "--no-focus")
                    if not DRY:
                        scout_pane_id = res["root_pane"]["pane_id"]
                        siblings = [n for n in all_names if n != scout_name]
                        start_agent_with_role(scout_pane_id, scout_name, scout_kind, scout_extra, label, cwd, siblings)

    if not matched_target:
        alvo_texto = args.space or args.slug
        print(f"erro: nenhum space na tabela SPACES corresponde a {alvo_texto!r}", file=sys.stderr)
        return 1

    ensure_notify_watchers(processed_workspace_ids if not (args.space is None and args.slug is None) else None)
    return 0


if __name__ == "__main__":
    sys.exit(main())
