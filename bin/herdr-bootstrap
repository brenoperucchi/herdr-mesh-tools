#!/usr/bin/env python3
"""herdr-bootstrap — garante spaces, panes e agents do ambiente de trabalho.

Idempotente: só cria o que falta e só inicia agent em pane que ainda não tem.
Uso: herdr-bootstrap [--dry-run]
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _herdr_dispatch as core
import _herdr_migration as migration

HERDR = os.path.expanduser("~/.local/bin/herdr")
HOME = os.path.expanduser("~")
DRY = "--dry-run" in sys.argv

# label -> (cwd, [(nome_do_agent, kind, extra_args), ...])
# Layout: pane 1 = exec (esquerda, altura toda); pane 2 = rev (split right);
# pane 3 = rev-2 (split down a partir do pane 2, empilhado sob o rev).
#
# Effort dos revisores (2026-08-26, achado da revisao de eficiencia de token):
# ate aqui "-rev" subia em gpt-5.6-luna "max" so porque era o default global
# do ~/.codex/config.toml - nunca foi decisao, e os dois revisores (Codex e
# Opus, cegos entre si) bateram na mesma critica: dois revisores no teto e'
# redundancia cara. REV_EFFORT torna isso explicito e um degrau abaixo de
# "max", mantendo "-rev-2" (Opus, ja deliberadamente --model opus) como a
# lente cara. Sem dado suficiente ainda pra ir mais longe que isso (ver
# metrics.json / artifact "Ciclo de Revisao").
REV_EFFORT = ["--model", "gpt-6-astra", "-c", "model_reasoning_effort=high"]

# Achado 2026-09-09 (consulta herdr-8, os dois revisores + pesquisa de preco):
# "nao pinar" nunca foi neutro - todo papel sem --model/--effort explicito
# herdava ~/.claude/settings.json ou ~/.codex/config.toml, e esses arquivos sao
# REESCRITOS pelo /model interativo. Um /model num pane qualquer mudava o effort
# de todos os rev-2 do mesh, e foi assim que dois revisores acordaram em Fable
# 5.1 (o modelo MAIS caro do catalogo, $10/$50 - o dobro do Opus pretendido).
# Dai a regra: model E effort explicitos em TODO papel, sempre.
EXEC_ARGS = ["--model", "sonnet", "--effort", "high"]

# scout: Terra @ max (decisao do usuario 2026-09-09). Terra e' 5x mais barato
# que Astra na entrada e ~4x na saida, e o scout rodava Astra herdado - o item
# mais caro da config pro trabalho mais barato. O max aqui e' deliberado: torna
# o scout o papel de MAIOR esforco do mesh, contra a orientacao generica pra
# exploracao, porque este scout faz exploracao pesada, nao so busca.
SCOUT_ARGS = ["--model", "gpt-5.6-terra", "-c", "model_reasoning_effort=max"]

# Override pontual de model/effort dos revisores, por slug - a maioria dos
# spaces usa REV_EFFORT/rev2_kind (default "claude", sem effort explicito) e
# nao precisa entrar aqui. So existe quando o usuario pede explicitamente um
# par mais caro que o default pra um space especifico (achado 2026-09-02,
# pedido explicito pro space "llm": Codex gpt-5.6-luna @ max e Claude Opus @
# max - mais caro que o "um degrau abaixo de max" que REV_EFFORT decidiu como
# padrao pra todo o resto). Nao generaliza pra migration-state.json (que so
# guarda rev2_kind) porque isto e' decisao de custo pontual do usuario, nao
# estado de migracao do space.
REV_OVERRIDES = {
    "llm": {
        "rev_extra_args": ["--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=max"],
        "rev2_extra_args": ["--model", "opus", "--effort", "max"],
    },
    # Pedido explicito 2026-09-05: rev-2 aqui e' so "--model opus" (sem
    # effort explicito, ao contrario do "llm" acima) porque o usuario nao
    # pediu nenhum - extra_args_for_rev2("claude") ja daria exatamente isso
    # por default, mas mantido aqui por completude/legibilidade lado a lado
    # com o rev_extra_args customizado.
    "homehub": {
        "rev_extra_args": ["--model", "gpt-6-astra", "-c", "model_reasoning_effort=medium"],
        "rev2_extra_args": ["--model", "opus"],
    },
}

# label -> (cwd, exec_agent_or_None, scout)
# scout e' sempre tab PROPRIA no workspace (herdr tab create), nunca mais um
# pane splitado na tab 1 - achado explicito do usuario (2026-08-29): scout
# faz um tipo de trabalho diferente (leitura/exploracao paralela) e misturar
# no mesmo tab de exec/rev/rev-2 nao faz sentido de layout. None = sem scout
# neste space.
#
# Os dois revisores ("<slug>-rev" ou "<slug>-rev-1", e "<slug>-rev-2") NAO
# estao mais hardcoded aqui - build_rev_agents() os monta em runtime, lendo
# migration-state.json de cada space (migracao rev->rev-1, ver
# _herdr_migration.py). Isso evita dois bugs achados nas rodadas de revisao
# herdr-4/5/6: bootstrap recriando "-rev" depois que o space ja migrou pra
# "-rev-1", e o "-rev-2" sempre subindo hardcoded como Claude/Opus mesmo com
# a policy viva sendo Grok (rev2_kind por space).
SPACES = [
    ("omabackup", f"{HOME}/Devs/omabackup", ("omabackup-exec", "claude", EXEC_ARGS),
        ("omabackup-scout", "codex", SCOUT_ARGS)),
    ("MFC", os.environ.get("HERDR_MFC_CWD", f"{HOME}/Devs/mfc"), ("mfc-exec", "claude", EXEC_ARGS),
        ("mfc-scout", "codex", SCOUT_ARGS)),
    ("acervo", f"{HOME}/Devs/acervo", ("acervo-exec", "claude", EXEC_ARGS),
        None),
    # DRE: analise financeira (Demonstrativo de Resultado), nao um repo git -
    # herdr-bootstrap nao exige git, so migration.read_migration_state()
    # cai no fallback "phase=legacy" de sempre.
    ("DRE", f"{HOME}/Devs/Khronos/DRE", ("dre-exec", "claude", EXEC_ARGS),
        ("dre-scout", "codex", SCOUT_ARGS)),
    # claude-bridge: o proprio orquestrador (Fluxo B). cwd e' o repo de codigo
    # real (~/Devs/claude-bridge), nao o dir de runtime (~/.claude-bridge, so
    # broker.sqlite/tokens.json) - achado 2026-08-29: claude-bridge-exec
    # relatou honestamente que AGENTS.md/CLAUDE.md/.herdr/reviewer.md nao
    # existiam no cwd registrado porque apontava pro dir errado; o proprio
    # exec ja trabalhava de fato em ~/Devs/claude-bridge (onde o codigo/git
    # realmente vive). exec era Codex no design original (testar o papel de
    # orquestrador externo), trocado pra Claude no batch-swap manual de
    # 2026-08-31 (achado 2026-09-01: esta tabela tinha ficado stale depois
    # da troca - herdr-bootstrap so age em pane vazio, entao nao teria
    # revertido o swap sozinho, mas recriar o agent do zero um dia teria).
    # scout continua Codex (nao fez parte daquele swap, confirmado ao vivo).
    ("claude-bridge", f"{HOME}/Devs/claude-bridge", ("claude-bridge-exec", "claude", EXEC_ARGS),
        ("claude-bridge-scout", "codex", SCOUT_ARGS)),
    # exec trocado pra Claude no mesmo batch-swap de 2026-08-31 (ver
    # claude-bridge acima) - mesma correcao de tabela stale.
    # Workspace e todos os agents foram renomeados de
    # "content-insights-collector"/"content-insights-collector-*" pra
    # "cic"/"cic-*" fora desta sessao - achado 2026-09-04 (dry-run ia criar
    # um workspace DUPLICADO porque o label aqui nao batia mais com o real).
    ("cic", f"{HOME}/Devs/content-insights-collector",
        ("cic-exec", "claude", EXEC_ARGS), None),
    # llm-gateway: label do workspace que o usuario ja tinha criado na mao
    # (llm-exec ja vivo la antes deste script rodar) - slug "llm" (5o
    # elemento) porque foi assim que o usuario nomeou os revisores
    # pedidos (llm-rev/llm-rev-2/llm-scout, nao llm-gateway-rev). rev/rev-2
    # mais caros que o default (ver REV_OVERRIDES) e scout customizado (Sol
    # xhigh) - pedido explicito do usuario 2026-09-02.
    ("llm-gateway", f"{HOME}/Devs/llm-gateway", ("llm-exec", "claude", EXEC_ARGS),
        ("llm-scout", "codex", ["--model", "gpt-5.6-sol", "-c", "model_reasoning_effort=xhigh"]),
        "llm"),
    # llm-bench: workspace e exec ja existiam na mao (pane sem nome, so
    # renomeado pra "llm-bench-exec" 2026-09-04) - label e slug batem aqui,
    # sem divergencia (diferente do llm-gateway acima). rev/rev-2/scout com
    # os defaults padrao (REV_EFFORT/rev2_kind claude/scout Codex sem
    # override) - nao foi pedido nada mais caro pra este space.
    ("llm-bench", f"{HOME}/Devs/llm-bench", ("llm-bench-exec", "claude", EXEC_ARGS),
        ("llm-bench-scout", "codex", SCOUT_ARGS)),
    # HomeHub: workspace e exec ja existiam na mao (homehub-exec ja com o
    # nome certo, slug=label.lower() sem divergencia). rev/rev-2 com custo
    # customizado (ver REV_OVERRIDES) - pedido explicito do usuario
    # 2026-09-05. Sem scout - decisao explicita do usuario, nao esquecimento.
    ("HomeHub", f"{HOME}/Devs/HomeHub", ("homehub-exec", "claude", EXEC_ARGS), None),
    # omasession: plugin Omarchy de restauracao de sessao grafica (janelas e
    # workspaces de volta apos reboot/queda). Workspace wS e os 4 agents foram
    # criados na mao em 2026-09-08 antes desta entrada existir - registrado
    # aqui pra que o bootstrap saiba recria-los, nao pra criar de novo (ele so
    # age em pane vazio). Layout e kinds no default de todo mundo:
    # exec Claude, rev-1 Codex (REV_EFFORT), rev-2 Claude, scout Codex; nao
    # foi pedido nada mais caro. slug=label, sem divergencia.
    ("omasession", f"{HOME}/Devs/omasession", ("omasession-exec", "claude", EXEC_ARGS),
        ("omasession-scout", "codex", SCOUT_ARGS)),
    # "herdr": space de meta/tooling do proprio usuario (config, scripts, este
    # tipo de trabalho). Sem entrada de exec aqui de proposito: quem executa
    # e' sempre a sessao interativa anexada a este pane (renomeada na mao pra
    # "herdr-exec", 2026-08-29) - nao e' um agent bootstrapado por este
    # script, entao nao entra no SPACES pra nao arriscar o script tentar
    # reiniciar/trocar uma sessao com humano atras dela. So os revisores sao
    # geridos por aqui.
    ("herdr", HOME, None, None),
]


def build_rev_agents(slug, cwd):
    """Monta as tuplas (nome, kind, extra_args) dos dois revisores em
    runtime, lendo a fase e o rev2_kind de migration-state.json daquele
    space. Nunca cria "<slug>-rev-1" fora da fase "migrated"; nunca recria
    "<slug>-rev" depois de "migrated". REV_OVERRIDES[slug], se existir,
    substitui os extra_args default (REV_EFFORT / extra_args_for_rev2) -
    ver comentario da constante pro porque isto nao vive em
    migration-state.json."""
    state = migration.read_migration_state(cwd)
    rev_name = f"{slug}-rev-1" if state["phase"] == "migrated" else f"{slug}-rev"
    rev2_kind = state["rev2_kind"]
    override = REV_OVERRIDES.get(slug, {})
    rev_extra_args = override.get("rev_extra_args", REV_EFFORT)
    rev2_extra_args = override.get("rev2_extra_args", migration.extra_args_for_rev2(rev2_kind))
    return [
        (rev_name, "codex", rev_extra_args),
        (f"{slug}-rev-2", rev2_kind, rev2_extra_args),
    ]


def api(*args):
    out = subprocess.run([HERDR, *args], capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {out.stderr.strip() or out.stdout.strip()}")
    return json.loads(out.stdout)["result"]


def run(*args):
    if DRY:
        print(f"  [dry-run] herdr {' '.join(args)}")
        return None
    return api(*args)


def ensure_notify_watchers():
    """Arma um herdr-notify-watch pra cada agent '*-exec' vivo.

    Nao checa se ja tem um rodando por fora (pgrep e' fragil e ja duplicou
    processo antes) - o proprio herdr-notify-watch se tranca com flock, entao
    chamar aqui de novo mesmo com um watch ja vivo e' seguro: a instancia nova
    detecta o lock e sai sozinha sem duplicar.
    """
    watch_bin = os.path.expanduser("~/.local/bin/herdr-notify-watch")
    for a in api("agent", "list")["agents"]:
        name = a.get("name", "")
        if not name.endswith("-exec"):
            continue
        print(f"  notify-watch {name}: armando (flock evita duplicar)")
        if DRY:
            continue
        subprocess.Popen(
            [watch_bin, name],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
            start_new_session=True,
        )


def start_agent_with_role(pane_id, name, kind, extra_args, label, cwd, siblings):
    """Sobe (name, kind) no pane_id e, se subir de verdade, manda o reforço de
    papel — usado tanto pro loop de split da tab 1 quanto pra tab do scout,
    pra não duplicar a mesma lógica dos dois lugares."""
    full_extra = list(extra_args)
    if kind == "codex":
        # desliga o sistema nativo de sub-agentes do Codex - ver
        # core.CODEX_NO_NATIVE_AGENTS pro porque (achado real,
        # omabackup-exec 2026-08-29)
        full_extra += core.CODEX_NO_NATIVE_AGENTS
    print(f"  {pane_id}: iniciando {kind} como '{name}'" + (f" ({' '.join(full_extra)})" if full_extra else ""))
    started_ok = False
    try:
        args = ["agent", "start", name, "--kind", kind, "--pane", pane_id]
        if full_extra:
            args += ["--", *full_extra]
        run(*args)
        started_ok = True
    except RuntimeError as exc:
        # agent_not_ready = subiu mas parou num prompt (ex: trust do diretorio).
        # Nao e falha: segue, mas nao manda reforco de papel - o agent nao
        # esta pronto pra receber prompt ainda.
        if "agent_not_ready" in str(exc):
            print(f"  {pane_id}: {name} subiu mas aguarda input humano")
        else:
            raise

    if started_ok:
        prompt = core.role_reinforcement_prompt(name, label, cwd, siblings)
        try:
            run("agent", "prompt", name, prompt)
        except RuntimeError as exc:
            print(f"  {pane_id}: aviso — falhei mandando reforço de papel pra {name}: {exc}")


def main():
    workspaces = {w["label"]: w for w in api("workspace", "list")["workspaces"]}
    panes_by_ws = {}
    for p in api("pane", "list")["panes"]:
        panes_by_ws.setdefault(p["workspace_id"], []).append(p["pane_id"])
    busy = {a["pane_id"] for a in api("agent", "list")["agents"]}
    existing_agent_names = {a.get("name") for a in api("agent", "list")["agents"] if a.get("name")}

    for entry in SPACES:
        label, cwd, exec_agent, scout = entry[:4]
        # 5o elemento opcional: slug explicito, quando o label do workspace
        # (que so pode ser o de um workspace ja existente - nao renomeamos
        # nada aqui) diverge do slug usado nos nomes dos agents. Achado
        # 2026-09-02: o usuario ja tinha criado o workspace "llm-gateway"
        # (com llm-exec rodando) manualmente ANTES de pedir os revisores;
        # renomear o workspace dele nao era uma opcao, entao o slug "llm"
        # (que da nome a llm-rev/llm-rev-2/llm-scout) precisa ficar
        # desacoplado do label "llm-gateway" so pra este space.
        slug = entry[4] if len(entry) > 4 else label.lower()
        # project_root(), não o cwd cru da tupla — achado P3-1 herdr-7: o
        # mesmo path pode ser lido de formas diferentes por herdr-migrate-rev
        # (que usa o cwd real do agent vivo) e por aqui (valor estático de
        # SPACES); normalizar os dois pelo mesmo git root evita ler
        # migration-state.json do lugar errado quando o path aqui aponta pra
        # um subdiretório do repo real.
        migration_cwd = core.project_root(cwd)
        gate_msg = migration.space_gate_message(migration_cwd, slug)
        if gate_msg is not None:
            print(f"space {label}: {gate_msg} — pulando esta rodada")
            continue
        tab1_agents = ([exec_agent] if exec_agent else []) + build_rev_agents(slug, migration_cwd)

        ws = workspaces.get(label)
        if ws is None:
            print(f"space {label}: criando (cwd={cwd})")
            res = run("workspace", "create", "--label", label, "--cwd", cwd, "--no-focus")
            if DRY:
                continue
            ws_id = res["workspace"]["workspace_id"]
            panes_by_ws[ws_id] = [res["root_pane"]["pane_id"]]
        else:
            ws_id = ws["workspace_id"]
            print(f"space {label}: já existe ({ws_id})")

        panes = panes_by_ws.get(ws_id, [])
        while len(panes) < len(tab1_agents):
            # 1o pane extra abre a direita (wide->right); os seguintes empilham
            # para baixo a partir do ultimo, para nao virar colunas apertadas.
            direction = "right" if len(panes) == 1 else "down"
            print(f"  split ({direction}): {label} precisa de {len(tab1_agents)} panes na tab 1, tem {len(panes)}")
            res = run("pane", "split", panes[-1], "--direction", direction)
            if DRY:
                break
            panes.append(res["pane"]["pane_id"])

        all_names = [n for (n, _, _) in tab1_agents] + ([scout[0]] if scout else [])
        for pane_id, (name, kind, extra_args) in zip(panes, tab1_agents):
            if pane_id in busy:
                print(f"  {pane_id}: já tem agent, pulando")
                continue
            siblings = [n for n in all_names if n != name]
            start_agent_with_role(pane_id, name, kind, extra_args, label, cwd, siblings)

        if scout is not None:
            scout_name, scout_kind, scout_extra = scout
            if scout_name in existing_agent_names:
                print(f"  {scout_name}: já existe (tab própria), pulando")
            else:
                print(f"  {label}: scout precisa de tab própria, criando...")
                res = run("tab", "create", "--workspace", ws_id, "--cwd", cwd, "--label", "scout", "--no-focus")
                if not DRY:
                    scout_pane_id = res["root_pane"]["pane_id"]
                    siblings = [n for n in all_names if n != scout_name]
                    start_agent_with_role(scout_pane_id, scout_name, scout_kind, scout_extra, label, cwd, siblings)

    ensure_notify_watchers()


if __name__ == "__main__":
    main()
