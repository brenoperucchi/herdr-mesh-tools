#!/usr/bin/env python3
"""herdr-bootstrap — garante spaces, panes e agents do ambiente de trabalho.

Idempotente: só cria o que falta e só inicia agent em pane que ainda não tem.
Uso: herdr-bootstrap [--dry-run] [--space LABEL | --slug SLUG]

Quando chamado pelos dispatchers com ``--slug``, limita a operação a um único
space. Isso permite recuperar um papel obrigatório ausente no meio de uma
revisão sem tocar nos demais workspaces.
"""
import argparse
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _herdr_dispatch as core
import _herdr_migration as migration

HERDR = core.HERDR  # compatibilidade para consumidores que importam o módulo
HOME = os.path.expanduser("~")
DRY = "--dry-run" in sys.argv

# label -> (cwd, [(nome_do_agent, kind, extra_args), ...])
# Layout: pane 1 = exec (esquerda, altura toda); pane 2 = rev (split right);
# pane 3 = rev-2 (split down a partir do pane 2, empilhado sob o rev).
#
# Effort dos revisores (2026-08-26, achado da revisao de eficiencia de token):
# ate aqui "-rev" subia em gpt-5.6-luna "max" so porque era o default global
# do ~/.codex/config.toml - nunca foi decisao, e os dois revisores (Codex e
# Opus, cegos entre si) bateram na mesma critica: dois revisores no teto e'
# redundancia cara. REV_EFFORT torna isso explicito e um degrau abaixo de
# "max", mantendo "-rev-2" (Opus, ja deliberadamente --model opus) como a
# lente cara. Sem dado suficiente ainda pra ir mais longe que isso (ver
# metrics.json / artifact "Ciclo de Revisao").
# Decisao do usuario 2026-09-10: rev-1 em medium, rev-2 em xhigh. Isso RESTAURA
# a assimetria que o achado de 2026-08-26 pedia ("dois revisores no teto e'
# redundancia cara") e que tinha se perdido quando os dois foram pinados em
# high: agora o rev-1 e' a rede larga barata e o rev-2 a lente cara de verdade,
# cara no modelo E no raciocinio -- que era a intencao registrada no comentario
# original, nunca a configuracao real.
REV_EFFORT = ["--model", "gpt-6-astra", "-c", "model_reasoning_effort=medium"]

# Matriz normativa: a seleção de um papel depende somente do modelo. O
# reasoning_effort continua explícito quando a CLI é iniciada, mas não cria
# uma variante de perfil nem autoriza promoção para outro modelo.
ALLOWED_MODELS_BY_ROLE = {
    "rev-1": ("gpt-5.6-luna", "gpt-6-astra"),
    "rev-2": ("opus-5",),
    "scout": ("gpt-6-astra", "fable-5", "opus-5"),
    "exec": ("sonnet-5", "opus-5", "gpt-5.6-luna"),
}

# Achado 2026-09-09 (consulta herdr-8, os dois revisores + pesquisa de preco):
# "nao pinar" nunca foi neutro - todo papel sem --model/--effort explicito
# herdava ~/.claude/settings.json ou ~/.codex/config.toml, e esses arquivos sao
# REESCRITOS pelo /model interativo. Um /model num pane qualquer mudava o effort
# de todos os rev-2 do mesh, e foi assim que dois revisores acordaram em Fable
# 5.1 (o modelo MAIS caro do catalogo, $10/$50 - o dobro do Opus pretendido).
# Dai a regra: model E effort explicitos em TODO papel, sempre.
EXEC_ARGS = ["--model", "sonnet-5", "--effort", "high"]

# Perfil explícito do DRE após o swap de 2026-09-15. O ID completo evita que
# uma restauração futura dependa do alias/default global do Claude Code.
EXEC_ARGS_SONNET_5 = ["--model", "claude-sonnet-5", "--effort", "high"]

# Execs migrados pra Codex (2026-09-12). A matriz normativa de exec permite
# `gpt-5.6-luna`; o esforço abaixo continua explícito apenas como parâmetro de
# inicialização e não participa da seleção do modelo.
#
# Esta constante existe porque os swaps foram feitos AO VIVO com herdr-swap e o
# arquivo de policy ficou pra tras: por ~1h o bootstrap teria recriado os cinco
# em Claude/Sonnet, desfazendo a migracao em silencio. Quem trocar um exec
# adiante tem que mexer AQUI tambem, senao o proximo bootstrap reverte.
EXEC_ARGS_CODEX = ["--model", "gpt-5.6-luna", "-c", "model_reasoning_effort=high"]

# scout: Astra @ max (decisao do usuario 2026-09-10, revisando o Terra que
