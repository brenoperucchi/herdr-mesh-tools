#!/usr/bin/env python3
"""herdr-swap <slug> <role> <kind> — troca o kind do agent <slug>-<role> (ex:
claude -> codex, ou -> grok), preservando contexto via handoff escrito em
arquivo pelo próprio agent que está saindo. <role> é qualquer sufixo real
(exec, rev, rev-2, scout, ...) — a mecânica é idêntica pra qualquer papel, só
muda o nome. NÃO manda o buffer/scrollback bruto pro novo agent — isso é
lossy e específico da CLI de cada um. Em vez disso, pede pro agent atual
escrever um resumo de handoff, confirma que ele escreveu, sobe o novo kind num
pane à parte sob nome PROVISÓRIO, confirma que ele respondeu, e só ENTÃO fecha
o pane antigo (mata o processo — pedir pra CLI sair sozinha via send-keys se
mostrou pouco confiável, ctrl+d/ctrl+c não encerraram de forma previsível) e
renomeia o novo pro nome final. Até o close do antigo, tudo é reversível: se o
novo não subir, só se fecha o pane provisório e o antigo continua vivo e
intacto.

Antes de mandar qualquer coisa pro agent antigo (inclusive o pedido de
handoff), confere heuristicamente se o pane não tem composição humana ou
diálogo pendente (`core.pane_looks_busy_with_human_input`) — não é garantia
(existe corrida real entre a leitura e a ação seguinte), é redução de janela.

Depois que o handoff assenta, captura o perfil efetivo. Em Claude, a sonda
`/status` pelo canal oficial é a fonte de seleção atual; o banner de
inicialização pode estar obsoleto depois de `/model` e nunca é herdado sozinho.

Uso:
  herdr-swap <slug> <role> <kind> [-- <agent-args...>]

Exemplos:
  herdr-swap mfc rev-2 grok
  herdr-swap omabackup exec codex

Exige que <slug>-<role> já exista e esteja 'idle' ou 'done' (não troca em
cima de trabalho em andamento).
"""
import argparse
import hashlib
import os
import subprocess
import sys
import time
import re

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _herdr_dispatch as core
import _herdr_migration as migration
import _herdr_local_handoff as local

HERDR = core.HERDR
CLI_TIMEOUT_S = core.CLI_TIMEOUT_S

HANDOFF_PROMPT = """Vou trocar você por um agent de outro kind neste mesmo pane. Antes disso,
escreva DOIS arquivos.

**1. O handoff, em `{path}`**, cobrindo:

- o que você estava fazendo e por quê
- decisões já tomadas (e o porquê, se não for óbvio)
- o que falta / próximo passo
- arquivos relevantes e qualquer coisa que quem assumir precise saber pra não
  repetir trabalho ou perder contexto

**2. Um teste de verificação, em `{verif_path}`** — este arquivo NÃO será lido
por quem assumir. Ele existe pra confirmar que a transferência funcionou, e a
sua vantagem aqui é única: você é o único que sabe ao mesmo tempo o que PÔS e o
que DEIXOU DE FORA do handoff.

Escreva exatamente neste formato, 5 perguntas de cada tipo:

```
## POSITIVAS
1. <pergunta cuja resposta está no handoff>
   GABARITO: <resposta esperada, curta>
...
## NEGATIVAS
1. <pergunta sobre algo REAL que você viveu nesta sessão e que NÃO entrou no handoff>
...
```

As POSITIVAS devem exigir entendimento, não busca de palavra-chave: prefira
"por que X foi descartado" a "o que é X". As NEGATIVAS são a parte que mais
importa — devem ser sobre trabalho que de fato aconteceu aqui, mas que você
deliberadamente não documentou. Elas testam se quem assume admite não saber ou
inventa uma resposta plausível. Num projeto de consequência, inventar com
confiança é pior que não saber.

Depois de escrever os dois arquivos, pare — não faça mais nada."""

RESUME_PROMPT = """Você está retomando de outro agent neste mesmo projeto. Leia {path} antes de
qualquer coisa — é o handoff de quem estava trabalhando aqui antes de você.

O handoff é um RESUMO, escrito por ele, e portanto incompleto por natureza.{historico}

Quando algo não estiver no handoff, diga que não está em vez de deduzir — e
consulte a fonte acima se precisar. Preencher lacuna com suposição plausível é
o modo de falha que mais custa aqui, porque soa competente."""

HISTORICO_NOTA = """ O histórico COMPLETO da sessão dele continua no disco, em:

  {path}

É grande e não deve ser lido inteiro; use como fonte pontual, buscando o que
precisar."""


api = core.api
get_agent = core.get_agent_info


def send_pane_keys(pane_id, *keys):
    """Confirma apenas diálogos de inicialização no pane provisório.

    ``pane send-keys`` é uma operação de controle que não emite JSON em todas
    as versões da CLI; não passe por ``core.api`` (que desserializa respostas
    JSON). Isto nunca é usado para entregar prompts, apenas para selecionar
    "Yes, I trust this folder" durante o bootstrap do novo CLI.
    """
    try:
        out = subprocess.run(
            core.herdr_argv("pane", "send-keys", pane_id, *keys),
            capture_output=True,
            text=True,
            timeout=CLI_TIMEOUT_S,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"pane send-keys {pane_id}: {exc}") from exc
    if out.returncode != 0:
        raise RuntimeError(
            f"pane send-keys {pane_id}: {out.stderr.strip() or out.stdout.strip()}"
        )


def _accept_trust_dialog(pane_id, pane_text):
    """Select the visibly highlighted trust option, without guessing its order."""
    def selection(text):
        lines = (text or "").splitlines()
        yes_index = no_index = selected_index = None
        for index, line in enumerate(lines):
            normalized = line.casefold()
            if "yes, i trust" in normalized or "sim, confio" in normalized:
                yes_index = index
            if "no, exit" in normalized or "não, sair" in normalized:
                no_index = index
            if re.search(r"(?:^|\s)[❯›>].*(?:yes|sim|no,|não,)", normalized):
                selected_index = index
        return yes_index, no_index, selected_index

    yes_index, no_index, selected_index = selection(pane_text)
    if yes_index is None or no_index is None or selected_index is None:
        return False
    if selected_index == yes_index:
        send_pane_keys(pane_id, "enter")
        return True
    if selected_index != no_index:
        return False
    delta = yes_index - selected_index
    key = "down" if delta > 0 else "up"
    send_pane_keys(pane_id, *([key] * abs(delta)))
    time.sleep(0.1)
    try:
        moved = subprocess.run(
            core.herdr_argv("pane", "read", pane_id, "--source", "visible", "--lines", "30"),
            capture_output=True, text=True, timeout=CLI_TIMEOUT_S,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    moved_yes, moved_no, moved_selected = selection(moved)
    if moved_yes is None or moved_no is None or moved_selected != moved_yes:
        return False
    send_pane_keys(pane_id, "enter")
    return True


# Ultima frase da instrucao de verificacao. Serve de marco pra separar o eco
# do prompt das respostas de verdade -- ver conta_recusas().
FIM_DA_INSTRUCAO = "em vez de deduzir"


def conta_recusas(out):
    """Quantas vezes o agent admitiu que algo nao esta no handoff.

    A leitura do pane inclui o ECO da instrucao que acabamos de mandar, e essa
    instrucao contem a frase literal "nao esta no handoff" -- contar no texto
    cru inflava o total em 1. Visto em dois swaps seguidos (2026-09-12): 6/5
    num caso, e 5/5 num caso cuja verdade era 4/5, o que mascarou uma
    confabulacao real (o agent respondeu uma negativa com material plausivel
    do proprio handoff em vez de recusar). So conta o que vem DEPOIS do ultimo
    eco; se o marco nao aparecer, conta tudo em vez de perder recusas.
    """
    corte = out.lower().rfind(FIM_DA_INSTRUCAO)
    resposta = out[corte:] if corte != -1 else out
    return len(re.findall(r"n[ao]{1,2}\s+est[aá]\s+no\s+handoff", resposta, re.I))


def respostas_verificacao_path(verif_path):
    """Return the durable transcript path for a verification run.

    ``.verificacao.md`` deliberately contains only the questions and positive
    answer key.  The agent's actual answers live in the terminal buffer, so
    they must be copied before a failed swap closes the provisional pane.
    """
    base, _ = os.path.splitext(verif_path)
    return base + ".respostas.md"


def persistir_respostas_verificacao(path, *, name, verif_path, status,
                                    admitiu, negativas, out):
    """Persist the raw verification transcript atomically before cleanup.

    A failed verification still carries useful evidence. Keeping it in the
    handoff directory makes the result inspectable after the provisional pane
    is closed, and avoids presenting a stale ``agent read`` command that points
    at a pane which no longer exists.
    """
    parent = os.path.dirname(os.path.abspath(path)) or "."
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(
        parent, f".{os.path.basename(path)}.{os.getpid()}.tmp"
    )
    texto = (
        "# Respostas da verificação de handoff\n\n"
        f"- agent: `{name}`\n"
        f"- perguntas: `{verif_path}`\n"
        f"- estado do dispatch: `{status}`\n"
        f"- negativas admitidas: `{admitiu}/{len(negativas)}`\n\n"
        "## Buffer capturado\n\n"
        "--- INÍCIO DO BUFFER ---\n"
        f"{out.rstrip()}\n"
        "--- FIM DO BUFFER ---\n"
    )
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(texto)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def dispatch_and_wait(name, prompt_text, timeout_s, expected_info=None,
                      check_composition=True, allow_working=False):
    """Manda o prompt e espera o agent assentar via `agent prompt --wait` —
    caso de 1 agent só do core.dispatch_and_wait_all (mesma mecânica usada
    pelo herdr-review-dispatch com N agentes concorrentes; ver docstring lá
    pro porquê de `agent wait` sozinho não servir e de `blocked` ficar fora
    do --until).

    Retorna (status, info): status em "idle"/"done"/"blocked"/"timeout"/
    "stalled"/"preflight_aborted"/"error"; info é o dict do agent quando
    disponível, senão uma mensagem (str) ou None.
    """
    try:
        result, info, _ = core.dispatch_and_wait_all(
            {name: prompt_text},
            timeout_s,
            expected_agents=({name: expected_info} if expected_info is not None else None),
            check_composition=check_composition,
            allow_working=allow_working,
        )
    except core.DispatchPreflightError as exc:
        return "preflight_aborted", exc.as_dict()
    return result[name], info[name]


def _identity_snapshot(info):
    """Identity fields that must remain stable across a swap transaction."""
    session = info.get("agent_session") or {}
    return {
        "agent": info.get("agent"),
        "pane_id": info.get("pane_id"),
        "workspace_id": info.get("workspace_id"),
        "tab_id": info.get("tab_id"),
        "cwd": info.get("cwd"),
        "foreground_cwd": info.get("foreground_cwd"),
        "agent_session": session.get("value") if isinstance(session, dict) else None,
        "revision": info.get("revision"),
        "state_change_seq": info.get("state_change_seq"),
    }


def _runtime_capture(name, info, timeout_s):
    """Capture the effective profile, actively confirming Claude with /status.

    Claude's initial banner can be stale after `/model`.  The status command is
    sent through the official Herdr agent channel (never pane send-text), and
    the resulting labelled pair is accepted only when it is visible in the
    refreshed pane.  Failure to obtain that pair is recorded as evidence and
    never replaced with a guessed default.
    """
    initial_identity = _identity_snapshot(info)
    evidence = {"profile_before": {}, "status_probe": {"attempted": False},
                "identity_before": initial_identity}
    try:
        profile = core._runtime_profile(name, info)
    except Exception as exc:  # profile is evidence; swap can still proceed
        profile = {"observed": False, "source": "unknown", "error": str(exc),
                   "kind": info.get("agent")}
    evidence["profile_before"] = profile
    refreshed = info
    if info.get("agent") != "claude":
        return profile, evidence, refreshed

    evidence["status_probe"] = {"attempted": True, "command": "/status"}
    try:
        headless_reviewer = name.endswith(("-rev-1", "-rev-2", "-scout"))
        status, wait_info = dispatch_and_wait(
            name, "/status", min(max(int(timeout_s), 1), 30),
            expected_info=info, check_composition=not headless_reviewer,
        )
        evidence["status_probe"]["status"] = status
        if isinstance(wait_info, dict):
            evidence["status_probe"]["settled"] = wait_info
        if status not in ("idle", "done"):
            evidence["status_probe"]["verified"] = False
            evidence["status_probe"]["reason"] = (
                f"a sonda terminou em estado não terminal: {status!r}"
            )
            failed = dict(profile)
            failed["observed"] = False
            failed["source"] = "probe_failed"
            return failed, evidence, refreshed
        refreshed = get_agent(name)
        refreshed_identity = _identity_snapshot(refreshed)
        identity_fields = ("agent", "pane_id", "workspace_id", "tab_id", "cwd",
                           "foreground_cwd", "agent_session", "revision")
        identity_changes = [
            f"{field}: {initial_identity.get(field)!r} -> {refreshed_identity.get(field)!r}"
            for field in identity_fields
            if initial_identity.get(field) is not None
            and initial_identity.get(field) != refreshed_identity.get(field)
        ]
        evidence["identity_after"] = refreshed_identity
        if identity_changes:
            evidence["status_probe"]["verified"] = False
            evidence["status_probe"]["reason"] = "; ".join(identity_changes)
            profile["observed"] = False
            profile["source"] = "identity_changed"
            return profile, evidence, refreshed
        confirmed = core._runtime_profile(name, refreshed, recent_lines=120)
        evidence["profile_after_status"] = confirmed
        if confirmed.get("source") == "status" and confirmed.get("observed"):
            return confirmed, evidence, refreshed
        evidence["status_probe"]["verified"] = False
        evidence["status_probe"]["reason"] = (
            "o /status não apresentou um par Model/Effort ancorado"
        )
        # A banner/argv reading is retained for diagnostics, but it cannot be
        # inherited automatically because the effective Claude selection is
        # unconfirmed.
        confirmed["observed"] = False
        confirmed["source"] = "unconfirmed"
        return confirmed, evidence, refreshed
    except Exception as exc:
        evidence["status_probe"]["verified"] = False
        evidence["status_probe"]["error"] = str(exc)
        failed = dict(profile)
        failed["observed"] = False
        failed["source"] = "probe_failed"
        return failed, evidence, refreshed


def _has_runtime_arg(args):
    """Whether the operator explicitly pinned model/effort in extra args."""
    for i, arg in enumerate(args):
        if arg in ("--model", "-m", "--effort") or arg.startswith(("--model=", "--effort=")):
            return True
        if arg in ("-c", "--config") and i + 1 < len(args):
            if str(args[i + 1]).startswith("model_reasoning_effort="):
                return True
        if str(arg).startswith(("-c=", "--config=", "model_reasoning_effort=")):
            return True
    return False


def _runtime_start_args(kind, profile, *, explicit=False):
    """Build explicit launch flags only for a compatible, observed profile."""
    if explicit or not profile.get("observed"):
        return []
    model = str(profile.get("model") or "").strip()
    effort = str(profile.get("reasoning_effort") or "").strip().casefold()
    if not model or effort in ("", "unknown"):
        return []
    canonical = core._canonical_runtime_model(model)
    source_kind = str(profile.get("kind") or "").casefold()
    if kind == "codex":
        # Codex accepts GPT/o-series identifiers. A Claude model cannot be
        # copied across families; leave target-role defaults in that case.
        if source_kind and source_kind != "codex":
            return []
        if not (canonical.startswith("gpt") or canonical.startswith("o")):
            return []
        result = ["--model", model]
        result += ["-c", f"model_reasoning_effort={effort}"]
        return result
    if kind == "claude":
        if source_kind and source_kind != "claude":
            return []
        if not (canonical.startswith("opus") or canonical.startswith("sonnet")
                or canonical.startswith("claude")):
            return []
        # Status renders friendly names (`Opus 5`, `Sonnet 5`); launch accepts
        # the stable aliases used by the bootstrap table.
        launch_model = {"opus5": "opus-5", "sonnet5": "sonnet-5"}.get(
            canonical, model
        )
        return ["--model", launch_model, "--effort", effort]
    return []


def _handoff_prompt(path, historico=""):
    return RESUME_PROMPT.format(path=path, historico=historico) + (
        "\n\nDepois de ler e entender o handoff, responda exatamente "
        "HERDR_HANDOFF_READ_OK. Não faça alterações nem execute tarefas nesta "
        "confirmação."
    )


def _handoff_acknowledged(name, timeout_s=30):
    """Find the exact acknowledgement after the resume prompt echo."""
    deadline = time.monotonic() + max(0.1, min(float(timeout_s), 30.0))
    token = "HERDR_HANDOFF_READ_OK"
    while True:
        try:
            out = subprocess.run(
                core.herdr_argv("agent", "read", name, "--source", "recent-unwrapped",
                                "--lines", "120"),
                capture_output=True, text=True, timeout=CLI_TIMEOUT_S,
            ).stdout
        except (OSError, subprocess.TimeoutExpired):
            out = ""
        for line in out.splitlines():
            stripped = line.strip()
            if stripped.startswith(("❯", "›")):
                continue
            stripped = re.sub(r"^[•●]\s*", "", stripped).strip()
            stripped = re.sub(r"^\[\d{1,2}:\d{2}:\d{2}\]\s*", "", stripped)
            if stripped == token:
                return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.25)


def _send_handoff_and_confirm(name, path, historico, timeout_s, expected_info):
    prompt = _handoff_prompt(path, historico)
    status, detail = dispatch_and_wait(
        name, prompt, timeout_s, expected_info=expected_info,
        check_composition=False,
    )
    if status not in ("idle", "done"):
        return False, {"status": status, "detail": detail}
    ack = _handoff_acknowledged(name, timeout_s=min(timeout_s, 30))
    return ack, {"status": status, "acknowledged": ack, "detail": detail}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("slug")
    ap.add_argument("role", help="sufixo do agent: exec, rev, rev-2, scout, ...")
    ap.add_argument("kind")
    ap.add_argument("extra_args", nargs="*", help="passados pro novo agent depois de --")
    ap.add_argument("--timeout", type=int, default=180, help="segundos pra esperar o handoff ser escrito")
    ap.add_argument("--sem-handoff", action="store_true",
                    help="troca sem pedir handoff ao agent que sai, usando o log da sessao "
                         "dele como unica fonte. Para quando ele NAO CONSEGUE responder -- "
                         "limite de uso esgotado, travado, sem credito. Perde o resumo; "
                         "o historico completo continua disponivel.")
    ap.add_argument("--local", action="store_true",
                    help="quando o agent que sai nao consegue escrever o handoff, gera o "
                         "resumo com uma LLM local (Ollama) a partir do log da sessao dele. "
                         "Fica entre o padrao (exige o LLM responder) e --sem-handoff (nao "
                         "resume nada). Aborta se o prompt truncar -- handoff truncado sai "
                         "fluente com identificadores inventados, que e' pior que nao ter.")
    ap.add_argument("--em-tab-novo", action="store_true",
                    help="sobe o substituto num TAB NOVO e PARA antes de fechar o antigo. "
                         "Os dois ficam vivos ate voce rodar --finalizar. Para quando o "
                         "agent trocado e' aquele com quem voce esta falando, ou quando o "
                         "split no tab atual estragaria o layout.")
    ap.add_argument("--handoff-pronto", metavar="ARQUIVO",
                    help="usa um handoff JA ESCRITO em vez de pedir um ao agent que sai. "
                         "Obrigatorio no auto-swap: o agent nao consegue responder a um "
                         "prompt enquanto esta bloqueado rodando este comando.")
    ap.add_argument("--forcar-fechamento", action="store_true",
                    help="no --finalizar, fecha mesmo com a heuristica de composicao "
                         "humana acusando. Use quando souber que e' falso positivo: "
                         "`pane close` DESCARTA um rascunho, nunca o submete.")
    ap.add_argument("--finalizar", action="store_true",
                    help="segunda fase de --em-tab-novo: fecha o antigo, promove o nome do "
                         "provisorio, traz o pane pro tab original e fecha o tab temporario.")
    ap.add_argument("--no-verify", action="store_true",
                    help="pula o teste de verificacao pos-swap (por padrao ele roda)")
    ap.add_argument("--dry-run", action="store_true",
                    help="percorre as checagens reais e imprime o plano; nao toca em nada")
    args = ap.parse_args()

    # Achado 2026-09-01: $HERDR_ENV vazio nao e mais suficiente pra recusar
    # sozinho -- ver core.require_herdr_pane() pro porque (sandbox de exec
    # do Codex esconde env vars HERDR_*, confirmado ao vivo).
    core.require_herdr_pane()

    name = f"{args.slug}-{args.role}"

    try:
        info = get_agent(name)
    except RuntimeError as exc:
        print(f"erro: agent '{name}' não encontrado ({exc})", file=sys.stderr)
        sys.exit(1)

    old_kind = info["agent"]
    pane_id = info["pane_id"]

    # Auto-swap: o alvo e' o agent DESTE pane. Muda o que os guards significam.
    auto = bool(os.environ.get("HERDR_PANE_ID")) and os.environ["HERDR_PANE_ID"] == pane_id

    # 'working' normalmente quer dizer "tem trabalho em andamento, nao mexe".
    # No auto-swap quer dizer "esta rodando ESTE comando" -- recusar por isso
    # recusaria o caso inteiro. 'blocked' continua barrando nos dois casos: e'
    # dialogo pendente de verdade, nao artefato da propria chamada.
    aceitos = ("idle", "done", "working") if auto else ("idle", "done")
    if info["agent_status"] not in aceitos:
        print(f"erro: '{name}' está '{info['agent_status']}' — não troco em cima de trabalho em andamento (working/blocked)", file=sys.stderr)
        sys.exit(1)
    cwd = info["cwd"]
    # project_root(), não o cwd cru do agent — achado P2-2 herdr-7: um cwd
    # registrado num subdiretório ou path vizinho ao repo (ex:
    # claude-bridge-exec com cwd=~/.claude-bridge vs repo em
    # ~/Devs/claude-bridge) faria este lock apontar pra um .herdr/ diferente
    # do que os outros consumidores (herdr-migrate-rev, herdr-review-dispatch,
    # herdr-ask) consultam, tornando a checagem cega justamente nesse caso.
    migration_cwd = core.project_root(cwd)

    gate_msg = migration.space_gate_message(migration_cwd, args.slug)
    if gate_msg is not None:
        print(f"erro: {gate_msg} (não troco kind durante isso)", file=sys.stderr)
        sys.exit(1)

    if auto:
        print(f"auto-swap detectado: {name} e' o agent deste pane ({pane_id}).")
        if not args.handoff_pronto:
            print(f"erro: auto-swap exige --handoff-pronto <arquivo>. Nao da pra pedir "
                  f"handoff a si mesmo: o `agent prompt --wait` esperaria uma resposta "
                  f"que so sairia depois deste processo terminar.", file=sys.stderr)
            sys.exit(1)
        if not args.em_tab_novo:
            print(f"erro: auto-swap exige --em-tab-novo. Sem isso o swap fecharia este "
                  f"pane no meio da execucao, matando o proprio processo que esta "
                  f"fazendo a troca.", file=sys.stderr)
            sys.exit(1)

    if args.kind == old_kind:
        print(f"aviso: '{name}' já é '{old_kind}' — trocando mesmo assim (contexto zera igual)", file=sys.stderr)

    # Rev-1, rev-2 e scout são panes headless: uma composição residual (até
    # uma letra digitada por engano) é descartável. A guarda de composição
    # humana continua valendo para exec e para qualquer papel interativo.
    headless_reviewer = args.role in {"rev-1", "rev-2", "scout"}
    busy, why = core.pane_looks_busy_with_human_input(
        pane_id, check_composition=not headless_reviewer
    )
    if busy and not auto:
        print(f"erro: {pane_id} parece ter composição humana ou diálogo pendente ({why}) — abortando antes de mandar qualquer coisa. Confira o pane na mão.", file=sys.stderr)
        sys.exit(1)

    handoff_dir = os.path.join(cwd, ".herdr", "handoff")
    os.makedirs(handoff_dir, exist_ok=True)

    if args.finalizar:
        # Segunda fase: nao pede handoff nem sobe nada, so consuma o que a
        # primeira deixou pendente.
        if auto:
            print("erro: --finalizar não pode rodar no pane antigo que este swap "
                  "precisa fechar; execute a segunda fase no pane sobrevivente.",
                  file=sys.stderr)
            sys.exit(1)
        finalizar(args, name, handoff_dir)
        return
    # Localizado AGORA, enquanto o agent antigo ainda vive: depois do close o
    # `agent get` nao devolve mais a sessao dele, e o caminho do log se perde.
    historico_anterior = sessao_anterior_path(info)

    carimbo = f"{args.slug}-{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
    handoff_path = os.path.join(handoff_dir, f"{carimbo}.md")
    # Fica FORA do handoff de proposito: se as perguntas negativas estivessem no
    # arquivo que o novo agent le, ele saberia de antemao o que "nao deveria
    # saber" e a verificacao perderia o sentido.
    verif_path = os.path.join(handoff_dir, f"{carimbo}.verificacao.md")

    if args.dry_run:
        # Tudo acima ja rodou de verdade: agent get, checagem de estado, gate de
        # migracao, e a heuristica de composicao humana no pane. O que segue e'
        # so a narrativa do que aconteceria -- nenhuma escrita, nenhum prompt.
        extras = " ".join(args.extra_args) or "(nenhum)"
        print(f"[dry-run] plano de swap: {name}  {old_kind} -> {args.kind}")
        print(f"  pane atual:   {pane_id}  (cwd {cwd})")
        print(f"  raiz p/ gate: {migration_cwd}")
        print(f"  args do novo: {extras}")
        print()
        print("  checagens que JA passaram (feitas de verdade agora):")
        exige = "idle/done/working (auto-swap)" if auto else "idle/done"
        print(f"    - '{name}' existe e esta '{info['agent_status']}' (exige {exige})")
        print(f"    - nenhuma migracao em andamento neste space")
        if auto:
            print(f"    - {pane_id} e' o pane DESTE processo: auto-swap")
            print(f"      (a heuristica de composicao humana nao se aplica -- o prompt")
            print(f"       que disparou o swap esta na tela e ela o leria como pendente)")
        else:
            print(f"    - {pane_id} nao aparenta composicao humana nem dialogo pendente")
        print()

        # A narrativa precisa refletir as FLAGS, nao o fluxo canonico. Um
        # dry-run que descreve passos diferentes dos que vao rodar e' pior que
        # nenhum: ele existe pra ser a ultima conferencia antes de algo
        # irreversivel, e mentir ali gasta exatamente a confianca que justifica
        # o comando. (Bug real: com --em-tab-novo e --handoff-pronto ele ainda
        # anunciava "dividir pane" e "PONTO DE NAO RETORNO".)
        print("  passos que SERIAM executados, em ordem:")
        n = 1
        if args.handoff_pronto:
            print(f"    {n}. usar o handoff JA ESCRITO em")
            print(f"       {os.path.abspath(args.handoff_pronto)}")
            v = os.path.splitext(os.path.abspath(args.handoff_pronto))[0] + ".verificacao.md"
            print(f"       verificacao: {v if os.path.isfile(v) else '(nenhuma ao lado — teste pulado)'}")
            print(f"       (nada e' pedido ao {old_kind}; ele nao e' interrompido)")
        elif args.local:
            print(f"    {n}. gerar o handoff com {local.MODELO} a partir do log da sessao")
            print(f"       (aborta se o prompt truncar; o processo antigo segue vivo)")
        else:
            print(f"    {n}. pedir handoff ao {old_kind} atual, escrito em")
            print(f"       {handoff_path}")
            print(f"       (aborta se nao assentar em {args.timeout}s, ficar blocked, ou sair vazio")
            print(f"        -- nos tres casos o processo antigo continua vivo e intacto)")
        n += 1
        if args.em_tab_novo:
            print(f"    {n}. criar um TAB NOVO no workspace {info['workspace_id']}")
            print(f"       (nao encosta no layout do tab {info['tab_id']})")
        else:
            print(f"    {n}. dividir um pane novo ao lado de {pane_id}")
        n += 1
        print(f"    {n}. subir '{args.kind}' nesse pane sob nome PROVISORIO")
        print(f"       (se nao subir: fecha so o pane provisorio; '{name}' segue vivo)")
        n += 1
        print(f"    {n}. confirmar que o novo respondeu")
        n += 1
        if args.em_tab_novo:
            print(f"    {n}. mandar o novo ler o handoff")
            n += 1
            print(f"    {n}. PARAR. Nada e' fechado. Os dois ficam vivos ate voce rodar:")
            print(f"       herdr-swap {args.slug} {args.role} {args.kind} --finalizar")
            print()
            print("  NENHUM passo desta fase e' destrutivo. O ponto de nao retorno")
            print(f"  (fechar {pane_id}) fica todo no --finalizar, que tambem promove o")
            print(f"  nome e traz o pane de volta pro tab {info['tab_id']}.")
            if auto:
                print()
                print("  Como e' auto-swap: esta conversa continua viva no tab atual ate")
                print("  o --finalizar. Voce pode comparar os dois antes de decidir.")
            return
        print(f"    {n}. PONTO DE NAO RETORNO: fechar {pane_id} (mata o {old_kind})")
        n += 1
        print(f"    {n}. renomear o provisorio para '{name}'")
        n += 1
        print(f"    {n}. mandar o novo ler o handoff")
        print()
        print("  o que se perde de verdade: a conversa acumulada do agent atual.")
        print("  o handoff e' um RESUMO escrito por ele, nao o historico -- e' lossy")
        print("  por desenho, porque mandar scrollback bruto entre CLIs diferentes e'")
        print("  pior. Para um -exec com sessao humana, isso significa que voce")
        print("  recomeca a conversa a partir do resumo.")
        return

    if args.handoff_pronto:
        if not os.path.isfile(args.handoff_pronto) or os.path.getsize(args.handoff_pronto) == 0:
            print(f"erro: {args.handoff_pronto} nao existe ou esta vazio.", file=sys.stderr)
            sys.exit(1)
        handoff_path = os.path.abspath(args.handoff_pronto)
        v = os.path.splitext(handoff_path)[0] + ".verificacao.md"
        if os.path.isfile(v):
            verif_path = v
            print(f"handoff pronto: {handoff_path} ({os.path.getsize(handoff_path)} bytes)")
            print(f"  verificacao:   {verif_path}")
        else:
            print(f"handoff pronto: {handoff_path} ({os.path.getsize(handoff_path)} bytes)")
            print(f"  sem arquivo de verificacao ao lado — o teste pos-swap sera pulado.")
            args.no_verify = True
    elif args.local:
        # Terceiro caminho: o agent nao responde, mas o log dele esta no disco e
        # uma LLM local pode resumi-lo sem custo de conta. Nao pede nada ao
        # agent que sai -- entao serve exatamente quando o padrao falha.
        if not historico_anterior:
            print(f"erro: --local le o log da sessao anterior, e nao consegui localiza-lo "
                  f"para {name} — abortando.", file=sys.stderr)
            sys.exit(1)
        print(f"--local: gerando handoff com {local.MODELO} a partir de {historico_anterior}")
        try:
            texto, met = local.gerar(historico_anterior, args.slug)
        except local.Truncou as exc:
            print(f"erro: {exc}", file=sys.stderr)
            print(f"  processo antigo mantido vivo. Alternativa: --sem-handoff "
                  f"(entrega o log cru ao sucessor, sem resumo).", file=sys.stderr)
            sys.exit(1)
        except local.LocalIndisponivel as exc:
            print(f"erro: LLM local indisponivel ({exc}) — processo antigo mantido vivo.",
                  file=sys.stderr)
            sys.exit(1)
        cabecalho = local.AVISO_CABECALHO.format(modelo=local.MODELO, log=historico_anterior)
        with open(handoff_path, "w", encoding="utf-8") as fh:
            fh.write(cabecalho + texto + "\n")
        print(f"  {met['msgs_usadas']}/{met['msgs_no_log']} msgs do log, "
              f"{met['prompt_eval_count']:,} tokens avaliados (teto {local.TETO_POR_REQUISICAO:,}), "
              f"{met['segundos']}s")
        print(f"handoff local escrito ({os.path.getsize(handoff_path)} bytes).")
        # Sem arquivo de verificacao: so quem viveu a sessao sabe o que deixou de
        # fora, e esse e' justamente quem nao esta disponivel. Fabricar negativas
        # a partir do log testaria o log, nao a transferencia.
        args.no_verify = True
    elif args.sem_handoff:
        # O swap existe pra aliviar limite de uso, mas pedir handoff DEPENDE do
        # agent no limite conseguir responder -- se a conta dele zerou, ele nao
        # escreve nada e o swap aborta justamente quando e' mais necessario.
        # Achado do usuario 2026-09-12.
        #
        # O log da sessao sobrevive a isso: esta no disco, nao depende de a LLM
        # responder. Entao da pra trocar mesmo com o agent mudo, contanto que o
        # sucessor receba o caminho do historico como fonte.
        if not historico_anterior:
            print(f"erro: --sem-handoff exige o log da sessao anterior como fonte, e nao "
                  f"consegui localiza-lo para {name}. Sem handoff E sem historico, a troca "
                  f"perderia o contexto por inteiro — abortando.", file=sys.stderr)
            sys.exit(1)
        print(f"--sem-handoff: nao vou pedir nada ao {old_kind} (pode estar esgotado/travado).")
        print(f"  fonte para o sucessor: {historico_anterior}")
        handoff_path = historico_anterior
    else:
        print(f"pedindo handoff pro {name} atual ({old_kind}) em {handoff_path}")
        status, wait_info = dispatch_and_wait(
            name,
            HANDOFF_PROMPT.format(path=handoff_path, verif_path=verif_path),
            args.timeout,
            expected_info=info,
            # No auto-swap human composition guard: the prompt that launched
            # this process is intentionally visible in the current pane.
            check_composition=(not auto and not headless_reviewer),
            allow_working=auto,
        )

        if status == "timeout":
            print(f"erro: {name} não assentou em {args.timeout}s escrevendo o handoff — abortando, processo antigo mantido vivo", file=sys.stderr)
            dica_sem_handoff(historico_anterior)
            sys.exit(1)
        if status == "blocked":
            print(f"erro: {name} ficou 'blocked' escrevendo o handoff — veja o pane {pane_id} antes de tentar de novo. Processo antigo mantido vivo.", file=sys.stderr)
            sys.exit(1)
        if status == "stalled":
            print(f"erro: {name} não mostrou nenhuma mudança de estado nos primeiros 5s após o prompt ({wait_info}) — pane pode estar travado. Processo antigo mantido vivo.", file=sys.stderr)
            dica_sem_handoff(historico_anterior)
            sys.exit(1)
        if status == "error":
            print(f"erro esperando {name} assentar: {wait_info}. Processo antigo mantido vivo.", file=sys.stderr)
            dica_sem_handoff(historico_anterior)
            sys.exit(1)
        if status == "preflight_aborted":
            print(f"erro: preflight de {name} mudou antes do handoff; processo antigo mantido vivo ({wait_info})", file=sys.stderr)
            sys.exit(1)
        if not os.path.isfile(handoff_path) or os.path.getsize(handoff_path) == 0:
            print(f"erro: {name} assentou mas não escreveu {handoff_path} (ou ficou vazio) — abortando, processo antigo mantido vivo", file=sys.stderr)
            sys.exit(1)

        print(f"handoff escrito ({os.path.getsize(handoff_path)} bytes).")

    # Capture the effective runtime only after the handoff has settled.  For
    # Claude this actively asks `/status`: the startup banner is allowed as a
    # diagnostic fallback, never as the profile inherited by a replacement.
    try:
        info = get_agent(name)
    except RuntimeError as exc:
        print(f"erro: não consegui revalidar '{name}' antes de criar o substituto: {exc}",
              file=sys.stderr)
        sys.exit(1)
    profile_before, profile_evidence, info = _runtime_capture(
        name, info, args.timeout
    )
    if info.get("pane_id") != pane_id or profile_before.get("source") == "identity_changed":
        print(f"erro: o pane de '{name}' mudou durante a captura do perfil; swap abortado.",
              file=sys.stderr)
        sys.exit(1)
    if profile_before.get("source") == "status":
        print(f"perfil efetivo confirmado via /status: "
              f"{profile_before.get('model')} / {profile_before.get('reasoning_effort')}")
    elif old_kind == "claude":
        print("aviso: Claude não confirmou o par atual via /status; "
              "não vou herdar o cabeçalho inicial nem um default global.", file=sys.stderr)
    else:
        print(f"perfil observado: {profile_before.get('model', '?')} / "
              f"{profile_before.get('reasoning_effort', '?')} "
              f"({profile_before.get('source', 'unknown')})")

    # Sobe o novo kind sob nome PROVISÓRIO antes de tocar no antigo — até o
    # `pane close` do antigo (mais abaixo), tudo aqui é reversível: se o novo
    # não subir, só se fecha o pane novo e o exec antigo continua vivo,
    # intacto, como se nada tivesse acontecido. Isso elimina a categoria de
    # "antigo morto, novo não subiu" que existia quando o close vinha antes
    # do start (achado em herdr-6, ambos os revisores independentemente).
    # Nome provisório curto e descartável, independente do comprimento de
    # `name` — achado real (2026-08-30, migração rev->rev-1): `f"{name}-new"`
    # estourou o limite de 32 chars do `agent start` já com slugs de
    # tamanho comum (`content-insights-collector-exec-new` = 35 chars). O
    # nome final (pós-rename) não tem esse limite, só o `agent start` do
    # provisório.
    temp_name = "tmp" + hashlib.sha1(f"{name}{time.time()}".encode()).hexdigest()[:10]

    tab_temp = None
    try:
        if args.em_tab_novo:
            # Tab novo em vez de split: nao encosta no layout do tab atual, e o
            # antigo continua inteiro na tela pra voce comparar os dois.
            print(f"criando tab novo no workspace {info['workspace_id']}...")
            t = api("tab", "create", "--workspace", info["workspace_id"],
                    "--cwd", cwd, "--label", f"swap {name}")
            tab_temp = t["tab"]["tab_id"]
            # `pane list` filtra por --workspace, nao por --tab (tentei; devolve
            # "unknown option"). Cada pane traz o proprio tab_id, entao o filtro
            # e' nosso.
            panes = [q for q in api("pane", "list", "--workspace",
                                    info["workspace_id"])["panes"]
                     if q.get("tab_id") == tab_temp]
            if not panes:
                raise RuntimeError(f"tab {tab_temp} nasceu sem pane")
            new_pane_id = panes[0]["pane_id"]
            print(f"  tab {tab_temp}, pane {new_pane_id}")
        else:
            print(f"dividindo pane novo ao lado de {pane_id}...")
            split = api("pane", "split", pane_id, "--direction", "right", "--no-focus")
            new_pane_id = split["pane"]["pane_id"]
    except RuntimeError as exc:
        print(f"erro criando o pane do substituto: {exc}", file=sys.stderr)
        print(f"processo antigo em {pane_id} não foi tocado. Handoff salvo em {handoff_path}.", file=sys.stderr)
        if tab_temp:
            try:
                api("tab", "close", tab_temp)
            except RuntimeError:
                pass
        sys.exit(1)

    full_extra = list(args.extra_args)
    inherited_extra = _runtime_start_args(
        args.kind, profile_before,
        explicit=_has_runtime_arg(full_extra),
    )
    if inherited_extra:
        full_extra = inherited_extra + full_extra
        print("herdando perfil observado no novo processo: " + " ".join(inherited_extra))
    elif profile_before.get("observed") and args.kind != old_kind:
        print("aviso: perfil observado não é compatível com a família do novo CLI; "
              "mantendo somente os argumentos explícitos do destino.", file=sys.stderr)
    if args.kind == "codex":
        # desliga o sistema nativo de sub-agentes do Codex - ver
        # core.CODEX_NO_NATIVE_AGENTS pro porque (achado real, omabackup-exec
        # 2026-08-29 usou isso como atalho pra "revisao independente" em vez
        # de voltar pro herdr-review)
        full_extra += core.CODEX_NO_NATIVE_AGENTS

    print(f"subindo '{temp_name}' (provisório) como '{args.kind}' no pane novo ({new_pane_id})...")
    start_args = ["agent", "start", temp_name, "--kind", args.kind, "--pane", new_pane_id]
    if full_extra:
        start_args += ["--", *full_extra]

    last_exc = None
    for attempt in range(6):  # pane recém-dividido pode levar um instante pra assentar no shell
        try:
            api(*start_args)
            last_exc = None
            break
        except RuntimeError as exc:
            last_exc = exc
            if "agent_pane_busy" in str(exc) and attempt < 5:
                time.sleep(1)
                continue
            break

    if last_exc is not None and "agent_not_ready" in str(last_exc):
        # nome/processo existem, so travou num dialogo de startup (ex: confiar
        # no diretorio) OU e' so ruido de MCP subindo, que se resolve sozinho
        # em poucos segundos (visto empiricamente) - nesse meio-tempo o status
        # normalmente e' 'working', nao 'idle'. Aceita qualquer um dos dois
        # como "resolveu sozinho".
        try:
            time.sleep(4)
            if get_agent(temp_name)["agent_status"] in ("idle", "working", "done"):
                last_exc = None
        except RuntimeError as exc:
            last_exc = exc

    if last_exc is not None and "agent_not_ready" in str(last_exc):
        # ainda nao resolveu sozinho - reconhece o padrao do dialogo antes de
        # responder, nao aprova as cegas.
        try:
            pane_text = subprocess.run(
                core.herdr_argv("pane", "read", new_pane_id, "--source", "visible", "--lines", "30"),
                capture_output=True, text=True, timeout=CLI_TIMEOUT_S,
            ).stdout
            trust_markers = ("Do you trust", "confia", "trust the contents", "Yes, I trust")
            if any(m.lower() in pane_text.lower() for m in trust_markers):
                print(f"'{temp_name}' parou num diálogo de confiança de diretório (1a vez desse kind aqui) — aprovando...")
                # Enquanto o diálogo de confiança está aberto o registro do
                # agent provisório ainda pode não existir; o pane_id já é
                # estável. Envie somente a confirmação do diálogo pelo
                # controle do pane, sem usar isso como canal de comunicação.
                # Só confirma quando a TUI mostra explicitamente qual opção
                # está selecionada. A ordem inicial varia entre versões de
                # Claude/Codex; nunca assuma que `down` significa confiar.
                if _accept_trust_dialog(new_pane_id, pane_text):
                    time.sleep(2)
                    if get_agent(temp_name)["agent_status"] in ("idle", "working", "done"):
                        last_exc = None
                else:
                    print("diálogo de confiança reconhecido, mas a opção "
                          "selecionada não pôde ser identificada; não vou "
                          "pressionar teclas às cegas.", file=sys.stderr)
            if last_exc is not None:
                print(f"'{temp_name}' ficou bloqueado num diálogo que não reconheço — veja o pane {new_pane_id} na mão:", file=sys.stderr)
                print(pane_text[-800:], file=sys.stderr)
        except (RuntimeError, subprocess.TimeoutExpired) as exc:
            print(f"erro checando/respondendo o diálogo: {exc}", file=sys.stderr)

    if last_exc is not None:
        print(f"erro ao subir o novo agent: {last_exc}", file=sys.stderr)
        print(f"'{name}' (antigo, {old_kind}) NÃO foi tocado — continua vivo em {pane_id}, com contexto intacto.", file=sys.stderr)
        try:
            api("pane", "close", new_pane_id)
            print(f"pane provisório {new_pane_id} fechado. Handoff salvo em {handoff_path} pra tentar de novo depois.", file=sys.stderr)
        except RuntimeError as exc2:
            print(f"pane provisório {new_pane_id} ficou pra trás sem fechar ({exc2}) — feche na mão se quiser. O antigo continua sendo o '{name}' válido.", file=sys.stderr)
        sys.exit(1)

    try:
        temp_info = get_agent(temp_name)
    except RuntimeError as exc:
        print(f"erro: não consegui observar o substituto '{temp_name}': {exc}",
              file=sys.stderr)
        try:
            api("pane", "close", new_pane_id)
        except RuntimeError:
            pass
        sys.exit(1)

    ok_handoff, handoff_evidence = _send_handoff_and_confirm(
        temp_name, handoff_path,
        (HISTORICO_NOTA.format(path=historico_anterior)
         if historico_anterior else ""),
        args.timeout, temp_info,
    )
    if not ok_handoff:
        print(f"erro: o substituto não confirmou a leitura do handoff; "
              f"mantendo '{name}' vivo e fechando apenas o provisório.",
              file=sys.stderr)
        print(f"  evidência: {handoff_evidence}", file=sys.stderr)
        try:
            api("pane", "close", new_pane_id)
        except RuntimeError as exc:
            print(f"aviso: não consegui fechar o provisório {new_pane_id}: {exc}",
                  file=sys.stderr)
        if tab_temp:
            try:
                api("tab", "close", tab_temp)
            except RuntimeError:
                pass
        sys.exit(1)

    try:
        temp_info = get_agent(temp_name)
        profile_after = core._runtime_profile(temp_name, temp_info)
    except Exception as exc:
        profile_after = {"observed": False, "source": "unknown", "error": str(exc)}
    runtime_comparison = core._assert_runtime_preserved(
        temp_name, profile_before, profile_after
    )
    if profile_before.get("observed") and not runtime_comparison.get("preserved"):
        print("aviso: o perfil observado no substituto diverge ou ficou "
              "desconhecido; registrando a evidência sem bloquear o swap.",
              file=sys.stderr)

    pending_state = {
            "name": name, "temp_name": temp_name,
            "old_pane_id": pane_id, "new_pane_id": new_pane_id,
            "tab_original": info["tab_id"], "tab_temp": tab_temp,
            "handoff": handoff_path, "verificacao": verif_path,
            "verification_required": bool(
                not args.no_verify and os.path.isfile(verif_path)
            ),
            "handoff_acknowledged": True,
            "old_identity": _identity_snapshot(info),
            "new_identity": _identity_snapshot(temp_info),
            "runtime": {
                "before": profile_before,
                "after": profile_after,
                "comparison": runtime_comparison,
                "capture": profile_evidence,
                "requested_args": inherited_extra,
            },
            "no_verify": bool(args.no_verify),
            "criado_em": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    }
    if args.em_tab_novo:
        # PARA AQUI. Nada destrutivo ocorre antes da confirmação explícita.
        grava_swap_state(swap_state_path(handoff_dir, name), pending_state)
        print()
        print(f"PAROU ANTES DE FECHAR. Os dois estao vivos:")
        print(f"  antigo  {name:24s} {pane_id}  ({old_kind})")
        print(f"  novo    {temp_name:24s} {new_pane_id}  ({args.kind}, tab {tab_temp})")
        print()
        print(f"O novo ja leu {handoff_path}.")
        print(f"Converse com ele, compare, e quando estiver satisfeito:")
        print()
        print(f"  herdr-swap {args.slug} {args.role} {args.kind} --finalizar")
        print()
        print(f"Isso fecha o antigo, promove o nome e traz o pane pro tab {info['tab_id']}.")
        print(f"Pra desistir: herdr pane close {new_pane_id} && herdr tab close {tab_temp}")
        print(f"  (e apague {swap_state_path(handoff_dir, name)})")
        return

    # O handoff foi confirmado enquanto os dois panes ainda estavam vivos.
    # Execute a verificação antes do ponto de não-retorno; se ela falhar, o
    # pane antigo permanece disponível para nova tentativa.
    if not args.no_verify and os.path.isfile(verif_path):
        verification = rodar_verificacao(temp_name, verif_path, handoff_path,
                                          args.timeout, historico_anterior)
        if verification is False:
            print("erro: a verificação do handoff não passou; antigo preservado e "
                  "provisório fechado. Respostas preservadas em "
                  f"{respostas_verificacao_path(verif_path)}.", file=sys.stderr)
            try:
                api("pane", "close", new_pane_id)
            except RuntimeError:
                pass
            if tab_temp:
                try:
                    api("tab", "close", tab_temp)
                except RuntimeError:
                    pass
            sys.exit(1)
        if verification is None:
            print("aviso: a verificação não produziu uma conclusão; mantendo o "
                  "handoff confirmado e seguindo sem descartar o provisório.",
                  file=sys.stderr)

    # A verificação pode demorar e o antigo pode receber trabalho nesse
    # intervalo. Reobserve identidade, lifecycle e diálogos no instante em que
    # o close se torna irreversível.
    try:
        old_final = get_agent(name)
        new_final = get_agent(temp_name)
    except RuntimeError as exc:
        print(f"erro: identidade não pôde ser confirmada imediatamente antes do "
              f"close ({exc}); nenhum pane será fechado.", file=sys.stderr)
        sys.exit(1)
    old_snapshot = _identity_snapshot(old_final)
    new_snapshot = _identity_snapshot(new_final)
    for label, expected, observed in (
        ("antigo", _identity_snapshot(info), old_snapshot),
        ("substituto", _identity_snapshot(temp_info), new_snapshot),
    ):
        fields = ("agent", "pane_id", "workspace_id", "tab_id", "cwd",
                  "foreground_cwd", "agent_session", "revision")
        if label == "antigo":
            fields += ("state_change_seq",)
        changed = [k for k in fields
                   if expected.get(k) is not None and expected.get(k) != observed.get(k)]
        if changed:
            print(f"erro: identidade do {label} mudou na última checagem; "
                  "abortando sem fechar panes.", file=sys.stderr)
            sys.exit(1)
    if old_final.get("agent_status") not in ("idle", "done"):
        print("erro: o antigo voltou a trabalhar antes do close "
              f"({old_final.get('agent_status')!r}); nenhum pane será fechado.",
              file=sys.stderr)
        sys.exit(1)
    headless_reviewer = args.role in {"rev-1", "rev-2", "scout"}
    busy, why = core.pane_looks_busy_with_human_input(
        old_final.get("pane_id", pane_id), check_composition=not headless_reviewer
    )
    if busy and not args.forcar_fechamento:
        print(f"erro: o antigo tem diálogo ou texto humano pendente antes do "
              f"close: {why}; nenhum pane será fechado.", file=sys.stderr)
        sys.exit(1)

    # Ponto de não-retorno de verdade: só a partir daqui o antigo é encerrado.
    # Tudo antes disso era reversível.
    print(f"'{temp_name}' subiu e respondeu — fechando o antigo ({pane_id}, {old_kind}) e promovendo o nome...")
    try:
        api("pane", "close", pane_id)
    except RuntimeError as exc:
        print(f"erro fechando o pane antigo: {exc}", file=sys.stderr)
        print(f"'{temp_name}' está vivo em {new_pane_id} mas o antigo '{name}' em {pane_id} também pode continuar vivo — confira os dois na mão antes de renomear.", file=sys.stderr)
        sys.exit(1)

    try:
        api("agent", "rename", new_pane_id, name)
    except RuntimeError as exc:
        print(f"erro renomeando '{temp_name}' -> '{name}': {exc}", file=sys.stderr)
        print(f"o novo agent está vivo em {new_pane_id}, só que com o nome '{temp_name}' em vez de '{name}'. Renomeie na mão: herdr agent rename {new_pane_id} {name}", file=sys.stderr)
        print(f"handoff: {handoff_path}", file=sys.stderr)
        sys.exit(1)

    print(f"'{name}' trocado: {old_kind} -> {args.kind}. Handoff confirmado antes do close.")
    print(f"handoff: {handoff_path}")

    if args.no_verify:
        print(f"verificacao pulada (--no-verify). Teste manual: {verif_path}")
        return
    if not os.path.isfile(verif_path):
        print(f"aviso: {os.path.basename(verif_path)} nao foi escrito pelo agent que saiu — "
              f"swap concluido, mas sem teste de verificacao.", file=sys.stderr)
        return

    # A verificação já foi executada antes do close. Esta linha fica apenas
    # como marcador de compatibilidade para logs antigos; não reenvia prompt.
    print(f"verificação concluída antes da promoção: {verif_path}")


# --- swap em duas fases (--em-tab-novo / --finalizar) ---------------------
#
# O swap normal fecha o agent antigo assim que o novo responde. Isso e' certo
# quando ninguem esta conversando com o antigo: o handoff ja esta em disco e
# manter dois vivos com o mesmo papel so confunde.
#
# Existe um caso em que e' errado, e foi o usuario que apontou: quando o agent
# trocado e' justamente aquele com quem ele esta falando. Ai o "ponto de nao
# retorno" cai no meio de uma conversa viva, e nao ha como conferir se o
# substituto realmente pegou o contexto ANTES de perder o original.
#
# Segundo motivo, menor mas real: o split acontece no tab atual. Nos spaces com
# layout canonico (exec | rev-1 / rev-2) isso adiciona e remove um pane no
# mesmo tab, e ja quebrou o layout tres vezes nesta maquina.
#
# As duas fases resolvem os dois: o substituto nasce num TAB NOVO (nao encosta
# no layout) e o antigo so morre num comando separado, depois de voce ver os
# dois lado a lado.

def swap_state_path(handoff_dir, name):
    return os.path.join(handoff_dir, f".swap-pendente-{name}.json")


def grava_swap_state(path, dados):
    import json as _json
    parent = os.path.dirname(os.path.abspath(path)) or "."
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(parent, f".{os.path.basename(path)}.{os.getpid()}.tmp")
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            _json.dump(dados, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def le_swap_state(path):
    import json as _json
    try:
        with open(path, encoding="utf-8") as fh:
            return _json.load(fh)
    except (OSError, ValueError):
        return None


def finalizar(args, name, handoff_dir):
    """Segunda fase transacional: verifica os dois panes e só então promove."""
    st_path = swap_state_path(handoff_dir, name)
    st = le_swap_state(st_path)
    if not st:
        print(f"erro: nao ha swap pendente para '{name}' (procurei em {st_path}).",
              file=sys.stderr)
        sys.exit(1)

    temp_name = st["temp_name"]
    old_pane = st["old_pane_id"]
    novo_pane = st["new_pane_id"]
    tab_alvo = st["tab_original"]
    tab_temp = st["tab_temp"]

    try:
        prov = get_agent(temp_name)
    except RuntimeError:
        print(f"erro: o provisorio '{temp_name}' nao existe mais. O antigo segue vivo; "
              f"apague {st_path} e recomece.", file=sys.stderr)
        sys.exit(1)
    if prov.get("agent_status") == "blocked":
        print(f"erro: '{temp_name}' esta 'blocked' — resolva antes de finalizar.",
              file=sys.stderr)
        sys.exit(1)

    # Nunca permita que a segunda fase mate o próprio pane que a executa.
    if os.environ.get("HERDR_PANE_ID") == old_pane:
        print("erro: o pane atual é o antigo do swap; --finalizar precisa ser "
              "executado no pane sobrevivente.", file=sys.stderr)
        sys.exit(1)

    # A primeira fase guarda as identidades. Revalidar imediatamente antes de
    # qualquer close evita promover um processo que mudou de sessão/pane,
    # workspace ou projeto enquanto o operador comparava os dois.
    expected_old = st.get("old_identity")
    expected_new = st.get("new_identity")
    try:
        old_info = get_agent(name)
    except RuntimeError as exc:
        print(f"erro: não consegui revalidar o antigo '{name}': {exc}; "
              "nenhum pane será fechado.", file=sys.stderr)
        sys.exit(1)
    if expected_old:
        old_now = _identity_snapshot(old_info)
        old_diffs = [
            f"{key}: {expected_old.get(key)!r} -> {old_now.get(key)!r}"
            for key in ("agent", "pane_id", "workspace_id", "tab_id", "cwd",
                        "foreground_cwd", "agent_session", "revision",
                        "state_change_seq")
            if expected_old.get(key) is not None
            and expected_old.get(key) != old_now.get(key)
        ]
        if old_diffs:
            print("erro: identidade do antigo mudou desde a fase 1; "
                  "preservando os dois panes: " + "; ".join(old_diffs),
                  file=sys.stderr)
            sys.exit(1)
    if expected_new:
        new_now = _identity_snapshot(prov)
        new_diffs = [
            f"{key}: {expected_new.get(key)!r} -> {new_now.get(key)!r}"
            for key in ("agent", "pane_id", "workspace_id", "tab_id", "cwd",
                        "foreground_cwd", "agent_session", "revision")
            if expected_new.get(key) is not None
            and expected_new.get(key) != new_now.get(key)
        ]
        if new_diffs:
            print("erro: identidade do substituto mudou desde a fase 1; "
                  "preservando os dois panes: " + "; ".join(new_diffs),
                  file=sys.stderr)
            sys.exit(1)

    # Dialogues reais continuam sendo bloqueio. Para papéis headless, texto
    # residual de composição é ignorado explicitamente.

    # Ultima leitura do pane antigo antes de matar. Nao prova que esta seguro
    # (o humano pode digitar entre a leitura e o close), mas pular isso foi
    # exatamente como um dos dois incidentes de 2026-08 aconteceu.
    # DESEMPACOTAR. A funcao devolve (suspeito, motivo) -- uma tupla de dois
    # elementos e' SEMPRE verdadeira, inclusive (False, None), entao usa-la
    # direto num `if` recusava todo swap incondicionalmente. O --finalizar nunca
    # conseguiu rodar ate isto ser corrigido, e o pior e' que a mensagem culpava
    # o pane por uma condicao que nunca chegou a ser avaliada.
    headless_reviewer = getattr(args, "role", "") in {"rev-1", "rev-2", "scout"}
    if headless_reviewer:
        busy, why = core.pane_looks_busy_with_human_input(
            old_pane, check_composition=False
        )
    else:
        busy, why = core.pane_looks_busy_with_human_input(old_pane)
    if busy and not args.forcar_fechamento:
        print(f"erro: {old_pane} aparenta ter texto humano nao enviado ou dialogo "
              f"pendente: {why}", file=sys.stderr)
        print(f"  Nao vou fechar. Resolva no pane e rode --finalizar de novo, ou passe "
              f"--forcar-fechamento se souber que e' falso positivo.", file=sys.stderr)
        print(f"  (fechar DESCARTA um rascunho nao enviado; nunca o submete -- por isso"
              f" isto e' um aviso forte e nao uma parede.)", file=sys.stderr)
        sys.exit(1)
    if busy:
        print(f"aviso: --forcar-fechamento passado por cima de: {why}")

    # A verificação de transferência precisa ocorrer enquanto o antigo ainda
    # está vivo. Rodadas antigas sem arquivo de teste permanecem compatíveis;
    # uma fase nova registra verification_required e falha fechada quando o
    # teste foi solicitado mas não pôde ser executado.
    if st.get("verification_required"):
        verif_path = st.get("verificacao")
        if not verif_path or not os.path.isfile(verif_path):
            print("erro: verificação pendente não está disponível; nenhum pane "
                  "será fechado.", file=sys.stderr)
            sys.exit(1)
        verification = rodar_verificacao(
            temp_name, verif_path, st.get("handoff", verif_path),
            getattr(args, "timeout", 180), None,
        )
        if verification is False:
            print("erro: a verificação do handoff não passou; os dois panes "
                  "continuam vivos. Respostas preservadas em "
                  f"{respostas_verificacao_path(verif_path)}.", file=sys.stderr)
            sys.exit(1)
        if verification is None:
            print("aviso: a verificação não produziu uma conclusão; seguindo "
                  "com o handoff já confirmado.", file=sys.stderr)

    # Uma última leitura, depois da verificação, fecha a janela entre a guarda
    # de identidade e o close. A comparação ignora apenas lifecycle/status:
    # o novo pode ter assentado durante a prova; sessão/pane/projeto não podem.
    try:
        old_final = get_agent(name)
        new_final = get_agent(temp_name)
    except RuntimeError as exc:
        print(f"erro: identidade não pôde ser confirmada imediatamente antes do "
              f"close ({exc}); nenhum pane será fechado.", file=sys.stderr)
        sys.exit(1)
    if expected_old:
        d = _identity_snapshot(old_final)
        changed = [k for k in ("agent", "pane_id", "workspace_id", "tab_id", "cwd",
                               "foreground_cwd", "agent_session", "revision",
                               "state_change_seq")
                   if expected_old.get(k) is not None and expected_old.get(k) != d.get(k)]
        if changed:
            print("erro: identidade do antigo mudou na última checagem; abortando.",
                  file=sys.stderr)
            sys.exit(1)
    if expected_new:
        d = _identity_snapshot(new_final)
        changed = [k for k in ("agent", "pane_id", "workspace_id", "tab_id", "cwd",
                               "foreground_cwd", "agent_session")
                   if expected_new.get(k) is not None and expected_new.get(k) != d.get(k)]
        if changed:
            print("erro: identidade do substituto mudou na última checagem; abortando.",
                  file=sys.stderr)
            sys.exit(1)

    if old_final.get("agent_status") not in ("idle", "done"):
        print("erro: o antigo voltou a trabalhar antes do close "
              f"({old_final.get('agent_status')!r}); nenhum pane será fechado.",
              file=sys.stderr)
        sys.exit(1)
    headless_reviewer = getattr(args, "role", "") in {"rev-1", "rev-2", "scout"}
    busy, why = core.pane_looks_busy_with_human_input(
        old_final.get("pane_id", old_pane), check_composition=not headless_reviewer
    )
    if busy and not args.forcar_fechamento:
        print(f"erro: o antigo tem diálogo ou texto humano pendente antes do "
              f"close: {why}; nenhum pane será fechado.", file=sys.stderr)
        sys.exit(1)

    print(f"fechando o antigo ({old_pane}) e promovendo '{temp_name}' -> '{name}'...")
    api("pane", "close", old_pane)
    time.sleep(1)
    api("agent", "rename", temp_name, name)

    # Traz o pane de volta pro tab original. Se falhar, NAO e' fatal: o agent
    # ja e' o certo, com o nome certo -- so esta no tab errado. O fix-layout
    # exige o trio no mesmo tab, entao o retorno precisa acontecer antes dele.
    try:
        print(f"trazendo {novo_pane} de volta pro tab {tab_alvo}...")
        movido = api("pane", "move", novo_pane, "--tab", tab_alvo, "--split", "right")
    except RuntimeError as exc:
        print(f"aviso: nao consegui mover o pane de volta ({exc}). O agent esta certo e "
              f"vivo em {novo_pane}, tab {tab_temp} — rode "
              f"herdr pane move {novo_pane} --tab {tab_alvo} --split right; "
              f"depois rode bin/herdr-fix-layout.",
              file=sys.stderr)
    else:
        # Mover o ultimo pane ja fecha o tab de origem; fechar de novo daria
        # um erro de tab inexistente mesmo com o retorno concluido.
        if movido.get("move_result", {}).get("closed_tab_id") != tab_temp:
            try:
                api("tab", "close", tab_temp)
            except RuntimeError as exc:
                print(f"aviso: pane {novo_pane} ja esta no tab {tab_alvo}, mas nao "
                      f"consegui fechar o tab temporario {tab_temp} ({exc}).",
                      file=sys.stderr)

    try:
        os.unlink(st_path)
    except OSError:
        pass
    print(f"'{name}' finalizado. Layout: bin/herdr-fix-layout confere.")


def dica_sem_handoff(historico):
    """Quando o agent nao responde, a causa mais provavel e' a mesma que motivou
    o swap: a conta dele acabou. Abortar em silencio deixa o usuario preso --
    entao a mensagem de erro aponta a saida, que so existe porque o log da sessao
    nao depende de a LLM responder (achado do usuario 2026-09-12)."""
    if historico:
        print("  Se ele NAO CONSEGUE responder (limite de uso esgotado, travado, sem "
              "credito), rode de novo com --sem-handoff: troca usando o log da sessao "
              "dele como fonte, em vez do resumo.", file=sys.stderr)
        print(f"  log: {historico}", file=sys.stderr)
    else:
        print("  --sem-handoff nao ajudaria aqui: nao localizei o log da sessao dele.",
              file=sys.stderr)


def sessao_anterior_path(info):
    """Onde vive o historico COMPLETO do agent que saiu.

    O handoff e' um resumo -- lossy por desenho. O log da sessao anterior
    continua no disco depois do swap, entao o novo agent tem como consultar a
    fonte quando o resumo nao bastar. Passar esse caminho adiante e' a diferenca
    entre um handoff que e' tudo que sobrou e um handoff que e' so o atalho."""
    sess = (info.get("agent_session") or {}).get("value")
    if not sess:
        return None
    kind = info.get("agent")
    raizes = {
        "claude": os.path.join(os.path.expanduser("~"), ".claude", "projects"),
        "codex": os.path.join(os.path.expanduser("~"), ".codex", "sessions"),
    }
    raiz = raizes.get(kind)
    if not raiz or not os.path.isdir(raiz):
        return None
    for dirpath, _dirs, arquivos in os.walk(raiz):
        for nome in arquivos:
            if sess in nome:
                return os.path.join(dirpath, nome)
    return None


def rodar_verificacao(name, verif_path, handoff_path, timeout_s, historico=None):
    """Confirma que a transferencia funcionou, nas DUAS direcoes.

    Validado ao vivo no swap do mfc-exec (2026-09-12, claude -> codex): 5/5 nas
    positivas, com o agent novo citando ate o identificador do achado e a
    RESSALVA de uma garantia estatistica.

    RESSALVA sobre o "5/5 nas negativas" que esta docstring afirmava: aquele
    numero saiu do contador defeituoso (contava o eco da instrucao), entao o
    resultado real daquele swap pode ter sido 4/5. Nao da pra reconferir -- o
    pane foi fechado. Vale como evidencia das positivas, nao das negativas.
    Ver conta_recusas().

    A metade negativa e' a que mais importa e a que quase nao se testa. Um agent
    que preenche lacuna com invencao plausivel e' mais perigoso que um que nao
    sabe, porque soa competente -- e num space que executa ordem em conta de
    trading isso decide se da pra deixa-lo operar sozinho."""
    import re as _re

    with open(verif_path, encoding="utf-8", errors="ignore") as fh:
        texto = fh.read()

    def extrai(secao):
        padrao = r"##\s*" + secao + r"(.*?)(?=\n##\s|\Z)"
        m = _re.search(padrao, texto, _re.S | _re.I)
        if not m:
            return []
        return [l.strip() for l in m.group(1).splitlines()
                if _re.match(r"^\s*\d+\.", l) and "GABARITO" not in l.upper()]

    positivas, negativas = extrai("POSITIVAS"), extrai("NEGATIVAS")
    if not (positivas and negativas):
        print("aviso: " + os.path.basename(verif_path) + " nao tem as duas secoes no "
              "formato esperado - faca a verificacao na mao.", file=sys.stderr)
        return None

    print("")
    print("verificando a transferencia (" + str(len(positivas)) + " positivas, "
          + str(len(negativas)) + " negativas)...")

    instrucao = ("Responda numeradas, em sequencia, direto. Nao releia o projeto nem "
                 "pesquise: quero o que voce retem do handoff. Se a resposta NAO estiver "
                 "no handoff, escreva exatamente 'nao esta no handoff' "
                 + FIM_DA_INSTRUCAO + ".")
    perguntas = chr(10).join(positivas + negativas)
    try:
        expected = get_agent(name)
        headless_reviewer = name.endswith(("-rev-1", "-rev-2", "-scout"))
        status, wait_info = dispatch_and_wait(
            name, instrucao + chr(10) + chr(10) + perguntas,
            timeout_s, expected_info=expected,
            check_composition=not headless_reviewer,
        )
        if status not in ("idle", "done"):
            print("aviso: verificacao terminou sem estado terminal (" +
                  str(status) + ") — confira manualmente.", file=sys.stderr)
            return None
        out = subprocess.run(
            core.herdr_argv("agent", "read", name, "--source", "recent-unwrapped",
                            "--lines", "120"),
            capture_output=True, text=True, timeout=CLI_TIMEOUT_S,
        ).stdout
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
        print("aviso: verificacao nao concluiu (" + str(exc) + ") — "
              "o handoff foi confirmado; confira manualmente " + verif_path,
              file=sys.stderr)
        return None

    # So as NEGATIVAS dao pra conferir sozinho: a resposta certa e' uma forma de
    # "nao sei". As positivas exigem julgamento, entao ficam pro humano comparar
    # com o GABARITO do arquivo.
    admitiu = conta_recusas(out)
    transcript_path = respostas_verificacao_path(verif_path)
    persistir_respostas_verificacao(
        transcript_path,
        name=name,
        verif_path=verif_path,
        status=status,
        admitiu=admitiu,
        negativas=negativas,
        out=out,
    )
    print("  respostas preservadas em " + transcript_path)
    # Mais recusas que perguntas é uma contagem impossível: pode ser eco mal
    # cortado ou uma positiva legitimamente recusada. É indeterminado, não uma
    # reprovação automática que descarte o substituto confirmado.
    if admitiu > len(negativas):
        print("  contagem impossivel: resultado indeterminado; confira "
              "manualmente antes de decidir.")
        return None
    ok = admitiu == len(negativas)
    print("  negativas: " + str(admitiu) + "/" + str(len(negativas))
          + " admitiram desconhecimento" + ("  OK" if ok else "  ATENCAO"))
    if not ok:
        # PROATIVO: em vez de so reportar a falha, ja entrega a fonte completa.
        # O log da sessao antiga sobrevive ao swap, entao o agent pode consultar
        # o que o resumo nao cobriu -- sem depender de alguem perceber depois.
        if admitiu > len(negativas):
            # NAO afirmar a causa aqui. Ja aconteceu de eu culpar o corte do eco
            # e a causa ser outra: o agent recusou uma POSITIVA cuja resposta o
            # handoff de fato nao trazia -- comportamento certo dele, pergunta
            # defeituosa minha. Mais recusas que negativas e' um sinal, nao um
            # diagnostico; listar as hipoteses e mandar olhar e' mais util (e
            # mais honesto) que escolher uma sem evidencia.
            print("  contagem impossivel (" + str(admitiu) + " recusas para "
                  + str(len(negativas)) + " negativas). Duas causas possiveis:")
            print("    - alguma POSITIVA foi recusada, e talvez com razao: a")
            print("      resposta pode nao estar mesmo no handoff. Confira ANTES")
            print("      de culpar o agent -- o gabarito pode ser que esteja errado.")
            print("    - o corte do eco da instrucao falhou (ver conta_recusas).")
            print("  Leia as respostas e decida:")
        else:
            print("  " + str(len(negativas) - admitiu) + " resposta(s) podem ser invencao.")
        if historico:
            print("  mandando o historico completo da sessao anterior como fonte...")
            try:
                api("agent", "prompt", name,
                    "Correcao de rota: algumas respostas suas pareceram preencher lacuna "
                    "em vez de admitir desconhecimento. O handoff e' um RESUMO, e o "
                    "historico completo do agent anterior esta em " + historico + " -- "
                    "consulte esse arquivo quando o resumo nao bastar, e prefira dizer "
                    "'nao sei' a deduzir. Inventar com confianca num projeto de "
                    "consequencia e' pior que nao saber.")
                print("  enviado. Historico: " + historico)
            except RuntimeError as exc:
                print("  falhei mandando (" + str(exc) + "); avise na mao: " + historico,
                      file=sys.stderr)
        else:
            print("  historico da sessao anterior nao localizado; leia o pane na mao.")
    print("  positivas: confira as respostas contra o GABARITO em " + verif_path)
    print("  respostas: herdr agent read " + name + " --source recent-unwrapped --lines 120")
    return ok

if __name__ == "__main__":
    main()
