#!/usr/bin/env python3
"""herdr-add-space <label> <cwd> — registra um space novo no SPACES do
herdr-bootstrap e deixa o bootstrap criar tudo.

    herdr-add-space omasession ~/Devs/omasession --note "plugin de restauracao de sessao"
    herdr-add-space HomeHub ~/Devs/HomeHub --no-scout --note "sem scout: pedido do usuario"

Todo space entra no inventario (--categoria obrigatoria, ver ~/Devs/inventory/config/
categories.json) e SO entra no foco do Guardian com --guardian:

    herdr-add-space foo ~/Devs/foo --lean --categoria SaaS --note "..."              # so inventario
    herdr-add-space foo ~/Devs/foo --lean --categoria SaaS --guardian --note "..."   # + Guardian

NAO cria workspace/panes/agents por conta propria. Escreve a entrada na tabela
e chama `herdr-bootstrap`, que ja e' idempotente, ja deriva os revisores do
slug (REV_EFFORT/REV_OVERRIDES), ja lida com a migracao rev->rev-1 e ja arma o
notify-watch do exec. Os perfis pinados de exec/scout sao reutilizados da
tabela; um caminho paralelo criaria spaces que a tabela nao
conhece - orfaos que ninguem recria depois.

A tabela vale pelos comentarios: e' la que esta escrito por que o llm-gateway
tem slug "llm", por que o cwd do claude-bridge e' o repo e nao o dir de
runtime, e qual e' o perfil padrao de cada papel. Por isso --note existe e por
isso a ausencia dele deixa um TODO visivel em vez de uma entrada muda.
"""
import argparse
import ast
import datetime
import glob
import json
import os
import shutil
import re
import subprocess
import sys

# realpath, nao abspath: chamado pelo symlink em ~/.local/bin, abspath
# aponta para o symlink e a mensagem final mente sobre qual arquivo mudou.
_DEFAULT_BOOTSTRAP = os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "herdr-bootstrap")

# HERDR_SESSION isola workspaces/panes/agents, mas NAO isola este arquivo: sem
# isto, testar o script exige escrever no herdr-bootstrap de producao (foi o
# que aconteceu em 2026-09-08 -- um space de teste entrou na tabela real e teve
# de ser removido a mao). Aponte para uma copia ao testar:
#
#   cp bin/herdr-bootstrap /tmp/bs && \
#     HERDR_SESSION=testlab HERDR_BOOTSTRAP_PATH=/tmp/bs herdr-add-space ...
BOOTSTRAP = os.environ.get("HERDR_BOOTSTRAP_PATH") or _DEFAULT_BOOTSTRAP
BOOTSTRAP = os.path.realpath(os.path.expanduser(BOOTSTRAP))
HOME = os.path.expanduser("~")
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _herdr_trust as trust


def die(msg):
    print(f"herdr-add-space: {msg}", file=sys.stderr)
    sys.exit(1)


def run(*argv, check=False):
    return subprocess.run(argv, capture_output=True, text=True, check=check)


def spaces_node(source):
    """The `SPACES = [...]` assignment, located by parsing rather than regex.

    ast gives us the exact line the list closes on, so the entry goes in
    without touching a single existing comment.
    """
    tree = ast.parse(source)
    for node in tree.body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id == "SPACES":
                    return node
    die(f"nao encontrei a lista SPACES em {BOOTSTRAP}")


def existing_labels(source):
    node = spaces_node(source)
    if not isinstance(node.value, ast.List):
        die("SPACES nao e' mais uma lista apos a edicao; nada foi escrito")
    labels = []
    for elt in node.value.elts:
        if isinstance(elt, ast.Tuple) and elt.elts:
            first = elt.elts[0]
            if isinstance(first, ast.Constant) and isinstance(first.value, str):
                labels.append(first.value)
    return labels


def render_entry(label, cwd, slug, exec_kind, scout_kind, note, lean=False,
                 *, options=None, additional_repositories=None):
    """The tuple as it will read in the file, comment first."""
    today = datetime.date.today().isoformat()
    lines = []
    if note:
        # Wrap by hand: the file is 79-col prose and reads as a changelog.
        prefix = f"    # {label}: "
        words, line = note.split(), prefix
        for w in words:
            if len(line) + len(w) + 1 > 76:
                lines.append(line.rstrip())
                line = "    # " + w + " "
            else:
                line += w + " "
        lines.append(line.rstrip())
        lines.append(f"    # Registrado por herdr-add-space em {today}.")
    else:
        lines.append(f"    # {label}: TODO por que este space existe (registrado")
        lines.append(f"    # por herdr-add-space em {today}, sem --note). Uma entrada muda")
        lines.append(f"    # aqui vira uma decisao que ninguem consegue reconstruir depois.")

    # HOME as an f-string, matching every other row in the table.
    cwd_expr = f'f"{{HOME}}{cwd[len(HOME):]}"' if cwd.startswith(HOME + "/") else repr(cwd)
    exec_name = f"{slug}-exec"

    # Reuse the pinned profiles already declared at the top of
    # herdr-bootstrap. Emitting [] here would make a newly registered space
    # inherit a mutable global model/effort, defeating the table's purpose.
    def profile_expr(kind, role):
        if kind == "codex":
            return "SCOUT_ARGS" if role == "scout" else "EXEC_ARGS_CODEX"
        if kind == "claude":
            return "SCOUT_ARGS_CLAUDE" if role == "scout" else "EXEC_ARGS"
        # Kinds without a shared model/effort profile (for example grok) keep
        # their native defaults; they are not silently given flags from a
        # different CLI family.
        return "[]"

    exec_args = profile_expr(exec_kind, "exec")
    scout_part = (f'("{slug}-scout", "{scout_kind}", '
                  f'{profile_expr(scout_kind, "scout")})' if scout_kind else "None")
    opts=dict(options or {})
    if additional_repositories is not None:
        if not isinstance(additional_repositories,list) or not all(
                isinstance(p,str) and os.path.isabs(p) for p in additional_repositories):
            raise ValueError('additional_repositories deve ser lista de caminhos absolutos')
        opts['additional_repositories']=list(additional_repositories)
    if lean:opts['lean']=True
    slug_part=f', "{slug}"' if (slug!=label.lower() or opts) else ''
    if opts:slug_part+=', {'+', '.join(json.dumps(k,ensure_ascii=False)+': '+repr(v) for k,v in opts.items())+'}'

    lines.append(f'    ("{label}", {cwd_expr}, ("{exec_name}", "{exec_kind}", {exec_args}),')
    lines.append(f"        {scout_part}{slug_part}),")
    return "\n".join(lines) + "\n"


# --- passos pos-bootstrap ------------------------------------------------
#
# Os tres abaixo nasceram de um space criado a mao em 2026-09-22 e sao
# deliberadamente IDEMPOTENTES: cada um checa o estado antes de agir e nao
# falha a criacao do space se nao conseguir. Um space meio criado e' pior que
# um passo opcional que avisou e seguiu.


def ensure_git(cwd):
    """`git init` so quando o cwd AINDA NAO e' repo.

    Nunca sobrescreve nada. Um .gitignore pre-existente e' preservado e as
    entradas do Herdr sao ANEXADAS -- reescrever o arquivo de um projeto ja
    existente (ex.: um app Rails) apaga as regras dele, inclusive as que
    protegem segredo como config/master.key.
    """
    # `isdir(.git)` nao reconhece worktree (onde .git e' ARQUIVO) nem um
    # subdiretorio de repo; `git rev-parse` reconhece os dois.
    dentro = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"],
                            cwd=cwd, capture_output=True, text=True)
    if dentro.returncode == 0 and dentro.stdout.strip() == "true":
        print(f"herdr-add-space: {cwd} ja esta sob git, nao toquei")
    else:
        r = subprocess.run(["git", "init", "-q"], cwd=cwd,
                           capture_output=True, text=True)
        if r.returncode != 0:
            print(f"herdr-add-space: aviso: `git init` falhou ({r.stderr.strip()}); seguindo")
            return
        print(f"herdr-add-space: git init em {cwd}")

    # Comparar REGRAS efetivas, nao a substring ".herdr/": um .gitignore que
    # so MENCIONA .herdr num comentario, ou que cobre apenas uma das regras,
    # fazia a funcao desistir e deixar o resto desprotegido.
    gi = os.path.join(cwd, ".gitignore")
    atual = ""
    if os.path.exists(gi):
        try:
            with open(gi, encoding="utf-8") as fh:
                atual = fh.read()
        except OSError as exc:
            print(f"herdr-add-space: aviso: nao li {gi} ({exc}); seguindo")
            return
    vigentes = {l.strip().lstrip("/") for l in atual.splitlines()
                if l.strip() and not l.lstrip().startswith("#")}
    if ".herdr/" in vigentes or ".herdr" in vigentes:
        return  # regra abrangente ja cobre tudo
    querem = ["/.herdr/review/", "/.herdr/ask/", "/.herdr/handoff/",
              "/.herdr/migration.lock", "/.herdr/migration-state.json"]
    faltam = [r for r in querem if r.lstrip("/") not in vigentes]
    if not faltam:
        return
    bloco = ("\n# Artefatos locais do Herdr. Snapshots de revisao e estado de\n"
             "# migracao nascem por rodada e nao devem versionar.\n"
             + "\n".join(faltam) + "\n")
    try:
        with open(gi, "a", encoding="utf-8") as fh:
            fh.write(bloco)
    except OSError as exc:
        print(f"herdr-add-space: aviso: nao escrevi {gi} ({exc}); seguindo")
        return
    print(f"herdr-add-space: {len(faltam)} regra(s) do Herdr anexada(s) em {gi}")


def _hargv(*args):
    """`herdr` com `--session` na frente quando HERDR_SESSION estiver setada.

    Sem isto, estes passos consultavam e MUTAVAM o endpoint padrao enquanto o
    resto do fluxo operava numa sessao nomeada -- com labels coincidentes,
    abririam e renomeariam tab no workspace errado. Apontado pelos dois
    revisores na rodada herdr-2. `HERDR_SESSION` sozinha nao isola nada: ver
    herdr_argv em _herdr_dispatch.py.
    """
    sess = os.environ.get("HERDR_SESSION")
    return ["herdr", *(["--session", sess] if sess else []), *args]


def ensure_openboard(label):
    """Tab `OpenBoard` com o board do plugin herdr-tsk.

    NAO e' um agent. Escrito assim depois de eu criar, duas vezes, um pane
    com Claude chamado `<slug>-onboard` -- "onboard" aqui sempre foi a acao
    `open-board` do plugin de tarefas, que e' um pane de plugin sem agent
    nenhum (`agent_status: unknown`). Convencao confirmada nos 13 workspaces
    que ja tinham: um pane de label `tsk`, sozinho numa tab chamada
    `OpenBoard`.
    """
    ws = workspace_id_por_label(label)
    if not ws:
        print(f"herdr-add-space: aviso: workspace de '{label}' nao encontrado; OpenBoard nao aberto")
        return
    panes = subprocess.run(_hargv("pane", "list"), capture_output=True, text=True)
    for linha in panes.stdout.splitlines():
        try:
            dados = json.loads(linha)
        except ValueError:
            continue
        for pane in dados.get("result", {}).get("panes", []):
            if pane.get("label") == "tsk" and str(pane.get("pane_id", "")).startswith(ws + ":"):
                print(f"herdr-add-space: OpenBoard ja existe em {pane['pane_id']}, pulando")
                return
    aberto = subprocess.run(
        _hargv("plugin", "pane", "open", "--plugin", "herdr-tsk",
               "--entrypoint", "board", "--placement", "tab", "--workspace", ws),
        capture_output=True, text=True)
    try:
        tab = json.loads(aberto.stdout)["result"]["plugin_pane"]["pane"]["tab_id"]
    except (ValueError, KeyError):
        print(f"herdr-add-space: aviso: nao abri o board do tsk "
              f"({aberto.stderr.strip() or aberto.stdout.strip()})")
        return
    subprocess.run(_hargv("tab", "rename", tab, "OpenBoard"),
                   capture_output=True, text=True)
    print(f"herdr-add-space: tab OpenBoard em {tab} (board do tsk)")


def workspace_id_por_label(label):
    r = subprocess.run(_hargv("workspace", "list"), capture_output=True, text=True)
    for linha in r.stdout.splitlines():
        try:
            dados = json.loads(linha)
        except ValueError:
            continue
        for ws in dados.get("result", {}).get("workspaces", []):
            if ws.get("label") == label:
                return ws.get("workspace_id")
    return None


def ensure_board(cwd):
    """Projeto correspondente no board do tsk.

    O tsk so cria destino novo a partir de um DIRETORIO ABSOLUTO existente, e
    nomeia o projeto pelo basename da raiz do repo -- por isso este passo vem
    depois do ensure_git. Um `-p <nome>` solto e' recusado com unknown-project.
    """
    tsk = shutil.which("tsk") or next(
        (c for c in glob.glob(os.path.expanduser(
            "~/.config/herdr/plugins/github/herdr-tsk-*/target/release/tsk"))
         if os.access(c, os.X_OK)), None)
    if not tsk:
        print("herdr-add-space: binario do `tsk` nao encontrado; board nao criado")
        return
    nome = os.path.basename(cwd.rstrip("/"))
    # stdout vazio NAO prova ausencia de projeto: uma task ancora fechada ou
    # arquivada some das views vivas e a funcao recriaria outra a cada
    # execucao. `--done`/`--archived` cobrem esses estados; um list que FALHA
    # (returncode != 0) nao autoriza criar nada.
    visto = False
    for extra in ([], ["--done"], ["--archived"]):
        r = subprocess.run([tsk, "list", "-p", nome, *extra],
                           capture_output=True, text=True)
        if r.returncode != 0:
            saida = (r.stdout or r.stderr or "").strip()
            if "unknown-project" in saida:
                continue  # projeto realmente nao existe; segue pra criar
            print(f"herdr-add-space: aviso: `tsk list` falhou ({saida[:80]}); "
                  f"board nao criado")
            return
        if r.stdout.strip():
            visto = True
            break
    if visto:
        print(f"herdr-add-space: board '{nome}' ja existe, pulando")
        return
    r = subprocess.run(
        [tsk, "add", "-t", f"Bootstrap do space {nome}",
         "-n", "Task ancora criada por herdr-add-space: ela e' o que faz o "
               "projeto existir no board do tsk. NAO arquive esta task -- o "
               "projeto so existe enquanto tiver ao menos uma.",
         "-p", cwd, "--json"], capture_output=True, text=True)
    print(f"herdr-add-space: board '{nome}' criado no tsk"
          if r.returncode == 0 else
          f"herdr-add-space: aviso: nao criei o board ({r.stdout.strip() or r.stderr.strip()})")


# --- registro no inventario e no Guardian -----------------------------------
#
# Todo space novo ENTRA no inventario (catalogo de projetos, http://127.0.0.1:8088/inventory/)
# e so entra no Guardian com --guardian. O inventario descobre o space sozinho pelo cwd do
# pane `<slug>-exec`, mas sem linha em categories.json o projeto cai em "outros"; por isso a
# categoria e' obrigatoria aqui. Os arquivos sao de outros projetos (inventory e claude-bridge):
# a edicao e' uma linha de texto por vez, atomica, sem reformatar o resto -- ha mudancas
# sem commit de outros agents nesses repositorios e um dump do json as reescreveria.

INVENTORY_DIR = os.path.realpath(os.path.expanduser(
    os.environ.get("HERDR_INVENTORY_DIR") or "~/Devs/inventory"))
GUARDIAN_FASES = os.path.realpath(os.path.expanduser(
    os.environ.get("HERDR_GUARDIAN_FASES") or "~/Devs/guardian/guardian/visao-fases.json"))
# Em teste (qualquer override) os coletores reais nao rodam.
_REGISTROS_ISOLADOS = bool(os.environ.get("HERDR_INVENTORY_DIR")
                           or os.environ.get("HERDR_GUARDIAN_FASES"))


def categorias_validas():
    """Categorias declaradas no inventario; [] se o arquivo nao pode ser lido."""
    try:
        with open(os.path.join(INVENTORY_DIR, "config", "categories.json"), encoding="utf-8") as fh:
            return list(json.load(fh).get("categories", []))
    except (OSError, ValueError):
        return []


def inserir_membro(texto, abre, fecha_re, linha):
    """Insere `linha` como ultimo membro do bloco aberto por `abre` (substring de uma linha;
    None = objeto de topo). Mexe so nessa linha e na virgula do membro anterior."""
    linhas = texto.splitlines(keepends=True)
    inicio = 0
    if abre is not None:
        achou = [i for i, l in enumerate(linhas) if abre in l]
        if len(achou) != 1:
            raise ValueError(f"bloco {abre!r} encontrado {len(achou)} vez(es)")
        inicio = achou[0]
    fecho = next((i for i in range(inicio + 1, len(linhas))
                  if re.match(fecha_re, linhas[i])), None)
    if fecho is None:
        raise ValueError(f"nao achei o fim do bloco {abre!r}")
    ant = next((i for i in range(fecho - 1, inicio - 1, -1) if linhas[i].strip()), None)
    if ant is not None:
        corpo = linhas[ant].rstrip("\n").rstrip()
        if not corpo.endswith((",", "{", "[")):
            linhas[ant] = corpo + ",\n"
    linhas.insert(fecho, linha.rstrip("\n") + "\n")
    return "".join(linhas)


def _gravar_atomico(caminho, texto):
    tmp = caminho + ".herdr-tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(texto)
    os.chmod(tmp, os.stat(caminho).st_mode & 0o7777)
    os.replace(tmp, caminho)


def _chave_inventario(cwd):
    return "~" + cwd[len(HOME):] if cwd.startswith(HOME + "/") else cwd


def registrar_inventario(cwd, categoria, descricao):
    """categories.json (obrigatorio) e projects.json (so com descricao). Idempotente."""
    chave = _chave_inventario(cwd)
    cat_path = os.path.join(INVENTORY_DIR, "config", "categories.json")
    texto = open(cat_path, encoding="utf-8").read()
    if chave in json.loads(texto)["projects"]:
        print(f"herdr-add-space: inventario: {chave} ja tem categoria, nao toquei")
    else:
        novo = inserir_membro(texto, '"projects": {', r"^  \},?\s*$",
                              f"    {json.dumps(chave, ensure_ascii=False)}: "
                              f"{json.dumps([categoria], ensure_ascii=False)}")
        if json.loads(novo)["projects"].get(chave) != [categoria]:
            raise ValueError("a insercao em categories.json nao reproduziu a entrada")
        _gravar_atomico(cat_path, novo)
        print(f"herdr-add-space: inventario: {chave} -> [{categoria}] em {cat_path}")
    if not descricao:
        return
    desc_path = os.path.join(INVENTORY_DIR, "config", "projects.json")
    texto = open(desc_path, encoding="utf-8").read()
    if chave in json.loads(texto):
        print(f"herdr-add-space: inventario: {chave} ja tem descricao, nao toquei")
        return
    novo = inserir_membro(texto, None, r"^\}\s*$",
                          f"  {json.dumps(chave, ensure_ascii=False)}: "
                          f"{json.dumps(descricao, ensure_ascii=False)}")
    if json.loads(novo).get(chave) != descricao:
        raise ValueError("a insercao em projects.json nao reproduziu a entrada")
    _gravar_atomico(desc_path, novo)
    print(f"herdr-add-space: inventario: descricao de {chave} em {desc_path}")


def atualizar_catalogo():
    """Refaz a lista de projetos do inventario agora (leitura; o timer faria depois)."""
    if _REGISTROS_ISOLADOS:
        return
    for script in ("collector/linux/projects.py", "collector/export.py"):
        r = subprocess.run([sys.executable, os.path.join(INVENTORY_DIR, script)],
                           capture_output=True, text=True)
        if r.returncode != 0:
            print(f"herdr-add-space: aviso: {script} falhou ({r.stderr.strip()[-120:]}); "
                  f"o timer do inventario refaz")
            return
    print("herdr-add-space: inventario: catalogo de projetos atualizado")


def foco_do_guardian():
    with open(GUARDIAN_FASES, encoding="utf-8") as fh:
        return json.load(fh).get("foco", [])


def registrar_guardian(exec_name, quer):
    """`--guardian` poe `<slug>-exec` em `foco` de visao-fases.json; sem a flag NAO poe.
    Nunca tira ninguem de la: quem ja estava la foi decisao do Breno / claude-bridge-exec."""
    foco = foco_do_guardian()
    if not quer:
        if exec_name in foco:
            print(f"herdr-add-space: aviso: {exec_name} JA esta no foco do Guardian "
                  f"({GUARDIAN_FASES}) e voce nao passou --guardian; nao removi")
        else:
            print("herdr-add-space: Guardian: fora do foco (sem --guardian)")
        return
    if exec_name in foco:
        print(f"herdr-add-space: Guardian: {exec_name} ja esta no foco")
        return
    texto = open(GUARDIAN_FASES, encoding="utf-8").read()
    novo = inserir_membro(texto, '"foco": [', r"^  \],?\s*$", f'    "{exec_name}"')
    if exec_name not in json.loads(novo).get("foco", []):
        raise ValueError("a insercao em visao-fases.json nao reproduziu a entrada")
    _gravar_atomico(GUARDIAN_FASES, novo)
    print(f"herdr-add-space: Guardian: {exec_name} entrou no foco em {GUARDIAN_FASES}")


def main():
    ap = argparse.ArgumentParser(
        prog="herdr-add-space",
        description="Registra um space no SPACES do herdr-bootstrap e roda o bootstrap.")
    ap.add_argument("label", help="label do workspace (vira prefixo dos agents)")
    ap.add_argument("cwd", nargs="?", default=None,
                    help="diretorio do projeto (default: o atual)")
    ap.add_argument("--slug", default=None,
                    help="prefixo dos agents, se divergir do label (ex: llm-gateway -> llm)")
    ap.add_argument("--note", default="",
                    help="por que este space existe. Sem isso fica um TODO no arquivo.")
    ap.add_argument("--no-scout", action="store_true", help="space sem scout")
    ap.add_argument("--lean", action="store_true",
                    help="space enxuto: so o exec sobe; revisores e scout ficam declarados "
                         "na tabela e sobem sob demanda (dispatchers). Poupa memoria.")
    ap.add_argument("--no-openboard", action="store_true",
                    help="nao abre a tab OpenBoard com o board do tsk")
    ap.add_argument("--no-git", action="store_true",
                    help="nao roda `git init` num cwd que ainda nao e' repo")
    ap.add_argument("--no-board", action="store_true",
                    help="nao cria o projeto correspondente no board do tsk")
    ap.add_argument("--categoria", default=None,
                    help="categoria do projeto no inventario (obrigatoria; ver categories.json "
                         "em ~/Devs/inventory/config). O space SEMPRE entra no inventario.")
    ap.add_argument("--descricao", default=None,
                    help="descricao curta no inventario (default: o --note). So e' usada se o "
                         "README do projeto nao serve; vai em config/projects.json")
    ap.add_argument("--guardian", action="store_true",
                    help="poe o exec no foco do Guardian (guardian/visao-fases.json). "
                         "SEM esta flag o space NAO entra na monitoracao do Guardian.")
    ap.add_argument("--additional-repo", action="append", default=None, metavar="PATH",
                    help="repositório adicional declarado para este space (repetível)")
    ap.add_argument("--exec-kind", default="claude")
    ap.add_argument("--scout-kind", default="codex")
    ap.add_argument("--dry-run", action="store_true",
                    help="mostra a entrada e o dry-run do bootstrap, sem escrever nada")
    args = ap.parse_args()

    label = args.label
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", label):
        die("label deve ser alfanumerico com . _ - (vira nome de agent)")

    cwd = os.path.realpath(os.path.expanduser(args.cwd or os.getcwd()))
    if not os.path.isdir(cwd):
        die(f"diretorio nao existe: {cwd}  (o bootstrap nao cria pastas)")

    slug = args.slug or label.lower()

    # Inventario e' obrigatorio: falha ANTES de escrever qualquer coisa.
    cats = categorias_validas()
    if not cats:
        die(f"nao consegui ler as categorias do inventario em {INVENTORY_DIR}/config/categories.json")
    if not args.categoria and not args.dry_run:
        die("--categoria e' obrigatoria: todo space entra no inventario. "
            f"Opcoes: {', '.join(cats)}")
    if args.categoria and args.categoria not in cats:
        die(f"categoria '{args.categoria}' nao existe no inventario. Opcoes: {', '.join(cats)}")
    try:
        foco_do_guardian()
    except (OSError, ValueError) as exc:
        die(f"nao consegui ler o foco do Guardian em {GUARDIAN_FASES} ({exc})")
    scout_kind = None if args.no_scout else args.scout_kind

    session = os.environ.get("HERDR_SESSION")
    if BOOTSTRAP != _DEFAULT_BOOTSTRAP or session:
        print(f"herdr-add-space: MODO TESTE  session={session or 'default'}  "
              f"tabela={BOOTSTRAP}", flush=True)

    source = open(BOOTSTRAP, encoding="utf-8").read()

    if label in existing_labels(source):
        die(f"'{label}' ja esta no SPACES — rode `herdr-bootstrap` (ele e' idempotente)")

    # A label that already exists as a workspace but not in the table is the
    # normal case for spaces created by hand: register it, do not recreate it.
    # --session vem antes do subcomando: HERDR_SESSION sozinha nao isola nada
    # (nao e' variavel do Herdr - ver herdr_argv em _herdr_dispatch.py).
    _sess = os.environ.get("HERDR_SESSION")
    out = run("herdr", *(["--session", _sess] if _sess else []), "workspace", "list")
    workspace_exists = (out.returncode == 0
                        and f'"label": "{label}"' in out.stdout.replace("'", '"'))
    if workspace_exists:
        print(f"herdr-add-space: workspace '{label}' ja existe — registrando na "
              f"tabela para o bootstrap saber recria-lo (ele nao vai duplicar)")

    additional=None
    if args.additional_repo:
        import _herdr_space_repositories as space_repos
        import _herdr_review_scope as review_scope
        try:
            # Multi-repository review requires the base itself to be a Git
            # root. Do not initialize it as a side effect of this validation.
            base_root=review_scope._repository(cwd)
            additional=[review_scope._repository(p) for p in args.additional_repo]
            roots=space_repos.repositories((label,base_root,None,None,slug,{'additional_repositories':additional}))
            additional=roots[1:]
        except RuntimeError as exc:die(str(exc))
    entry = render_entry(label, cwd, slug, args.exec_kind, scout_kind, args.note, lean=args.lean,
                         additional_repositories=additional)
    print("herdr-add-space: entrada a inserir\n", flush=True)
    print(entry, flush=True)

    if args.dry_run:
        print("herdr-add-space: --dry-run, nada escrito. Bootstrap atual diria:\n")
        subprocess.run([sys.executable, BOOTSTRAP, "--dry-run"])
        return 0

    # Insert just before the `]` that closes the list, so no existing comment is
    # touched. Position by column and not only by line: with `SPACES = []` the
    # bracket sits on the same line as the assignment, and inserting "before
    # that line" drops the entry outside the list (unexpected indent). Caught
    # by the ast guard below during the isolated validation, 2026-09-08.
    node = spaces_node(source)
    lines = source.splitlines(keepends=True)
    close_line = node.value.end_lineno - 1        # 0-based
    close_col = node.value.end_col_offset - 1     # the `]` itself
    line = lines[close_line]
    head, tail = line[:close_col], line[close_col:]
    if head.strip():
        # `]` shares its line with code: split there and keep both halves. The
        # comma matters more than it looks -- `[("a", ...)` followed by
        # `("novo", ...)` with no comma parses fine and means a CALL, silently
        # collapsing the table into one bogus element. ast.parse would not
        # catch that; the label count below would, but by then the file is
        # already nonsense.
        head_clean = head.rstrip("\n").rstrip()
        sep = "" if head_clean.endswith(("[", ",")) else ","
        lines[close_line] = head_clean + sep + "\n" + entry + tail
    else:
        # `]` alone on its line: the entry goes on the line above it.
        lines.insert(close_line, entry)
    new_source = "".join(lines)

    try:
        ast.parse(new_source)
    except SyntaxError as exc:
        die(f"a insercao quebraria o herdr-bootstrap ({exc}); nada foi escrito")

    if existing_labels(new_source).count(label) != 1:
        die("a entrada nao apareceu exatamente uma vez; nada foi escrito")

    # Um space NOVO nunca teve um "<slug>-rev" para migrar, entao ele nasce ja
    # no nome novo. Sem isto o default legacy (certo para os spaces antigos,
    # que de fato tem "-rev") faria o bootstrap criar "<slug>-rev" enquanto
    # tudo mais fala "-rev-1" -- foi o que aconteceu com o omasession, cujos
    # agents foram criados a mao como "-rev-1" enquanto o estado dizia legacy.
    # So para space realmente novo: marcar um space existente como migrated
    # renomearia o revisor dele por baixo dos panos.
    if not workspace_exists:
        try:
            sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
            import _herdr_migration as migration
            import _herdr_dispatch as core
            root = core.project_root(cwd)
            if migration.read_migration_state(root)["phase"] == "legacy":
                migration.write_migration_state_atomic(root, {
                    "phase": "migrated",
                    "note": f"space criado por herdr-add-space; nasceu com "
                            f"{slug}-rev-1, nunca existiu {slug}-rev.",
                })
                print(f"herdr-add-space: {root}/.herdr/migration-state.json "
                      f"marcado migrated (space novo nasce com -rev-1)", flush=True)
        except Exception as exc:
            print(f"herdr-add-space: nao consegui marcar migration-state ({exc}); "
                  f"o revisor pode subir como '{slug}-rev'", file=sys.stderr)

    with open(BOOTSTRAP, "w", encoding="utf-8") as fh:
        fh.write(new_source)
    print(f"herdr-add-space: {BOOTSTRAP} atualizado (nao commitado)\n", flush=True)

    # Registration precedes authorization: trust only the now-declared cwd.
    trust.ensure_trusted(cwd, args.exec_kind)
    rc = subprocess.run([sys.executable, BOOTSTRAP]).returncode
    if rc != 0:
        die(f"herdr-bootstrap saiu com {rc} — a entrada ficou no arquivo, "
            f"revise e rode `herdr-bootstrap` de novo")

    # Inventario sempre; Guardian so com --guardian. Falha aqui NAO desfaz o space (o bootstrap
    # ja rodou): avisa alto e sai com codigo != 0 no fim, para ninguem achar que registrou.
    falhas_registro = []
    for nome, fn in (("inventario", lambda: registrar_inventario(
                          cwd, args.categoria, args.descricao or args.note)),
                     ("guardian", lambda: registrar_guardian(f"{slug}-exec", args.guardian))):
        try:
            fn()
        except (OSError, ValueError, KeyError) as exc:
            falhas_registro.append(nome)
            print(f"herdr-add-space: ERRO: nao registrei no {nome}: {exc}", file=sys.stderr)
    if "inventario" not in falhas_registro:
        atualizar_catalogo()

    if not args.no_git:
        ensure_git(cwd)
    if not args.no_openboard:
        ensure_openboard(label)
    if not args.no_board:
        ensure_board(cwd)

    # Verify against herdr, not against exit codes: `herdr agent start` exits
    # non-zero when readiness detection times out even though the agent is up.
    print(f"\nherdr-add-space: agents com cwd em {cwd}\n", flush=True)
    subprocess.run(["herdr-agents", "--name", os.path.basename(cwd)])
    if falhas_registro:
        print(f"\nherdr-add-space: ATENCAO: space criado, mas NAO registrado em: "
              f"{', '.join(falhas_registro)}. Corrija e registre a mao.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
