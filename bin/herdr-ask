#!/usr/bin/env python3
"""herdr-ask <slug> — dispara uma consulta de design cega e paralela pros dois
revisores (<slug>-rev-1, <slug>-rev-2), ou uma consulta única ao scout para
escalonamento automático após as duas rodadas, de um space do Herdr. Mesma mecânica do
herdr-review-dispatch (isolamento por diretório, congelamento de contexto,
`agent prompt --wait` concorrente), formato de resposta diferente: não é bug
hunt, não tem achado atômico P0-P3 nem APPROVE — é uma pergunta de design
aberta, e a resposta é uma posição com premissas explícitas.

Uso:
  herdr-ask <slug> --question-file pergunta.md
  herdr-ask <slug> --question-file pergunta.md --context /caminho/a /caminho/b
  herdr-ask <slug> --question-file pergunta.md --reviewer rev   # só 1 consultor
  herdr-ask <slug> --question-file pergunta.md --reviewer scout # escalonamento

Grava em .herdr/ask/<slug>-<N>/ — namespace separado de .herdr/review/, pra
não colidir a numeração de rodada com o encadeamento de --verify do
herdr-review-dispatch.

Sai com 0 só se todos os consultores despachados produziram resposta não
vazia. O lifecycle `idle`/`done` só fecha a espera depois de `answer.md`; se
o artefato não aparecer no prazo, o status é `artifact_missing`. Qualquer
BLOCKED/TIMEOUT/resposta ausente sai com 1.
"""
import argparse
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _herdr_dispatch as core
import _herdr_migration as migration

now_iso = core.now_iso
agent_status = core.agent_status
agent_status_safe = core.agent_status_safe
agent_cwd = core.agent_cwd
validate_agent_project = core.validate_agent_project
get_agent_info = core.get_agent_info
freeze_files = core.freeze_files
dispatch_and_wait_all = core.dispatch_and_wait_all
skipped_reset_info = core.skipped_reset_info
runtime_profile_evidence = core.runtime_profile_evidence
write_json_atomic = core.write_json_atomic

ISOLATION_NOTE = """
Esta consulta é CEGA: outro consultor está respondendo à MESMA pergunta ao
mesmo tempo, num diretório irmão deste (`{sibling_dir}`). A ÚNICA coisa
proibida é esse diretório irmão especificamente: não abra
`{sibling_dir}/answer.md` nem liste `{sibling_dir}/`, nem antes nem depois de
escrever a sua — mesmo que você termine depois e a resposta dele já exista,
ler antes de escrever a sua invalida a consulta inteira, mesmo sem copiar
nada. Fora desse diretório específico, não há restrição de leitura.
"""

ASK_PROTOCOL = """# Consulta de design (herdr ask)

Você é um consultor independente. Leia a pergunta abaixo e o contexto (se
houver) — leia à vontade qualquer coisa que seja material da própria
consulta (a pergunta, os arquivos de contexto, o request.md, qualquer
arquivo do projeto sendo discutido). Escreva sua resposta em `answer.md`,
dentro desta mesma pasta (`{verdict_dir}`), e SÓ escreva nesse arquivo — não
edite nada além dele.
{isolation_note}
Isso NÃO é um bug hunt — não há severidade P0-P3 nem "APPROVE". É uma
pergunta de design aberta. Estruture sua resposta assim:

Antes de responder, faça a attestation read-only: confirme com `herdr agent
get <seu-nome>` (e `herdr agent list` se necessário) seu nome, pane,
workspace/space, raiz do projeto, família/kind, estado e `interactive_ready`
contra o request e a rodada. Registre a confirmação na resposta. Não infira a
posição por uma hierarquia genérica do modelo; se a CLI ou a metadata não
permitirem confirmá-la, pare e registre a inconsistência — exceto:
{interactive_ready_caveat} Se a busca por nome falhar, tente por pane_id
(`$HERDR_PANE_ID`) antes de declarar inconsistência. Breno é a
autoridade humana/owner e `<slug>-exec` é o coordenador/mecanismo delegado,
não autorização para inventar agentes ou canais. Preserve a cegueira e não
leia o artifact do colega cego.

1. **A decisão** — sua posição, em uma frase.
2. **As premissas** (2-3) que sustentam essa decisão, explicitamente
   rotuladas: "se X for falso, minha resposta muda". Isso é o que torna duas
   respostas divergentes reconciliáveis depois — sem premissas explícitas,
   "discordamos de verdade" e "concordamos por motivos opostos" ficam
   indistinguíveis.
3. **O argumento** — pode discordar de uma sub-pergunta específica se houver
   mais de uma, pode dizer "não vale a pena", pode ter baixa confiança — diga
   isso explicitamente em vez de forçar uma posição.

Antes de responder, releia `AGENTS.md` e `.herdr/reviewer.md`. Este é o aviso
operacional obrigatório: não use AgentRelay nem subagentes nativos, não crie
agent/pane novo para contornar fricção e, se a consulta tratar de uma
discordância factual, siga apenas a rota aprovada de `herdr-ask`.

{context_instruction}
"""

SCOUT_ESCALATION_NOTE = """## Terceira análise automática pelo scout

Você é o scout consultado automaticamente pelo `{exec_name}` quando, depois
de no máximo duas rodadas de correção de `rev-1`/`rev-2`, ele julgar necessária
uma análise adicional. Esta chamada não precisa de autorização prévia do Breno e não é uma terceira rodada de correção dos revisores. Analise apenas a
pergunta e o material fornecido, e escreva a resposta em `answer.md` para o
`-exec`.

Não comunique diretamente com o usuário, não tome a decisão pelo space e não
faça commit. Se a evidência continuar insuficiente, ou se houver mais de uma
interpretação defensável, registre **INCERTEZA** ou **DIVERGÊNCIA** de forma
explícita e devolva-a ao `{exec_name}`. Se o exec ainda julgar necessária outra análise depois da sua resposta, ou se você devolver INCERTEZA/DIVERGÊNCIA, ele é quem consulta o Breno.
"""


def load_invariants(cwd):
    reviewer_md_path = os.path.join(cwd, ".herdr", "reviewer.md")
    if os.path.isfile(reviewer_md_path):
        with open(reviewer_md_path) as f:
            return f.read()
    return None


def write_request(cwd, verdict_dir, sibling_dir, question, context_files, snapshot_map, scout_exec=None):
    if context_files:
        listing = "\n".join(f"- `{snapshot_map[f]}` (original: `{f}`)" for f in context_files)
        context_instruction = (
            f"## Contexto\n\nCongelado no disparo desta consulta — leia a partir "
            f"da cópia abaixo, não do path original (pode ter mudado desde o "
            f"disparo):\n\n{listing}"
        )
    else:
        context_instruction = ""

    invariants = load_invariants(cwd)
    invariants_section = f"\n## Invariantes do projeto\n\n{invariants}\n" if invariants else ""

    isolation_note = ISOLATION_NOTE.format(sibling_dir=sibling_dir) if sibling_dir else ""

    scout_note = SCOUT_ESCALATION_NOTE.format(exec_name=scout_exec) if scout_exec else ""
    content = f"""{ASK_PROTOCOL.format(verdict_dir=verdict_dir, isolation_note=isolation_note, context_instruction=context_instruction, interactive_ready_caveat=core.INTERACTIVE_READY_CAVEAT)}
{scout_note}
{invariants_section}
## Pergunta

{question}
"""
    with open(os.path.join(verdict_dir, "request.md"), "w") as f:
        f.write(content)


def target_names_for(slug, rev_name, reviewer):
    """Resolve o alvo normal ou a rota de escalonamento para o scout."""
    if reviewer in ("rev", "rev-1"):
        return [rev_name]
    if reviewer == "rev-2":
        return [f"{slug}-rev-2"]
    if reviewer == "scout":
        return [f"{slug}-scout"]
    return [rev_name, f"{slug}-rev-2"]


def prompt_text(verdict_dir):
    expected_name = os.path.basename(os.path.normpath(verdict_dir))
    return (
        f"Você foi chamado pelo dispatcher como `{expected_name}`. Antes de agir, "
        f"confirme essa identidade em modo read-only. Leia {verdict_dir}/request.md "
        f"e siga o protocolo nele. O único arquivo "
        f"que você deve escrever é {verdict_dir}/answer.md — as regras de "
        f"leitura estão no request.md."
    )


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("slug")
    ap.add_argument("--question-file", required=True, help="arquivo com a pergunta de design (markdown, pode ser longo)")
    ap.add_argument("--context", nargs="+", default=None, help="arquivos de contexto — congelados no disparo, como --files do herdr-review-dispatch")
    ap.add_argument("--reviewer", choices=["rev", "rev-1", "rev-2", "scout"], default=None, help="consulta só 1 (default: os dois); 'scout' é a terceira análise automática após duas rodadas")
    ap.add_argument("--timeout", type=int, default=1200, help="segundos de espera por consultor (default 1200)")
    args = ap.parse_args()

    # Achado 2026-09-01: $HERDR_ENV vazio nao e mais suficiente pra recusar
    # sozinho -- ver core.require_herdr_pane() pro porque (sandbox de exec
    # do Codex esconde env vars HERDR_*, confirmado ao vivo).
    core.require_herdr_pane()

    if not os.path.isfile(args.question_file):
        print(f"erro: arquivo de pergunta não encontrado: {args.question_file}", file=sys.stderr)
        sys.exit(2)
    with open(args.question_file) as f:
        question = f.read()

    context_files = None
    if args.context:
        context_files = [os.path.abspath(f) for f in args.context]
        for f in context_files:
            if not os.path.isfile(f):
                print(f"erro: arquivo de contexto não encontrado: {f}", file=sys.stderr)
                sys.exit(2)

    cwd = core.project_root(os.getcwd())

    gate_msg = migration.space_gate_message(cwd, args.slug)
    if gate_msg is not None:
        print(f"erro: {gate_msg}", file=sys.stderr)
        sys.exit(1)

    try:
        rev_name = migration.resolve_reviewer_name(cwd, args.slug, allow_missing=True)
    except RuntimeError as exc:
        print(f"erro: {exc}", file=sys.stderr)
        sys.exit(1)
    rev2_name = f"{args.slug}-rev-2"
    target_names = target_names_for(args.slug, rev_name, args.reviewer)

    # Um papel obrigatório pode desaparecer do registro do Herdr após reset do
    # daemon, reboot ou troca de pane. A ausência é recuperável: o helper usa a
    # tabela única do bootstrap para criar somente o que falta, espera o novo
    # agent assentar e então devolve o controle ao fluxo normal. Isso acontece
    # antes de qualquer snapshot, reset ou prompt da consulta.
    try:
        agent_restore = core.ensure_required_agents(args.slug, cwd, target_names)
    except core.AgentRestoreError as exc:
        print(f"erro: recuperação automática dos consultores obrigatórios falhou: {exc}", file=sys.stderr)
        sys.exit(1)

    for name in target_names:
        try:
            status = agent_status(name)
        except RuntimeError as exc:
            print(f"erro: agent '{name}' não encontrado ({exc})", file=sys.stderr)
            sys.exit(1)
        if status not in ("idle", "done"):
            print(f"erro: '{name}' está '{status}' — não vou disparar em cima de working/blocked", file=sys.stderr)
            sys.exit(1)

    try:
        for name in target_names:
            validate_agent_project(name, cwd)
    except RuntimeError as exc:
        print(f"erro: {exc}", file=sys.stderr)
        sys.exit(1)
    round_dir, n = core.next_round_dir(cwd, args.slug, namespace="ask")
    print(f"consulta {n}: {round_dir}")

    verdict_dirs = {}
    for name in target_names:
        verdict_dirs[name] = os.path.join(round_dir, name)
        os.makedirs(verdict_dirs[name])

    def sibling_dir_for(name):
        if args.reviewer == "scout":
            return None
        other = rev2_name if name == rev_name else rev_name
        return verdict_dirs.get(other)  # None se for consulta a 1 consultor só

    try:
        snapshot_map = {}
        if context_files:
            snapshot_map = freeze_files(context_files, round_dir)
            print(f"{len(context_files)} arquivo(s) de contexto congelado(s) em {round_dir}/_snapshot/")

        for name in target_names:
            scout_exec = f"{args.slug}-exec" if args.reviewer == "scout" else None
            write_request(
                cwd, verdict_dirs[name], sibling_dir_for(name), question,
                context_files, snapshot_map, scout_exec=scout_exec,
            )
        print(f"request.md escrito pr{'o' if len(target_names) == 1 else 'os'} {'consultor' if len(target_names) == 1 else 'dois'}")
    except (RuntimeError, OSError) as exc:
        print(f"erro preparando a consulta: {exc}", file=sys.stderr)
        shutil.rmtree(round_dir, ignore_errors=True)
        sys.exit(1)

    # O dispatcher não limpa mais contexto automaticamente. Isso evita que
    # `/new`/`/clear` troque o modelo ou o reasoning e derrube a rodada. A
    # recriação deliberada de um pane continua disponível via `herdr-swap`,
    # que transfere um handoff antes de fechar o processo antigo. O monitor
    # `herdr-context-watch` registra o tamanho da conversa sem promptar.
    reset_info = skipped_reset_info(target_names)
    print(
        "reset automático desativado para "
        + ", ".join(target_names)
        + "; use herdr-swap para recriar um pane e transferir o contexto"
    )

    verb = "disparando" if len(target_names) > 1 else "disparando (consultor único)"
    print(f"{verb} {', '.join(target_names)}...")
    dispatch_ts = {name: now_iso() for name in target_names}
    pre_info = {}
    runtime_before = {}
    dispatched = {}
    for name in target_names:
        try:
            pre_info[name] = get_agent_info(name)
            runtime_before[name] = runtime_profile_evidence(name, pre_info[name])
            dispatched[name] = True
        except RuntimeError as exc:
            print(f"  aviso: falha checando '{name}' antes de disparar: {exc}", file=sys.stderr)
            dispatched[name] = False

    if not any(dispatched.values()):
        print("erro: nenhum consultor disponível — nada foi disparado", file=sys.stderr)
        sys.exit(1)

    active_names = [name for name in target_names if dispatched[name]]
    dispatch_info = {
        name: {
            "kind": pre_info[name]["agent"],
            "agent_session": (pre_info[name].get("agent_session") or {}).get("value"),
            "dispatch_ts": dispatch_ts[name],
        }
        for name in active_names
    }
    prompts = {name: prompt_text(verdict_dirs[name]) for name in active_names}
    required_artifacts = {
        name: os.path.join(verdict_dirs[name], "answer.md")
        for name in active_names
    }
    try:
        result, wait_info, settle_ts = dispatch_and_wait_all(
            prompts,
            args.timeout,
            required_artifacts=required_artifacts,
            expected_agents={name: pre_info[name] for name in active_names},
            check_composition=False,
        )
    except core.DispatchPreflightError as exc:
        print(f"erro: preflight dos consultores abortou o dispatch: {exc}", file=sys.stderr)
        write_json_atomic(os.path.join(round_dir, "metrics.json"), {
            "round_dir": round_dir,
            "slug": args.slug,
            "mode": "ask",
            "reviewer": args.reviewer,
            "question_file": os.path.abspath(args.question_file),
            "context_files": context_files or [],
            "agent_restore": agent_restore,
            "reset": reset_info,
            "runtime_before": runtime_before,
            "dispatch": False,
            "preflight_error": str(exc),
            "preflight": exc.as_dict(),
        })
        sys.exit(1)

    print("\nresultado da consulta:")
    ok_count = 0
    metrics = {
        "round_dir": round_dir,
        "slug": args.slug,
        "mode": "ask",
        "reviewer": args.reviewer,
        "question_file": os.path.abspath(args.question_file),
        "context_files": context_files or [],
        "agent_restore": agent_restore,
        "reset": reset_info,
        "runtime_before": runtime_before,
        "runtime_after": {},
        "reviewers": {},
    }
    for name in target_names:
        if not dispatched.get(name):
            print(f"  {name}: não disparado (veja aviso acima)")
            metrics["reviewers"][name] = {"dispatched": False}
            continue
        status = result[name]
        try:
            post_info = get_agent_info(name)
        except RuntimeError:
            post_info = None
        metrics["runtime_after"][name] = runtime_profile_evidence(name, post_info)
        answer_path = os.path.join(verdict_dirs[name], "answer.md")
        size = os.path.getsize(answer_path) if os.path.isfile(answer_path) else 0
        di = dispatch_info[name]
        metrics["reviewers"][name] = {
            "dispatched": True,
            "kind": di["kind"],
            "agent_session": di["agent_session"],
            "runtime_before": runtime_before.get(name),
            "runtime_after": metrics["runtime_after"].get(name),
            "dispatch_ts": di["dispatch_ts"],
            "settle_ts": settle_ts.get(name),
            "status": status,
            "answer_bytes": size,
        }
        wait_detail = wait_info.get(name)
        if isinstance(wait_detail, dict):
            if status == "preflight_aborted":
                # O retry pode ser abortado depois que o primeiro prompt já
                # devolveu `agent_prompt_stalled`; preserve a decisão e a
                # leitura efetiva (pane/status/sessão) no metrics, em vez de
                # deixar só o status sem causa observável.
                metrics["reviewers"][name]["preflight"] = wait_detail
            if wait_detail.get("dispatch_preflight"):
                metrics["reviewers"][name]["dispatch_preflight"] = wait_detail["dispatch_preflight"]
            if wait_detail.get("retry_preflight"):
                metrics["reviewers"][name]["retry_preflight"] = wait_detail["retry_preflight"]
            if wait_detail.get("resend_suppressed"):
                metrics["reviewers"][name]["resend_suppressed"] = wait_detail["resend_suppressed"]
            if wait_detail.get("lifecycle_settle_ts"):
                metrics["reviewers"][name]["lifecycle_settle_ts"] = wait_detail["lifecycle_settle_ts"]
            if wait_detail.get("required_artifact"):
                metrics["reviewers"][name]["artifact"] = wait_detail["required_artifact"]
            elif status == "artifact_missing":
                metrics["reviewers"][name]["artifact"] = {
                    "path": wait_detail.get("artifact_path"),
                    "ready": False,
                }
        if status == "blocked":
            print(f"  {name}: BLOCKED — precisa de decisão humana no pane" + (f" (já tem answer.md de {size}b, confira antes de assumir que é lixo)" if size else ""))
        elif status == "timeout":
            print(f"  {name}: TIMEOUT ({args.timeout}s) — falha operacional, não é resposta" + (f" (answer.md existe, {size}b — pode estar incompleto)" if size else ""))
        elif status == "artifact_missing":
            print(f"  {name}: ARTIFACT_MISSING ({args.timeout}s) — o lifecycle terminou, mas answer.md não foi publicado" + (f" (answer.md existe, {size}b — confira a corrida da rodada)" if size else ""))
        elif status == "stalled":
            print(f"  {name}: STALLED — sem nenhuma mudança de estado nos primeiros 5s após o prompt ({wait_info.get(name)}) — pane pode estar travado")
        elif status == "preflight_aborted":
            print(f"  {name}: PREFLIGHT_ABORTED — alvo mudou antes de qualquer reenvio ({wait_info.get(name)})")
        elif status == "error":
            print(f"  {name}: ERRO esperando assentar ({wait_info.get(name)})")
        elif size == 0:
            print(f"  {name}: {status}, mas answer.md {'não existe' if not os.path.isfile(answer_path) else 'está vazio'} — falha operacional")
        else:
            print(f"  {name}: {status}, resposta em {answer_path} ({size}b)")
            ok_count += 1

    write_json_atomic(os.path.join(round_dir, "metrics.json"), metrics)

    print(f"\nround dir: {round_dir}")
    sys.exit(0 if ok_count == len(target_names) else 1)


if __name__ == "__main__":
    main()
