#!/usr/bin/env python3
"""herdr-agents [--name <filtro-de-cwd>] — uma linha por agent do Herdr:
status | cwd | kind | model | effort | name | pane_id | tab_id

MODEL/EFFORT saem do argv REAL do processo (`herdr pane process-info`), nao da
config esperada — o ponto e' justamente enxergar divergencia.

Confiabilidade por origem (coluna SRC):
  argv     autoritativo — pinado no lancamento
  thread   autoritativo — rollout do Codex reflete o estado final da sessao
  thread?  INDICATIVO   — sessao Claude e' historico; um `/model` ao vivo nao
                          aparece ali ate a proxima mensagem, e o modelo vem
                          prefixado com `~`. So `herdr pane read` decide.
  global   frouxo       — default de config, que o /model reescreve

Valor entre (parenteses) = HERDADO, nao pinado no lancamento: o processo subiu
sem `--model`/`--effort`, entao esta usando o default de ~/.codex/config.toml ou
~/.claude/settings.json. Isso importa porque esses arquivos sao REESCRITOS pelo
`/model` interativo: um `/model` num pane qualquer muda o default de todos os
agents herdados. Foi assim que dois revisores acordaram em Fable 5.1, o modelo
mais caro do catalogo, sem ninguem ter decidido (achado 2026-09-09).
"""
import argparse
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

HOME = os.path.expanduser("~")
CLI_TIMEOUT_S = 20


def api(*args):
    # --session antes do subcomando quando HERDR_SESSION estiver setada: a var
    # sozinha nao isola nada (nao e' variavel do Herdr, so --session e'; medido
    # 2026-09-10 -- ver herdr_argv em _herdr_dispatch.py).
    sessao = os.environ.get("HERDR_SESSION")
    prefixo = ["--session", sessao] if sessao else []
    out = subprocess.run(["herdr", *prefixo, *args], capture_output=True, text=True, timeout=CLI_TIMEOUT_S)
    if out.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {out.stderr.strip() or out.stdout.strip()}")
    return json.loads(out.stdout)["result"]


def defaults_codex():
    """model / model_reasoning_effort de ~/.codex/config.toml."""
    model = effort = None
    path = os.path.join(HOME, ".codex", "config.toml")
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line.startswith("model ") or line.startswith("model="):
                    model = line.split("=", 1)[1].strip().strip('"\'')
                elif line.startswith("model_reasoning_effort"):
                    effort = line.split("=", 1)[1].strip().strip('"\'')
    except OSError:
        pass
    return model, effort


def defaults_claude():
    """model + effortLevel daquele model, de ~/.claude/settings.json."""
    try:
        with open(os.path.join(HOME, ".claude", "settings.json")) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None, None
    model = d.get("model")
    effort = None
    if model:
        # "opus[1m]" -> a chave em modelSettings e' o id canonico
        # ("claude-opus-5"). Match exato primeiro; substring so como fallback,
        # porque "opus" casaria com qualquer chave que contenha a palavra e a
        # ordem do dict decidiria em silencio qual effort vence.
        base = model.split("[")[0]
        ms = d.get("modelSettings") or {}
        alvo = ms.get(base) or ms.get(f"claude-{base}") or ms.get(f"claude-{base}-5")
        if alvo is None:
            candidatos = [v for k, v in ms.items() if base in k]
            alvo = candidatos[0] if len(candidatos) == 1 else None
        effort = (alvo or {}).get("effortLevel")
    return model, effort


def from_argv(argv):
    """Extrai (model, effort) do argv, ou (None, None) se nao veio pinado."""
    model = effort = None
    for i, a in enumerate(argv):
        if a == "--model" and i + 1 < len(argv):
            model = argv[i + 1]
        elif a == "--effort" and i + 1 < len(argv):
            effort = argv[i + 1]
        elif a.startswith("model_reasoning_effort="):
            effort = a.split("=", 1)[1]
    return model, effort


def from_codex_rollout(uuid):
    """(model, effort) do ULTIMO registro do rollout daquela sessao Codex.

    Achado 2026-09-10, medido: um processo restaurado com `codex resume <uuid>`
    NAO cai no default global -- ele restaura fielmente o estado final da
    thread. Prova: llm-bench-scout roda `gpt-5.6-luna max` enquanto o default
    global e' `gpt-6-astra`; se caisse no default, seria impossivel.

    Por isso o ultimo registro, e nao o primeiro: o effort pode mudar no meio
    da sessao (visto um evento `thread_settings_applied` do Codex rebaixando
    high -> medium), e o que vale e' o estado com que a thread terminou."""
    import glob
    achados = glob.glob(os.path.join(HOME, ".codex", "sessions", "**", f"*{uuid}*.jsonl"),
                        recursive=True)
    if not achados:
        return None, None
    model = effort = None
    try:
        with open(achados[0]) as f:
            for linha in f:
                m = re.search(r'"model"\s*:\s*"([^"]+)"', linha)
                if m:
                    model = m.group(1)
                e = re.search(r'"(?:reasoning_)?effort"\s*:\s*"(\w+)"', linha)
                if e:
                    effort = e.group(1)
    except OSError:
        return None, None
    return model, effort


def claude_model_confiavel(uuid):
    """(modelo, True) se der pra AFIRMAR o modelo de uma sessao Claude viva.

    O campo `model` no log so aparece em entrada de RESPOSTA do assistente. Um
    `/model` feito ao vivo nao escreve entrada nenhuma com modelo -- so quando o
    agent responder de novo. Entao o ultimo `model` do log e' confiavel apenas
    se aquela resposta veio DEPOIS da ultima troca.

    Como saber quando foi a ultima troca: o `/model` grava o default em
    ~/.claude/settings.json, entao o mtime dele e' o marco. Se a ultima resposta
    com modelo e' posterior, o agent falou depois da troca e o valor vale.

    Conservador de proposito: um `/model` num pane qualquer atualiza o
    settings.json e joga TODOS pra "nao sei" ate cada um responder de novo.
    Falso "nao sei" e' inofensivo; falso "sei" foi o que mandou o usuario
    cacar um Fable inexistente duas vezes em 2026-09-10.

    Nao serve mtime do ARQUIVO: medido, o log do acervo-exec foi escrito 3min
    DEPOIS da troca e ainda assim registrava o modelo antigo -- a escrita era
    uma entrada `system`, sem campo model."""
    import glob
    achados = glob.glob(os.path.join(HOME, ".claude", "projects", "**", f"*{uuid}*"),
                        recursive=True)
    if not achados:
        return None, False
    try:
        troca = os.path.getmtime(os.path.join(HOME, ".claude", "settings.json"))
    except OSError:
        return None, False

    modelo = ts_modelo = None
    try:
        with open(achados[0], errors="ignore") as f:
            for linha in f:
                if '"model"' not in linha:
                    continue
                m = re.search(r'"model"\s*:\s*"([^"]+)"', linha)
                t = re.search(r'"timestamp"\s*:\s*"([^"]+)"', linha)
                if m:
                    modelo = m.group(1)
                if t:
                    ts_modelo = t.group(1)
    except OSError:
        return None, False
    if not modelo or not ts_modelo:
        return None, False

    import datetime
    try:
        quando = datetime.datetime.fromisoformat(ts_modelo.replace("Z", "+00:00"))
    except ValueError:
        return None, False
    marco = datetime.datetime.fromtimestamp(troca, datetime.timezone.utc)
    return modelo, quando > marco


def from_claude_session(uuid):
    """Modelo do ULTIMO registro da sessao Claude daquele uuid.

    Mesma logica do rollout do Codex, e pelo mesmo motivo: `claude --resume
    <uuid>` restaura o modelo gravado na sessao, nao o default global. Faltava
    este lado ate 2026-09-10, e a omissao escondia o caso mais caro -- quatro
    agentes rodando `claude-fable-5-1` ($10/$50, o dobro do Opus) apareciam
    aqui como `(opus[1m])` porque o script so sabia consultar o settings.json.
    A ferramenta que existe pra achar drift de modelo estava cega no pior
    drift. O effort nao e' gravado na sessao, entao segue vindo do global."""
    import glob
    achados = glob.glob(os.path.join(HOME, ".claude", "projects", "**", f"*{uuid}*"),
                        recursive=True)
    if not achados:
        return None
    modelo = None
    try:
        with open(achados[0], errors="ignore") as f:
            for linha in f:
                for m in re.finditer(r'"model"\s*:\s*"([^"]+)"', linha):
                    modelo = m.group(1)
    except OSError:
        return None
    return modelo


def resume_uuid(argv):
    """UUID quando o processo subiu via `codex resume <uuid>` ou
    `claude --resume <uuid>` -- as duas familias restauram sessao, cada uma
    com sua sintaxe."""
    for i, a in enumerate(argv):
        if a in ("resume", "--resume") and i + 1 < len(argv):
            return argv[i + 1]
    return None


try:
    import _herdr_probe_cache as probe_cache
except ImportError:      # pragma: no cover - o listing funciona sem a sonda
    probe_cache = None

# Rodape do Codex: "  gpt-6-astra medium · ~/Devs/x · titulo". O TUI tambem
# escreve "Model changed to ..." na conversa ao trocar, mas o rodape ja carrega
# o estado atual, entao ele basta.
RODAPE_CODEX = re.compile(
    r"\b(?P<model>(?:gpt|o)[-a-z0-9.]*[0-9a-z])\s+"
    r"(?P<effort>minimal|low|medium|high|xhigh|max)\b", re.I)


def le_pane(nome, linhas=6):
    """Buffer do pane. PASSIVO -- le, nunca escreve.

    Nao existe versao ativa disto de proposito. Mandar `/status` resolveria o
    `(unknown)` do Claude na hora, mas escreve na caixa de composicao de um
    pane que pode ter texto humano nao enviado -- dois incidentes reais neste
    mesh, documentados no CLAUDE.md.
    """
    sessao = os.environ.get("HERDR_SESSION")
    prefixo = ["--session", sessao] if sessao else []
    try:
        r = subprocess.run(
            ["herdr", *prefixo, "agent", "read", nome,
             "--source", "recent-unwrapped", "--lines", str(linhas)],
            capture_output=True, text=True, timeout=CLI_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout or ""


def do_rodape(texto):
    """(model, effort) do rodape do Codex, ou (None, None).

    Pega o ULTIMO match: a conversa acima do rodape pode citar nomes de modelo
    em prosa, e o rodape e' a ultima coisa desenhada.
    """
    ms = list(RODAPE_CODEX.finditer(texto))
    if not ms:
        return None, None
    m = ms[-1]
    return m.group("model").lower(), m.group("effort").lower()


def amostra_um(agent):
    """Le o valor VIVO de um agent: (nome, model, effort, origem) ou None.

    Mora aqui, e nao no herdr-probe, porque o caminho do Claude precisa de
    claude_model_confiavel/resume_uuid/defaults_claude -- todos deste modulo. A
    sonda e' so o laco por cima; o `--force` do listing usa a mesma funcao, pra
    nao existirem duas definicoes do que e' "o valor de agora".
    """
    nome, kind = agent.get("name"), agent.get("agent")
    if not nome:
        return None
    if kind == "codex":
        model, effort = do_rodape(le_pane(nome))
        return (nome, model, effort, "pane") if model else None
    if kind == "claude":
        # Claude nao imprime modelo na tela; a unica fonte passiva e' o log, e
        # ele so vale quando o agent respondeu DEPOIS da ultima troca.
        try:
            pi = api("pane", "process-info", "--pane", agent["pane_id"])["process_info"]
            fg = pi.get("foreground_processes") or []
            argv = fg[0].get("argv", []) if fg else []
        except (RuntimeError, subprocess.TimeoutExpired, KeyError, IndexError):
            return None
        uuid = resume_uuid(argv)
        if not uuid:
            return None
        model, confiavel = claude_model_confiavel(uuid)
        if model and confiavel:
            _dm, de = defaults_claude()
            return nome, model, de or "?", "thread-confirmado"
    return None


def amostra_todos(agents, workers=12):
    """Amostra em paralelo e devolve o cache atualizado (ja gravado)."""
    if probe_cache is None:
        return {}
    c = probe_cache.ler()
    with ThreadPoolExecutor(max_workers=workers) as ex:
        for r in ex.map(amostra_um, agents):
            if r:
                nome, model, effort, origem = r
                probe_cache.atualiza(c, nome, model, effort, origem)
    probe_cache.gravar(c)
    return c


# Acima de quantos minutos uma leitura de pane deixa de valer sozinha. Nao e'
# validade real -- e' o ponto em que prefiro admitir a idade a afirmar como se
# fosse agora. `/model` e' instantaneo e nao avisa ninguem.
IDADE_MAX_MIN = 90


def do_cache(nome, agora_model, agora_effort, agora_origem, c=None):
    """Deixa a sonda sobrepor o que o listing conseguiu sozinho.

    A ordem de preferencia nao e' obvia e vale escrever: uma leitura de PANE
    ganha ate do argv. Argv e' o que o operador pinou no lancamento, mas um
    `/model` feito depois nao toca no argv -- entao argv e' a INTENCAO, e o
    pane e' o FATO. Foi assim que quatro agentes apareceram como `high` neste
    listing enquanto rodavam `medium`/`low`, trocados a mao.

    Quando a leitura esta velha, o valor sai mesmo assim com a idade no SRC:
    esconder seria voltar ao `(unknown)`, que e' pior -- o operador perde a
    unica pista que existe.
    """
    if probe_cache is None:
        return agora_model, agora_effort, agora_origem
    e = ((probe_cache.ler() if c is None else c) or {}).get(nome)
    if not e:
        return agora_model, agora_effort, agora_origem
    idade = probe_cache.idade_min(e)
    origem = e.get("origem", "?")
    if origem == "pane":
        marca = "pane" if (idade is not None and idade <= IDADE_MAX_MIN) else f"pane~{idade}min"
        return e.get("model") or agora_model, e.get("effort") or agora_effort, marca
    # thread-confirmado so entra quando o listing nao soube resolver sozinho
    if agora_model in ("(unknown)", "?", None) or agora_origem in ("global", "thread?"):
        marca = "sonda" if (idade is not None and idade <= IDADE_MAX_MIN) else f"sonda~{idade}min"
        return e.get("model") or agora_model, e.get("effort") or agora_effort, marca
    return agora_model, agora_effort, agora_origem


def status_curto(status):
    """`working` ocupa 7 colunas e nao diz nada que o operador ja nao saiba
    pelo nome do agent -- comprime pra `job` (sem id numerico: a API do
    Herdr nao expoe job/task id nenhum, so agent_status)."""
    return "job" if status == "working" else status


def cwd_relativo(cwd):
    """So imprime o CWD quando ele esta FORA do $HOME -- dentro e' o caso
    comum e nao precisa ocupar coluna nenhuma. Fora, mostra relativo ao
    $HOME em vez de realpath absoluto."""
    if not cwd or cwd == "?":
        return ""
    if cwd == HOME or cwd.startswith(HOME + "/"):
        return ""
    return cwd


def sem_prefixo_do_kind(modelo, kind):
    """Tira o prefixo redundante com a coluna KIND: `claude-sonnet-5` vira
    `sonnet-5`, porque a linha ja diz `claude` do lado. Os ids do Codex nao
    carregam prefixo (`gpt-6-astra`), entao passam intactos."""
    if not modelo:
        return modelo
    pref = f"{kind}-"
    return modelo[len(pref):] if modelo.startswith(pref) else modelo


def resolve(agent):
    """(model, effort, origem) do pane.

    origem diz DE ONDE veio o valor, porque as tres fontes divergem na pratica:
      argv   -- pinado no lancamento (a unica que o operador escolheu)
      thread -- restaurado de `codex resume`, e' o estado final da sessao
      global -- default de config.toml/settings.json, que o /model reescreve
    """
    kind = agent.get("agent")
    try:
        pi = api("pane", "process-info", "--pane", agent["pane_id"])["process_info"]
        fg = pi.get("foreground_processes") or []
        argv = fg[0].get("argv", []) if fg else []
    except (RuntimeError, subprocess.TimeoutExpired, KeyError, IndexError):
        argv = []

    model, effort = from_argv(argv)
    if model or effort:
        return model or "?", effort or "?", "argv"

    uuid = resume_uuid(argv)
    if uuid and kind == "codex":
        rm, re_ = from_codex_rollout(uuid)
        if rm or re_:
            return rm or "?", re_ or "?", "thread"
    if uuid and kind == "claude":
        cm, confiavel = claude_model_confiavel(uuid)
        if cm and confiavel:
            # o agent respondeu DEPOIS da ultima troca de /model: o log vale
            _dm, de = defaults_claude()
            return cm, f"({de})" if de else "?", "thread"
        if cm:
            # `~` = INDICATIVO, nao autoritativo. O arquivo de sessao e'
            # historico: um `/model` na sessao viva troca o modelo SEM gravar
            # registro novo enquanto nao houver mensagem depois. Medido
            # 2026-09-10, com o usuario apontando o erro: quatro agentes que o
            # arquivo dava como `claude-fable-5-1` ja tinham sido trocados a
            # mao pra Sonnet 5 / Opus 5, e a tela do pane provava.
            #
            # Nao ha fonte confiavel fora da tela pra um Claude restaurado: o
            # arquivo atrasa, o settings.json e' global. Entao marca a duvida
            # em vez de afirmar -- `herdr pane read <pane>` e' quem decide.
            _dm, de = defaults_claude()
            # NAO imprime o nome do modelo lido do log. Ele desatualiza, e um
            # nome errado num campo que as pessoas usam pra CACAR CUSTO produz
            # falso positivo: `herdr-agents | grep -i fable` acusou duas vezes
            # um agente que ja tinha sido trocado pra Sonnet 5 a mao, e mandou
            # o usuario atras de um fantasma. Melhor admitir que nao sabe.
            # O nome lido do log NAO aparece em coluna nenhuma: tentei
            # deixa-lo no SRC como pista e o `grep -i fable` voltou a acusar
            # os mesmos quatro. Qualquer coluna serve pro grep -- entao a
            # unica saida honesta e' nao imprimir o palpite.
            return "(unknown)", f"({de})" if de else "?", "thread?"

    dm, de = (defaults_codex() if kind == "codex" else defaults_claude())
    return dm or "?", de or "?", "global"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--name", default="", help="so agents cujo cwd contem este texto")
    ap.add_argument("--force", "-f", action="store_true",
                    help="le os panes AGORA em vez de usar o cache da sonda. Mais lento "
                         "(uma leitura por agent), mas e' o estado do instante -- use "
                         "depois de trocar modelo na mao, sem esperar os 15min do timer.")
    args = ap.parse_args()

    # ordem dos workspaces como o Herdr numera (a mesma da sidebar): MFC e' o
    # 1 e `herdr` o ultimo, entao ordenar por nome do agent punha o MFC no meio
    # e nao batia com o que o usuario ve na tela.
    try:
        ordem_ws = {w["workspace_id"]: w.get("number", 999)
                    for w in api("workspace", "list")["workspaces"]}
    except RuntimeError:
        ordem_ws = {}

    agents = api("agent", "list")["agents"]
    if args.name:
        f = args.name.lower()
        agents = [a for a in agents if f in a.get("cwd", "").lower()]

    # --force amostra antes de resolver, entao o cache que o do_cache le ja
    # esta atualizado. As duas coisas usam a MESMA amostra_um(): forcar nao
    # pode significar "outro jeito de medir", so "medir agora".
    cache_atual = amostra_todos(agents) if args.force else (
        probe_cache.ler() if probe_cache else {})

    with ThreadPoolExecutor(max_workers=12) as ex:
        modelos = list(ex.map(resolve, agents))

    linhas = []
    for a, (model, effort, origem) in zip(agents, modelos):
        kind = a.get("agent", "?")
        model, effort, origem = do_cache(a.get("name") or "", model, effort, origem,
                                         cache_atual)
        nome = a.get("name") or ""
        linhas.append([
            status_curto(a.get("agent_status", "?")), cwd_relativo(a.get("cwd", "?")), kind,
            sem_prefixo_do_kind(model, kind), effort, origem,
            nome, a.get("pane_id", "?"), a.get("tab_id", "?"),
            a.get("workspace_id", ""),   # so pra ordenar; nao e' impressa
        ])
    # workspace na ordem do Herdr; dentro dele, papel na ordem do layout
    # (exec, rev-1, rev-2, scout) em vez de alfabetica -- `-exec` vem depois de
    # `-rev-1` no alfabeto, o que inverteria a leitura natural de cada space.
    PAPEL = {"-exec": 0, "-rev-1": 1, "-rev-2": 2, "-scout": 3}

    def peso_papel(nome):
        for suf, i in PAPEL.items():
            if nome.endswith(suf):
                return i
        return 9

    linhas.sort(key=lambda r: (r[6] == "", ordem_ws.get(r[9], 999),
                               peso_papel(r[6]), r[6]))

    head = ["STATUS", "CWD", "KIND", "MODEL", "EFFORT", "SRC", "NAME", "PANE_ID", "TAB_ID"]
    larguras = [max(len(str(r[i])) for r in [head] + linhas) for i in range(len(head))]
    for r in [head] + linhas:
        print("  ".join(str(c).ljust(w) for c, w in zip(r[:len(head)], larguras)).rstrip())


if __name__ == "__main__":
    main()
