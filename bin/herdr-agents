#!/usr/bin/env python3
"""herdr-agents [--name <filtro-de-cwd>] — uma linha por agent do Herdr:
status | cwd | kind | model | effort | name | pane_id | tab_id

MODEL/EFFORT saem do argv REAL do processo (`herdr pane process-info`), nao da
config esperada — o ponto e' justamente enxergar divergencia.

Confiabilidade por origem (coluna SRC):
  argv     autoritativo — pinado no lancamento
  thread   autoritativo — rollout do Codex reflete o estado final da sessao
  thread?  INDICATIVO   — sessao Claude e' historico; um `/model` ao vivo nao
                          aparece ali ate a proxima mensagem, e o modelo vem
                          prefixado com `~`. So `herdr pane read` decide.
  global   frouxo       — default de config, que o /model reescreve

Valor entre (parenteses) = HERDADO, nao pinado no lancamento: o processo subiu
sem `--model`/`--effort`, entao esta usando o default de ~/.codex/config.toml ou
~/.claude/settings.json. Isso importa porque esses arquivos sao REESCRITOS pelo
`/model` interativo: um `/model` num pane qualquer muda o default de todos os
agents herdados. Foi assim que dois revisores acordaram em Fable 5.1, o modelo
mais caro do catalogo, sem ninguem ter decidido (achado 2026-09-09).
"""
import argparse
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

HOME = os.path.expanduser("~")
CLI_TIMEOUT_S = 20


def api(*args):
    # --session antes do subcomando quando HERDR_SESSION estiver setada: a var
    # sozinha nao isola nada (nao e' variavel do Herdr, so --session e'; medido
    # 2026-09-10 -- ver herdr_argv em _herdr_dispatch.py).
    sessao = os.environ.get("HERDR_SESSION")
    prefixo = ["--session", sessao] if sessao else []
    out = subprocess.run(["herdr", *prefixo, *args], capture_output=True, text=True, timeout=CLI_TIMEOUT_S)
    if out.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {out.stderr.strip() or out.stdout.strip()}")
    return json.loads(out.stdout)["result"]


def defaults_codex():
    """model / model_reasoning_effort de ~/.codex/config.toml."""
    model = effort = None
    path = os.path.join(HOME, ".codex", "config.toml")
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line.startswith("model ") or line.startswith("model="):
                    model = line.split("=", 1)[1].strip().strip('"\'')
                elif line.startswith("model_reasoning_effort"):
                    effort = line.split("=", 1)[1].strip().strip('"\'')
    except OSError:
        pass
    return model, effort


def defaults_claude():
    """model + effortLevel daquele model, de ~/.claude/settings.json."""
    try:
        with open(os.path.join(HOME, ".claude", "settings.json")) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None, None
    model = d.get("model")
    effort = None
    if model:
        # "opus[1m]" -> a chave em modelSettings e' o id canonico
        # ("claude-opus-5"). Match exato primeiro; substring so como fallback,
        # porque "opus" casaria com qualquer chave que contenha a palavra e a
        # ordem do dict decidiria em silencio qual effort vence.
        base = model.split("[")[0]
        ms = d.get("modelSettings") or {}
        alvo = ms.get(base) or ms.get(f"claude-{base}") or ms.get(f"claude-{base}-5")
        if alvo is None:
            candidatos = [v for k, v in ms.items() if base in k]
            alvo = candidatos[0] if len(candidatos) == 1 else None
        effort = (alvo or {}).get("effortLevel")
    return model, effort


def from_argv(argv):
    """Extrai (model, effort) do argv, ou (None, None) se nao veio pinado."""
    model = effort = None
    for i, a in enumerate(argv):
        if a == "--model" and i + 1 < len(argv):
            model = argv[i + 1]
        elif a == "--effort" and i + 1 < len(argv):
            effort = argv[i + 1]
        elif a.startswith("model_reasoning_effort="):
            effort = a.split("=", 1)[1]
    return model, effort


def from_codex_rollout(uuid):
    """(model, effort) do ULTIMO registro do rollout daquela sessao Codex.

    Achado 2026-09-10, medido: um processo restaurado com `codex resume <uuid>`
    NAO cai no default global -- ele restaura fielmente o estado final da
    thread. Prova: llm-bench-scout roda `gpt-5.6-luna max` enquanto o default
    global e' `gpt-6-astra`; se caisse no default, seria impossivel.

    Por isso o ultimo registro, e nao o primeiro: o effort pode mudar no meio
    da sessao (visto um evento `thread_settings_applied` do Codex rebaixando
    high -> medium), e o que vale e' o estado com que a thread terminou."""
    import glob
    achados = glob.glob(os.path.join(HOME, ".codex", "sessions", "**", f"*{uuid}*.jsonl"),
                        recursive=True)
    if not achados:
        return None, None
    model = effort = None
    try:
        with open(achados[0]) as f:
            for linha in f:
                m = re.search(r'"model"\s*:\s*"([^"]+)"', linha)
                if m:
                    model = m.group(1)
                e = re.search(r'"(?:reasoning_)?effort"\s*:\s*"(\w+)"', linha)
                if e:
                    effort = e.group(1)
    except OSError:
        return None, None
    return model, effort


def from_claude_session(uuid):
    """Modelo do ULTIMO registro da sessao Claude daquele uuid.

    Mesma logica do rollout do Codex, e pelo mesmo motivo: `claude --resume
    <uuid>` restaura o modelo gravado na sessao, nao o default global. Faltava
    este lado ate 2026-09-10, e a omissao escondia o caso mais caro -- quatro
    agentes rodando `claude-fable-5-1` ($10/$50, o dobro do Opus) apareciam
    aqui como `(opus[1m])` porque o script so sabia consultar o settings.json.
    A ferramenta que existe pra achar drift de modelo estava cega no pior
    drift. O effort nao e' gravado na sessao, entao segue vindo do global."""
    import glob
    achados = glob.glob(os.path.join(HOME, ".claude", "projects", "**", f"*{uuid}*"),
                        recursive=True)
    if not achados:
        return None
    modelo = None
    try:
        with open(achados[0], errors="ignore") as f:
            for linha in f:
                for m in re.finditer(r'"model"\s*:\s*"([^"]+)"', linha):
                    modelo = m.group(1)
    except OSError:
        return None
    return modelo


def resume_uuid(argv):
    """UUID quando o processo subiu via `codex resume <uuid>` ou
    `claude --resume <uuid>` -- as duas familias restauram sessao, cada uma
    com sua sintaxe."""
    for i, a in enumerate(argv):
        if a in ("resume", "--resume") and i + 1 < len(argv):
            return argv[i + 1]
    return None


def resolve(agent):
    """(model, effort, origem) do pane.

    origem diz DE ONDE veio o valor, porque as tres fontes divergem na pratica:
      argv   -- pinado no lancamento (a unica que o operador escolheu)
      thread -- restaurado de `codex resume`, e' o estado final da sessao
      global -- default de config.toml/settings.json, que o /model reescreve
    """
    kind = agent.get("agent")
    try:
        pi = api("pane", "process-info", "--pane", agent["pane_id"])["process_info"]
        fg = pi.get("foreground_processes") or []
        argv = fg[0].get("argv", []) if fg else []
    except (RuntimeError, subprocess.TimeoutExpired, KeyError, IndexError):
        argv = []

    model, effort = from_argv(argv)
    if model or effort:
        return model or "?", effort or "?", "argv"

    uuid = resume_uuid(argv)
    if uuid and kind == "codex":
        rm, re_ = from_codex_rollout(uuid)
        if rm or re_:
            return rm or "?", re_ or "?", "thread"
    if uuid and kind == "claude":
        cm = from_claude_session(uuid)
        if cm:
            # `~` = INDICATIVO, nao autoritativo. O arquivo de sessao e'
            # historico: um `/model` na sessao viva troca o modelo SEM gravar
            # registro novo enquanto nao houver mensagem depois. Medido
            # 2026-09-10, com o usuario apontando o erro: quatro agentes que o
            # arquivo dava como `claude-fable-5-1` ja tinham sido trocados a
            # mao pra Sonnet 5 / Opus 5, e a tela do pane provava.
            #
            # Nao ha fonte confiavel fora da tela pra um Claude restaurado: o
            # arquivo atrasa, o settings.json e' global. Entao marca a duvida
            # em vez de afirmar -- `herdr pane read <pane>` e' quem decide.
            _dm, de = defaults_claude()
            # NAO imprime o nome do modelo lido do log. Ele desatualiza, e um
            # nome errado num campo que as pessoas usam pra CACAR CUSTO produz
            # falso positivo: `herdr-agents | grep -i fable` acusou duas vezes
            # um agente que ja tinha sido trocado pra Sonnet 5 a mao, e mandou
            # o usuario atras de um fantasma. Melhor admitir que nao sabe.
            # O nome lido do log NAO aparece em coluna nenhuma: tentei
            # deixa-lo no SRC como pista e o `grep -i fable` voltou a acusar
            # os mesmos quatro. Qualquer coluna serve pro grep -- entao a
            # unica saida honesta e' nao imprimir o palpite.
            return "(indeterminado)", f"({de})" if de else "?", "thread?"

    dm, de = (defaults_codex() if kind == "codex" else defaults_claude())
    return dm or "?", de or "?", "global"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--name", default="", help="so agents cujo cwd contem este texto")
    args = ap.parse_args()

    agents = api("agent", "list")["agents"]
    if args.name:
        f = args.name.lower()
        agents = [a for a in agents if f in a.get("cwd", "").lower()]

    with ThreadPoolExecutor(max_workers=12) as ex:
        modelos = list(ex.map(resolve, agents))

    linhas = []
    for a, (model, effort, origem) in zip(agents, modelos):
        linhas.append([
            a.get("agent_status", "?"), a.get("cwd", "?"), a.get("agent", "?"),
            model, effort, origem, a.get("name") or "", a.get("pane_id", "?"), a.get("tab_id", "?"),
        ])
    linhas.sort(key=lambda r: (r[6] == "", r[6], r[7]))  # sem nome por ultimo

    head = ["AGENT", "CWD", "KIND", "MODEL", "EFFORT", "SRC", "NAME", "PANE_ID", "TAB_ID"]
    larguras = [max(len(str(r[i])) for r in [head] + linhas) for i in range(len(head))]
    for r in [head] + linhas:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, larguras)).rstrip())


if __name__ == "__main__":
    main()
